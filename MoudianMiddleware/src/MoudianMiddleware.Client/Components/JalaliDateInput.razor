<label>
    @Label
    <input inputmode="numeric" autocomplete="off" placeholder="۱۴۰۵/۰۸/۱۰" value="@Text" @onchange="OnChanged" aria-invalid="@(!string.IsNullOrEmpty(Error))" />
    <small class="muted">تاریخ شمسی با قالب سال/ماه/روز</small>
    @if (!string.IsNullOrWhiteSpace(Error)) { <span class="field-error">@Error</span> }
</label>
@code {
    [Parameter] public string Label { get; set; } = "تاریخ";
    [Parameter] public DateTimeOffset? Value { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<DateTimeOffset?>>? ValueExpression { get; set; }
    private string Text => JalaliDateFormatter.Format(Value);
    private string? Error { get; set; }
    private async Task OnChanged(ChangeEventArgs args)
    {
        var text = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text)) { Error = null; await ValueChanged.InvokeAsync(null); return; }
        if (!JalaliDateFormatter.TryParse(text, out var value)) { Error = "تاریخ شمسی معتبر نیست."; return; }
        Error = null;
        await ValueChanged.InvokeAsync(value);
    }
}
