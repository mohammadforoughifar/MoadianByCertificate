@if (Errors.Count > 0)
{
    <div class="notice error validation-summary" role="alert">
        <strong>لطفاً خطاهای زیر را اصلاح کنید:</strong>
        <ul>@foreach (var error in Errors) { <li>@(string.IsNullOrWhiteSpace(error.Field) ? "" : error.Field + ": ")@error.Message</li> }</ul>
    </div>
}
@code {
    [Parameter] public IReadOnlyList<ApiError> Errors { get; set; } = Array.Empty<ApiError>();
}
