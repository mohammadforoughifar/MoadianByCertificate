@inject IJSRuntime JS
<button class="danger" @onclick="ConfirmAsync" disabled="@Disabled">@Text</button>
@code {
    [Parameter] public string Text { get; set; } = "حذف";
    [Parameter] public string Prompt { get; set; } = "از انجام این عملیات مطمئن هستید؟";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Confirmed { get; set; }
    private async Task ConfirmAsync()
    {
        if (await JS.InvokeAsync<bool>("confirm", Prompt)) await Confirmed.InvokeAsync();
    }
}
