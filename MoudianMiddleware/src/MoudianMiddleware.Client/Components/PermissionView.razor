@if (HasPermission)
{
    @ChildContent
}
@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter, EditorRequired] public string Permission { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool HasPermission { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        var state = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        HasPermission = state?.User.HasClaim("permission", Permission) == true;
    }
}
