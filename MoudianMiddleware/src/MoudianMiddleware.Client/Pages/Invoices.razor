@page "/invoices"
@attribute [Authorize]
@inject InvoiceListViewModel Vm
<PageTitle>صورتحساب‌ها</PageTitle>
<h1>صورتحساب‌ها</h1>
<div class="toolbar"><label>وضعیت<select @bind="Vm.Status"><option value="">همه</option>@foreach (var status in Enum.GetValues<InvoiceStatus>()) { <option value="@status">@status</option> }</select></label><JalaliDateInput Label="از تاریخ" @bind-Value="Vm.FromDate" /><JalaliDateInput Label="تا تاریخ" @bind-Value="Vm.ToDate" /><button @onclick="LoadAsync">اعمال فیلتر</button><PermissionView Permission="@Permissions.InvoiceEdit"><a class="button" href="/invoices/new">صورتحساب جدید</a></PermissionView></div>
<LoadingPanel Loading="Vm.IsLoading" Error="Vm.Error" />
@if (Vm.Result is not null)
{
    <PagedTable TItem="InvoiceViewModel" Items="Vm.Result.Items" PageNumber="Vm.Result.PageNumber" TotalPages="Vm.Result.TotalPages" TotalCount="Vm.Result.TotalCount" PageChanged="page => Vm.SetPageAsync(page)">
        <Header><th>شماره</th><th>خریدار</th><th>وضعیت</th><th>جمع کل (ریال)</th><th></th></Header>
        <Row Context="invoice"><td>@invoice.InvoiceNumber</td><td>@invoice.BuyerName</td><td><span class="badge">@invoice.Status</span></td><td>@JalaliDateFormatter.ToPersianDigits(invoice.TotalAmount.ToString("N0", new System.Globalization.CultureInfo("fa-IR")))</td><td><a href="/invoices/@invoice.Id">جزئیات</a></td></Row>
    </PagedTable>
}
@code { protected override Task OnInitializedAsync() => Vm.LoadAsync(); private Task LoadAsync() => Vm.LoadAsync(); }
