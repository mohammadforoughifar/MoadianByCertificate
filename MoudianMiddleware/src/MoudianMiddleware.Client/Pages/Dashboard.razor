@page "/"
@page "/dashboard"
@attribute [Authorize]
@inject DashboardViewModel Vm
<PageTitle>داشبورد</PageTitle>
<h1>داشبورد وضعیت صورتحساب‌ها</h1>
<LoadingPanel Loading="Vm.IsLoading" Error="Vm.Error" />
@if (!Vm.IsLoading && string.IsNullOrEmpty(Vm.Error))
{
    <div class="grid cols-3">
        @foreach (var item in Vm.Counts)
        {
            <div class="card"><div class="muted">@item.Key</div><div class="stat">@JalaliDateFormatter.ToPersianDigits(item.Value.ToString("N0", new System.Globalization.CultureInfo("fa-IR")))</div></div>
        }
    </div>
    <div class="card"><h2>میان‌برها</h2><div class="toolbar"><a class="button" href="/invoices/new">ایجاد پیش‌نویس</a><a class="button secondary" href="/reports">گزارش‌ها</a></div></div>
}
@code { protected override Task OnInitializedAsync() => Vm.LoadAsync(); }
