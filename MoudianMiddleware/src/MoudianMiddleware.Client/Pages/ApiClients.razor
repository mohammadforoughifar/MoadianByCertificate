@page "/api-clients"
@attribute [Authorize]
@inject AdministrationViewModel Vm
<PageTitle>کلیدهای API</PageTitle>
<h1>مدیریت کلیدهای API</h1>
<PermissionView Permission="@Permissions.ApiClientManage">
@if(Vm.OneTimeApiKey is not null){<div class="notice success"><strong>این کلید فقط همین بار نمایش داده می‌شود؛ اکنون در محل امن ذخیره کنید.</strong><p dir="ltr"><code>@Vm.OneTimeApiKey</code></p><button @onclick="Vm.DismissOneTimeKey">پاک‌کردن از صفحه</button></div>}
<LoadingPanel Loading="Vm.IsLoading" Error="Vm.Error" />
<div class="card"><PagedTable TItem="ClientApiKeyRow" Items="Vm.ApiKeys" PageNumber="1" TotalPages="1" TotalCount="Vm.ApiKeys.Count"><Header><th>نام</th><th>پیشوند</th><th>Scope</th><th>انقضا</th><th>وضعیت</th><th></th></Header><Row Context="item"><td>@item.Name</td><td dir="ltr">@item.KeyPrefix</td><td>@item.Scopes</td><td>@JalaliDateFormatter.Format(item.ExpiresAt)</td><td>@(item.IsActive?"فعال":"باطل")</td><td><ConfirmDanger Text="ابطال" Confirmed="()=>Vm.RevokeKeyAsync(item.Id)" /></td></Row></PagedTable></div>
<div class="card"><h2>صدور کلید جدید</h2><label>نام مصرف‌کننده<input @bind="Name" /></label><label>درخواست در دقیقه<input type="number" min="1" max="10000" @bind="Rate" /></label><JalaliDateInput Label="انقضا (اختیاری)" @bind-Value="ExpiresAt" /><div class="grid cols-3">@foreach(var scope in Scopes){<label><input type="checkbox" checked="@Selected.Contains(scope)" @onchange="args=>Toggle(scope,args)" />@scope</label>}</div><button @onclick="CreateAsync">صدور کلید</button></div>
</PermissionView>
@code {
private string Name="";private int Rate=60;private DateTimeOffset? ExpiresAt;private readonly HashSet<ApiScope> Selected=new();
private static readonly ApiScope[] Scopes={ApiScope.InvoiceWrite,ApiScope.InvoiceRead,ApiScope.BaseInfoRead,ApiScope.InquiryRead,ApiScope.PaymentWrite};
protected override Task OnInitializedAsync()=>Vm.LoadAsync();
private void Toggle(ApiScope scope,ChangeEventArgs args){if(args.Value is bool selected&&selected)Selected.Add(scope);else Selected.Remove(scope);}
private async Task CreateAsync(){var flags=Selected.Aggregate(ApiScope.None,(current,next)=>current|next);await Vm.CreateKeyAsync(new ClientApiKeyRequest(Name,flags,Rate,ExpiresAt));Name="";Selected.Clear();}
}
