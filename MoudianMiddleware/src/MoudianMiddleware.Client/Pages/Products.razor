@page "/products"
@attribute [Authorize]
@inject MasterDataViewModel Data
@inject ProductService Service
<PageTitle>کالا و خدمات</PageTitle>
<h1>کالا و خدمات</h1>
<div class="card"><div class="toolbar"><input @bind="Search" placeholder="جست‌وجوی کالا/خدمت" /><button @onclick="LoadAsync">جست‌وجو</button><PermissionView Permission="@Permissions.ProductEdit"><button class="secondary" @onclick="New">قلم جدید</button></PermissionView></div>
<LoadingPanel Loading="Data.IsLoading" Error="Data.Error" />
@if (Data.Products is not null)
{
<PagedTable TItem="ProductViewModel" Items="Data.Products.Items" PageNumber="Data.Products.PageNumber" TotalPages="Data.Products.TotalPages" TotalCount="Data.Products.TotalCount" PageChanged="PageAsync">
<Header><th>شناسه</th><th>عنوان</th><th>قیمت (ریال)</th><th>مالیات (%)</th><th>فعال</th><th></th></Header>
<Row Context="item"><td>@item.Sstid</td><td>@item.Title</td><td>@JalaliDateFormatter.ToPersianDigits(item.UnitPrice.ToString("N0",Fa))</td><td>@item.VatRate</td><td>@(item.IsActive?"بله":"خیر")</td><td><PermissionView Permission="@Permissions.ProductEdit"><button class="secondary" @onclick="()=>Edit(item)">ویرایش</button></PermissionView><PermissionView Permission="@Permissions.ProductDelete"><ConfirmDanger Confirmed="()=>DeleteAsync(item.Id)" /></PermissionView></td></Row>
</PagedTable>
}</div>
<PermissionView Permission="@Permissions.ProductEdit"><div class="card"><h2>ویرایش کالا/خدمت</h2><div class="grid cols-2"><label>شناسه مودیان<input @bind="Form.Sstid" /></label><label>عنوان<input @bind="Form.Title" /></label><label>شناسه واحد اندازه‌گیری<input type="number" @bind="Form.MeasuringUnitId" /></label><label>قیمت واحد (ریال)<input type="number" @bind="Form.UnitPrice" /></label><label>نرخ مالیات (%)<input type="number" @bind="Form.VatRate" /></label><label><input type="checkbox" @bind="Form.IsService" /> خدمت است</label></div><div class="form-actions"><button @onclick="SaveAsync">ذخیره</button><button class="secondary" @onclick="New">پاک‌کردن فرم</button></div>@if(Message is not null){<div class="notice">@Message</div>}</div></PermissionView>
@code {
private static readonly System.Globalization.CultureInfo Fa=new("fa-IR");private string? Search;private int EditingId;private string? Message;private ProductFormModel Form=new();
protected override Task OnInitializedAsync()=>Data.LoadProductsAsync();private Task LoadAsync()=>Data.LoadProductsAsync(search:Search);private Task PageAsync(int page)=>Data.LoadProductsAsync(page,Search);
private void New(){EditingId=0;Form=new ProductFormModel();}private void Edit(ProductViewModel item){EditingId=item.Id;Form=new ProductWriteRequest{Sstid=item.Sstid,Title=item.Title,MeasuringUnitId=item.MeasuringUnitId,UnitPrice=item.UnitPrice,VatRate=item.VatRate,IsService=item.IsService,HsCode=item.HsCode,Description=item.Description,IsActive=item.IsActive};}
private async Task SaveAsync(){try{await Service.SaveAsync(Form.ToRequest(),EditingId==0?null:EditingId);Message="قلم ذخیره شد.";await LoadAsync();}catch(Exception ex){Message=ex.Message;}}
private async Task DeleteAsync(int id){try{await Service.DeleteAsync(id);await LoadAsync();}catch(Exception ex){Message=ex.Message;}}
}
