@page "/customers"
@attribute [Authorize]
@inject MasterDataViewModel Data
@inject CustomerService Service
<PageTitle>مشتریان</PageTitle>
<h1>مشتریان</h1>
<div class="card"><div class="toolbar"><input @bind="Search" placeholder="جست‌وجوی مشتری" /><button @onclick="LoadAsync">جست‌وجو</button><PermissionView Permission="@Permissions.CustomerEdit"><button class="secondary" @onclick="New">مشتری جدید</button></PermissionView></div>
<LoadingPanel Loading="Data.IsLoading" Error="Data.Error" />
@if (Data.Customers is not null)
{
<PagedTable TItem="CustomerViewModel" Items="Data.Customers.Items" PageNumber="Data.Customers.PageNumber" TotalPages="Data.Customers.TotalPages" TotalCount="Data.Customers.TotalCount" PageChanged="PageAsync">
<Header><th>کد</th><th>نام</th><th>نوع</th><th>شناسه ملی</th><th>تلفن</th><th></th></Header>
<Row Context="item"><td>@item.Code</td><td>@item.Name</td><td>@item.BuyerType</td><td>@item.NationalId</td><td>@item.Phone</td><td><PermissionView Permission="@Permissions.CustomerEdit"><button class="secondary" @onclick="() => Edit(item)">ویرایش</button></PermissionView><PermissionView Permission="@Permissions.CustomerDelete"><ConfirmDanger Confirmed="() => DeleteAsync(item.Id)" /></PermissionView></td></Row>
</PagedTable>
}</div>
<PermissionView Permission="@Permissions.CustomerEdit">
<div class="card"><h2>@(EditingId == 0 ? "افزودن مشتری" : "ویرایش مشتری")</h2><div class="grid cols-2"><label>کد<input @bind="Form.Code" /></label><label>نام<input @bind="Form.Name" /></label><label>شناسه ملی<input @bind="Form.NationalId" /></label><label>شماره اقتصادی<input @bind="Form.EconomicCode" /></label><label>کد پستی<input @bind="Form.PostalCode" /></label><label>نوع خریدار<select @bind="Form.BuyerType"><option value="1">حقیقی</option><option value="2">حقوقی</option></select></label><label>تلفن<input @bind="Form.Phone" /></label><label>نشانی<input @bind="Form.Address" /></label></div><div class="form-actions"><button @onclick="SaveAsync">ذخیره</button><button class="secondary" @onclick="New">پاک‌کردن فرم</button></div>@if (Message is not null){<div class="notice">@Message</div>}</div>
</PermissionView>
@code {
private string? Search; private int EditingId; private string? Message; private CustomerFormModel Form = new();
protected override Task OnInitializedAsync()=>Data.LoadCustomersAsync();
private Task LoadAsync()=>Data.LoadCustomersAsync(search:Search);
private Task PageAsync(int page)=>Data.LoadCustomersAsync(page,Search);
private void New(){EditingId=0;Form=new CustomerFormModel();}
private void Edit(CustomerViewModel item){EditingId=item.Id;Form=new CustomerWriteRequest{Code=item.Code,Name=item.Name,BuyerType=item.BuyerType,NationalId=item.NationalId,EconomicCode=item.EconomicCode,PostalCode=item.PostalCode,Address=item.Address,Phone=item.Phone,Email=item.Email,ExternalCode=item.ExternalCode,IsActive=item.IsActive};}
private async Task SaveAsync(){try{await Service.SaveAsync(Form.ToRequest(),EditingId==0?null:EditingId);Message="مشتری ذخیره شد.";await LoadAsync();}catch(Exception ex){Message=ex.Message;}}
private async Task DeleteAsync(int id){try{await Service.DeleteAsync(id);await LoadAsync();}catch(Exception ex){Message=ex.Message;}}
}
