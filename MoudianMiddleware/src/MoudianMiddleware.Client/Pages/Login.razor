@page "/login"
@attribute [AllowAnonymous]
@inject AuthSessionService Session
<PageTitle>ورود</PageTitle>
<div class="card login-card">
    <h1>ورود به سامانه</h1>
    @if (!string.IsNullOrEmpty(Session.Error)) { <div class="notice error">@Session.Error</div> }
    <EditForm Model="Model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="grid">
            <label>نام کاربری <InputText @bind-Value="Model.UserName" autocomplete="username" /></label>
            <label>گذرواژه <InputText @bind-Value="Model.Password" type="password" autocomplete="current-password" /></label>
        </div>
        <div class="form-actions"><button disabled="@Busy">@(Busy ? "در حال ورود…" : "ورود امن")</button></div>
    </EditForm>
</div>
@code {
    private readonly LoginForm Model = new();
    private bool Busy;
    private async Task SubmitAsync() { Busy = true; try { await Session.LoginAsync(Model.UserName, Model.Password); } finally { Model.Password = string.Empty; Busy = false; } }
    private sealed class LoginForm { [System.ComponentModel.DataAnnotations.Required] public string UserName { get; set; } = string.Empty; [System.ComponentModel.DataAnnotations.Required] public string Password { get; set; } = string.Empty; }
}
