@page "/tenant-selection"
@attribute [Authorize]
@inject AuthSessionService Session
<PageTitle>انتخاب مودی</PageTitle>
<h1>انتخاب مودی</h1>
<p class="muted">یکی از عضویت‌های فعال حساب خود را انتخاب کنید. سرور عضویت را دوباره بررسی می‌کند.</p>
@if (!string.IsNullOrWhiteSpace(Session.Error)) { <div class="notice error">@Session.Error</div> }
<div class="grid cols-2">
    @foreach (var tenant in Session.Memberships)
    {
        <div class="card"><h2>@tenant.TenantName</h2><p>@tenant.Permissions.Count مجوز فعال</p><button @onclick="() => SelectAsync(tenant.TenantId)">انتخاب</button></div>
    }
</div>
@code { private Task SelectAsync(int tenantId) => Session.SelectTenantAsync(tenantId); }
