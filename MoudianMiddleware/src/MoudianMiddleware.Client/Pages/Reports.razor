@page "/reports"
@attribute [Authorize]
@inject ReportViewModel Vm
@inject IJSRuntime JS
<PageTitle>گزارش‌ها</PageTitle>
<h1>گزارش‌ها</h1>
<PermissionView Permission="@Permissions.ReportView"><div class="card"><h2>خروجی فاکتورها</h2><div class="grid cols-2"><JalaliDateInput Label="از تاریخ" @bind-Value="From" /><JalaliDateInput Label="تا تاریخ" @bind-Value="To" /></div><PermissionView Permission="@Permissions.ReportExport"><button @onclick="DownloadAsync" disabled="Busy">@(Busy?"در حال ساخت…":"دریافت Excel")</button></PermissionView>@if(Error is not null){<div class="notice error">@Error</div>}</div></PermissionView>
@code {
private DateTimeOffset? From=DateTimeOffset.Now.AddMonths(-1); private DateTimeOffset? To=DateTimeOffset.Now; private bool Busy; private string? Error;
private async Task DownloadAsync(){if(From is null||To is null||From>To){Error="بازه تاریخ معتبر نیست.";return;}Busy=true;Error=null;try{Vm.From=DateOnly.FromDateTime(From.Value.Date);Vm.To=DateOnly.FromDateTime(To.Value.Date);await Vm.DownloadAsync();if(Vm.Error is not null)Error=Vm.Error;else if(Vm.File is not null)await JS.InvokeVoidAsync("downloadFile","invoices.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",Convert.ToBase64String(Vm.File));}catch(Exception ex){Error=ex.Message;}finally{Vm.ClearFile();Busy=false;}}
}
