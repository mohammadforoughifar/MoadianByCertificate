@page "/roles"
@attribute [Authorize]
@inject AdministrationViewModel Vm
<PageTitle>نقش‌ها</PageTitle>
<h1>مدیریت نقش‌ها و مجوزها</h1>
<PermissionView Permission="@Permissions.RoleManage"><LoadingPanel Loading="Vm.IsLoading" Error="Vm.Error" /><div class="card"><PagedTable TItem="ClientRoleRow" Items="Vm.Roles" PageNumber="1" TotalPages="1" TotalCount="Vm.Roles.Count"><Header><th>نقش</th><th>مجوزها</th></Header><Row Context="item"><td>@item.Name</td><td>@string.Join("، ",item.Permissions)</td></Row></PagedTable></div>
<div class="card"><h2>نقش جدید</h2><label>نام نقش<input @bind="Name" /></label><label>توضیح<input @bind="Description" /></label><h3>مجوزها</h3><div class="grid cols-3">@foreach(var permission in Permissions.All){<label><input type="checkbox" checked="@Selected.Contains(permission)" @onchange="args=>Toggle(permission,args)" />@permission</label>}</div><button @onclick="SaveAsync">ذخیره نقش</button></div></PermissionView>
@code {
private string Name="";private string? Description;private readonly HashSet<string> Selected=new(StringComparer.Ordinal);
protected override Task OnInitializedAsync()=>Vm.LoadAsync();
private void Toggle(string permission,ChangeEventArgs args){if(args.Value is bool selected&&selected)Selected.Add(permission);else Selected.Remove(permission);}
private async Task SaveAsync(){await Vm.CreateRoleAsync(new ClientRoleRequest(Name,Description,Selected.ToArray()));Name="";Description=null;Selected.Clear();}
}
