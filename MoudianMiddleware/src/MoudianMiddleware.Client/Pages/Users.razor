@page "/users"
@attribute [Authorize]
@inject AdministrationViewModel Vm
<PageTitle>کاربران</PageTitle>
<h1>مدیریت کاربران</h1>
<PermissionView Permission="@Permissions.UserView"><button class="secondary" @onclick="() => Vm.LoadAsync()">بارگذاری دوباره</button><LoadingPanel Loading="Vm.IsLoading" Error="Vm.Error" /><div class="card"><PagedTable TItem="ClientUserRow" Items="Vm.Users" PageNumber="1" TotalPages="1" TotalCount="Vm.Users.Count"><Header><th>نام کاربری</th><th>نام</th><th>نقش</th><th>وضعیت</th></Header><Row Context="item"><td>@item.UserName</td><td>@item.FullName</td><td>@item.RoleName</td><td>@(item.IsActive?"فعال":"غیرفعال")</td></Row></PagedTable></div></PermissionView>
<PermissionView Permission="@Permissions.UserEdit"><div class="card"><h2>ایجاد کاربر در مودی جاری</h2><div class="grid cols-2"><label>نام کاربری<input @bind="UserName" /></label><label>نام کامل<input @bind="FullName" /></label><label>گذرواژه موقت<input type="password" @bind="Password" autocomplete="new-password" /></label><label>شناسه نقش<input type="number" @bind="RoleId" /></label></div><button @onclick="CreateAsync">ایجاد</button></div></PermissionView>
@code {
private string UserName="",FullName="",Password="";private int RoleId;
protected override Task OnInitializedAsync()=>Vm.LoadAsync();
private async Task CreateAsync(){await Vm.CreateUserAsync(new ClientUserRequest(UserName,FullName,Password,RoleId));Password=string.Empty;UserName=string.Empty;FullName=string.Empty;}
}
