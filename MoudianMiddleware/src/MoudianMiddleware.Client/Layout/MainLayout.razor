@inherits LayoutComponentBase
@inject AuthSessionService Session
<div class="shell">
    <aside class="sidebar">
        <div class="brand">سامانه مدیریت مودیان</div>
        <AuthorizeView>
            <Authorized>
                <nav class="nav">
                    <NavLink href="/dashboard">داشبورد</NavLink>
                    <PermissionView Permission="@Permissions.InvoiceView"><NavLink href="/invoices">صورتحساب‌ها</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.CustomerView"><NavLink href="/customers">مشتریان</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.ProductView"><NavLink href="/products">کالا و خدمات</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.MoadianView"><NavLink href="/moadian-settings">تنظیمات مودیان</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.ReportView"><NavLink href="/reports">گزارش‌ها</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.UserView"><NavLink href="/users">کاربران</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.RoleManage"><NavLink href="/roles">نقش‌ها</NavLink></PermissionView>
                    <PermissionView Permission="@Permissions.ApiClientManage"><NavLink href="/api-clients">کلیدهای API</NavLink></PermissionView>
                </nav>
            </Authorized>
            <NotAuthorized><nav class="nav"><NavLink href="/login">ورود</NavLink></nav></NotAuthorized>
        </AuthorizeView>
    </aside>
    <div class="main">
        <header class="topbar"><span>پنل کاربری مودیان</span><AuthorizeView><Authorized><button class="secondary" @onclick="Session.SignOut">خروج امن</button></Authorized></AuthorizeView></header>
        <main class="content">@Body</main>
    </div>
</div>
