{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "MoudianMiddleware.Api": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MOUDIAN__CONNECTION_STRING": "Server=(localdb)\\MSSQLLocalDB;Database=MoudianMiddlewareDev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
        "MOUDIAN__CLIENT_ORIGIN": "http://localhost:5081",
        "MOUDIAN__DEV_TENANT_NAME": "مودی آزمایشی"
      }
    }
  }
}
