<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Inventory.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.30" />
    <ProjectReference Include="../../../src/TotallSoftwareForoughAriya.Shared/TotallSoftwareForoughAriya.Shared.csproj" />
    <Compile Include="../../../src/TotallSoftwareForoughAriya.Client/**/*.cs"
             Exclude="../../../src/TotallSoftwareForoughAriya.Client/bin/**;../../../src/TotallSoftwareForoughAriya.Client/obj/**;../../../src/TotallSoftwareForoughAriya.Client/Program.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Render the actual Client Razor components, including both repaired IT settings pages. -->
    <RazorComponent Include="../../../src/TotallSoftwareForoughAriya.Client/**/*.razor"
             Exclude="../../../src/TotallSoftwareForoughAriya.Client/bin/**;../../../src/TotallSoftwareForoughAriya.Client/obj/**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
