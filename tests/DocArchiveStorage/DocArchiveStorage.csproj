<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- بررسی محل ذخیرهٔ فایل مدارک آرشیو روی دیسک سرور (آپلود دستی، ورود انبوه، حذف قطعی)
       و آدرس‌دهی زیر مسیر پایهٔ IIS. اجرا با dotnet run در همین پوشه -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- هندلر مسیر پایهٔ کلاینت مستقیم کامپایل می‌شود (پروژهٔ Blazor WASM قابل ارجاع از کنسول نیست) -->
    <Compile Include="../../src/TotallSoftwareForoughAriya.Client/Services/PathBaseHandler.cs" Link="PathBaseHandler.cs" />
    <ProjectReference Include="../../src/TotallSoftwareForoughAriya.Api/TotallSoftwareForoughAriya.Api.csproj" />
    <ProjectReference Include="../../src/TotallSoftwareForoughAriya.Shared/TotallSoftwareForoughAriya.Shared.csproj" />
  </ItemGroup>
</Project>
