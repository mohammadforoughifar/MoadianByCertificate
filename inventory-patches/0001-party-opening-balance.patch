+    public async Task<PartyOpeningBalanceDto> GetPartyOpeningBalanceAsync(int partyId)
+    {
+        var o = await _db.PartyOpeningBalances.AsNoTracking().FirstOrDefaultAsync(x => x.PartyId == partyId);
+        return new PartyOpeningBalanceDto
+        {
+            PartyId = partyId,
+            AsOfDate = o?.AsOfDate,
+            Amount = o?.Amount ?? 0,
+            Note = o?.Note,
+            UpdatedBy = o?.UpdatedBy,
+            UpdatedAt = o?.UpdatedAt,
+        };
+    }
+
+    public async Task<PartyOpeningBalanceDto> SavePartyOpeningBalanceAsync(int partyId, PartyOpeningBalanceDto dto, string? user)
+    {
+        // طرف‌حساب باید در شرکت فعال باشد (فیلتر شرکت روی Parties اعمال می‌شود)
+        _ = await _db.Parties.AsNoTracking().FirstOrDefaultAsync(p => p.Id == partyId)
+            ?? throw new InvalidOperationException("طرف حساب یافت نشد.");
+        if (dto.AsOfDate is null)
+            throw new InvalidOperationException("تاریخ شروع دوره را وارد کنید.");
+
+        var entity = await _db.PartyOpeningBalances.FirstOrDefaultAsync(x => x.PartyId == partyId);
+        if (entity is null)
+        {
+            entity = new Db.PartyOpeningBalance { PartyId = partyId };
+            _db.PartyOpeningBalances.Add(entity);
+        }
+        entity.AsOfDate = dto.AsOfDate.Value.Date;
+        entity.Amount = Math.Round(dto.Amount, 2);
+        entity.Note = NullIfEmpty(dto.Note);
+        entity.UpdatedBy = user;
+        entity.UpdatedAt = DateTime.Now;
+        await _db.SaveChangesAsync();
+
+        return await GetPartyOpeningBalanceAsync(partyId);
+    }
