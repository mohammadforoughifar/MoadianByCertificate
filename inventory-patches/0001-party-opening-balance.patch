+using System.ComponentModel.DataAnnotations;
+using Inventory.Shared;
+namespace Inventory.Api.Data;
+
+/// <summary>
+/// مانده اول دوره‌ی طرف‌حساب (بدهکار/بستانکار) به تفکیک شرکت.
+/// <para>
+/// علامت مبلغ همان قاعدهٔ مانده‌ی طرف‌حساب است:
+/// <c>مثبت</c> = طرف‌حساب به شرکت بدهکار است، <c>منفی</c> = بستانکار است.
+/// </para>
+/// <para>
+/// این مانده جداست از سوابق فروش/خرید (<see cref="Transaction"/>) و به مانده‌ی
+/// محاسبه‌شده اضافه می‌شود؛ سند حسابداری تولید نمی‌کند.
+/// </para>
+/// </summary>
+public class PartyOpeningBalance : ICompanyOwned
+{
+    public int Id { get; set; }
+
+    /// <summary>شرکت مالک رکورد — دادهٔ هر شرکت مستقل نگه‌داری می‌شود (فیلتر خودکار).</summary>
+    public int? CompanyId { get; set; }
+
+    public int PartyId { get; set; }
+
+    /// <summary>تاریخ شروع دوره‌ای که این مانده متعلق به آن است.</summary>
+    public DateTime AsOfDate { get; set; }
+
+    /// <summary>مبلغ مانده؛ مثبت = بدهکار، منفی = بستانکار.</summary>
+    public decimal Amount { get; set; }
+
+    [MaxLength(500)]
+    public string? Note { get; set; }
+
+    [MaxLength(80)]
+    public string? UpdatedBy { get; set; }
+
+    public DateTime UpdatedAt { get; set; } = DateTime.Now;
+}
