@@ -0,0 +1,67 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace Inventory.Api.Data;
+
+// ============================================================
+//  خودتعمیرِ جدول «مانده اول دوره‌ی طرف‌حساب» — نسخه ۱
+//  • EnsureCreated فقط دیتابیس خالی را می‌سازد و Migrate هم برای
+//    جدول‌های تازه در دیتابیس‌های قدیمی همیشه کافی نیست؛ پس جدول را
+//    به‌صورت idempotent (IF NOT EXISTS) می‌سازیم.
+//  • ستون‌ها و نام‌ها دقیقاً مطابق PartyOpeningBalance / AppDbContext هستند.
+// ============================================================
+public static class PartyOpeningSchemaV1
+{
+    public static Task EnsureAsync(AppDbContext db) =>
+        db.Database.IsSqlite() ? EnsureSqliteAsync(db) : EnsureSqlServerAsync(db);
+
+    private static async Task EnsureSqlServerAsync(AppDbContext db)
+    {
+        await SafeAsync(db, @"
+IF OBJECT_ID(N'dbo.PartyOpeningBalances', N'U') IS NULL
+CREATE TABLE dbo.PartyOpeningBalances (
+    Id          int IDENTITY(1,1) NOT NULL CONSTRAINT PK_PartyOpeningBalances PRIMARY KEY,
+    CompanyId   int NULL,
+    PartyId     int NOT NULL,
+    AsOfDate    datetime2 NOT NULL,
+    Amount      decimal(18,2) NOT NULL CONSTRAINT DF_PartyOpeningBalances_Amount DEFAULT(0),
+    Note        nvarchar(500) NULL,
+    UpdatedBy   nvarchar(80) NULL,
+    UpdatedAt   datetime2 NOT NULL CONSTRAINT DF_PartyOpeningBalances_UpdatedAt DEFAULT(GETDATE())
+);");
+
+        await SafeAsync(db, @"
+IF OBJECT_ID(N'dbo.PartyOpeningBalances', N'U') IS NOT NULL
+   AND NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'IX_PartyOpeningBalances_CompanyId_PartyId')
+CREATE UNIQUE INDEX IX_PartyOpeningBalances_CompanyId_PartyId ON dbo.PartyOpeningBalances (CompanyId, PartyId);");
+    }
+
+    private static async Task EnsureSqliteAsync(AppDbContext db)
+    {
+        await SafeAsync(db, @"
+CREATE TABLE IF NOT EXISTS PartyOpeningBalances (
+    Id        INTEGER PRIMARY KEY AUTOINCREMENT,
+    CompanyId INTEGER NULL,
+    PartyId   INTEGER NOT NULL,
+    AsOfDate  TEXT NOT NULL,
+    Amount    TEXT NOT NULL DEFAULT '0',
+    Note      TEXT NULL,
+    UpdatedBy TEXT NULL,
+    UpdatedAt TEXT NOT NULL
+);");
+
+        await SafeAsync(db,
+            "CREATE UNIQUE INDEX IF NOT EXISTS IX_PartyOpeningBalances_CompanyId_PartyId ON PartyOpeningBalances (CompanyId, PartyId);");
+    }
+
+    private static async Task SafeAsync(AppDbContext db, string sql)
+    {
+        try { await db.Database.ExecuteSqlRawAsync(sql); }
+        catch (Exception ex)
+        {
+            var m = ex.Message ?? "";
+            if (!m.Contains("duplicate", StringComparison.OrdinalIgnoreCase) &&
+                !m.Contains("already exists", StringComparison.OrdinalIgnoreCase))
+                Console.WriteLine($"[DB] PartyOpeningSchemaV1: {m}");
+        }
+    }
+}
