+@page "/inv/opening-stock"
+@inject IInvDocService DocSvc
+@inject IInvDocTypeService DocTypeSvc
+@inject IInvWarehouseService WarehouseSvc
+@inject IInvProductService ProductSvc
+@inject IToastService Toast
+@inject LayoutState Layout
+@inject NavigationManager Nav
+
+<PageTitle>اول دوره انبار</PageTitle>
+
+<div class="page-head">
+    <div>
+        <h1 class="page-title">موجودی اول دوره انبار</h1>
+        <p class="text-muted mb-0">
+            موجودی ابتدای دوره‌ی هر انبار را با مقدار و بهای واحد ثبت کنید. با ثبت، یک سند «رسید موجودی اول دوره» ساخته و قطعی می‌شود
+            و در کاردکس و موجودی انبار دیده می‌شود. سند حسابداری تولید نمی‌شود.
+        </p>
+    </div>
+</div>
+
+<div class="card mb-3">
+    <div class="card-body">
+        <div class="row g-3 align-items-end">
+            <div class="col-md-4">
+                <label class="form-label">انبار <span class="text-danger">*</span></label>
+                <select class="form-select" @onchange="WarehouseChanged" disabled="@(busy)">
+                    <option value="0">— انتخاب انبار —</option>
+                    @foreach (var w in warehouses)
+                    {
+                        <option value="@w.Id" selected="@(w.Id == warehouseId)">@w.Name</option>
+                    }
+                </select>
+            </div>
+            <div class="col-md-3">
+                <label class="form-label">تاریخ سند اول دوره</label>
+                <DatePicker Value="docDate" ValueChanged="d => docDate = d" />
+            </div>
+            <div class="col-md-3">
+                <button class="btn btn-outline-primary" @onclick="LoadProducts" disabled="@(warehouseId <= 0 || busy)">
+                    <i class="bi bi-arrow-repeat"></i> بارگذاری کالاها
+                </button>
+            </div>
+        </div>
+    </div>
+</div>
+
+@if (busy)
+{
+    <div class="text-center py-4"><span class="spinner-border"></span></div>
+}
+else if (warehouseId > 0 && loaded)
+{
+    @if (openingDocs.Count > 0)
+    {
+        <div class="card mb-3">
+            <div class="card-header fw-bold">اسناد اول دوره‌ی این انبار</div>
+            <div class="table-responsive">
+                <table class="table table-sm mb-0">
+                    <thead><tr><th>شماره</th><th>تاریخ</th><th>وضعیت</th><th>تعداد ردیف</th><th></th></tr></thead>
+                    <tbody>
+                        @foreach (var d in openingDocs)
+                        {
+                            <tr>
+                                <td class="num">@d.Number</td>
+                                <td class="num">@d.Date.ToString("yyyy/MM/dd")</td>
+                                <td>@d.StatusTitle</td>
+                                <td class="num">@d.LineCount</td>
+                                <td class="text-end"><a href="/inv/docs/edit/@d.Id">مشاهده سند</a></td>
+                            </tr>
+                        }
+                    </tbody>
+                </table>
+            </div>
+        </div>
+    }
+
+    @if (alreadyConfirmed)
+    {
+        <div class="alert alert-warning">
+            موجودی اول دوره‌ی این انبار قبلاً قطعی شده است. برای تغییر، سند قطعی را در صفحه‌ی سند ابطال یا اصلاح کنید؛
+            ثبت دوباره‌ی اول دوره مجاز نیست تا موجودی دوبار شمرده نشود.
+        </div>
+    }
+
+    <div class="card">
+        <div class="table-responsive">
+            <table class="table table-sm align-middle mb-0">
+                <thead>
+                    <tr>
+                        <th style="width:50px">#</th>
+                        <th>کالا</th>
+                        <th style="width:180px">مقدار اول دوره</th>
+                        <th style="width:220px">بهای واحد (تومان)</th>
+                        <th style="width:180px">ارزش</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @{ var i = 0; }
+                    @foreach (var r in rows)
+                    {
+                        i++;
+                        <tr>
+                            <td class="num">@i</td>
+                            <td>@r.Name</td>
+                            <td><input type="number" step="any" min="0" class="form-control form-control-sm num text-center" disabled="@alreadyConfirmed" @bind="r.Qty" /></td>
+                            <td><MoneyInput Value="r.Price" ValueChanged="v => r.Price = v" CssClass="form-control form-control-sm num text-center" /></td>
+                            <td class="num">@((r.Qty * r.Price).Money())</td>
+                        </tr>
+                    }
+                </tbody>
+                <tfoot>
+                    <tr>
+                        <th colspan="4" class="text-end">جمع ارزش (کالاهای با مقدار مثبت)</th>
+                        <th class="num">@TotalValue.Money()</th>
+                    </tr>
+                </tfoot>
+            </table>
+        </div>
+    </div>
+
+    <div class="d-flex justify-content-end gap-2 mt-3">
+        <button class="btn btn-primary" @onclick="SaveAndConfirm" disabled="@(saveDisabled)">
+            @if (saving)
+            {
+                <span class="spinner-border spinner-border-sm ms-1"></span>
+            }
+            ثبت و قطعی‌سازی اول دوره
+        </button>
+    </div>
+    <div class="small text-muted mt-2">
+        فقط کالاهایی ثبت می‌شوند که مقدار بزرگ‌تر از صفر دارند. برای هر کالای دارای مقدار، بهای واحد بزرگ‌تر از صفر لازم است.
+    </div>
+}
+
+@code {
+    private sealed class OpeningRow
+    {
+        public int ProductId { get; set; }
+        public string Name { get; set; } = "";
+        public decimal Qty { get; set; }
+        public decimal Price { get; set; }
+    }
+
+    private List<LookupItem> warehouses = new();
+    private List<OpeningRow> rows = new();
+    private List<InvDoc> openingDocs = new();
+    private InvDocType? openingType;
+    private int warehouseId;
+    private DateTime? docDate = DateTime.Today;
+    private bool busy, saving, loaded, alreadyConfirmed;
+
+    private decimal TotalValue => rows.Where(r => r.Qty > 0).Sum(r => r.Qty * r.Price);
+
+    private bool saveDisabled => saving || alreadyConfirmed
+        || !rows.Any(r => r.Qty > 0)
+        || rows.Any(r => r.Qty > 0 && r.Price <= 0)
+        || docDate is null;
+
+    protected override async Task OnInitializedAsync()
+    {
+        Layout.SetTitle("اول دوره انبار");
+        try
+        {
+            warehouses = await WarehouseSvc.GetLookupsAsync(true);
+            var types = await DocTypeSvc.GetAllAsync(true);
+            openingType = types.FirstOrDefault(t => t.Code == "RC-OPEN");
+            if (openingType is null)
+                Toast.Error("نوع سند «رسید موجودی اول دوره» (RC-OPEN) در سامانه پیدا نشد.");
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+    }
+
+    private void WarehouseChanged(ChangeEventArgs e)
+    {
+        warehouseId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
+        loaded = false;
+        rows.Clear();
+        openingDocs.Clear();
+        alreadyConfirmed = false;
+    }
+
+    private async Task LoadProducts()
+    {
+        if (warehouseId <= 0) return;
+        busy = true;
+        try
+        {
+            var products = await ProductSvc.GetLookupsAsync(null, null);
+            rows = products.OrderBy(p => p.Name)
+                           .Select(p => new OpeningRow { ProductId = p.Id, Name = p.Name })
+                           .ToList();
+
+            openingDocs = new();
+            if (openingType is not null)
+            {
+                var page = await DocSvc.GetAllAsync(docTypeId: openingType.Id, warehouseId: warehouseId, pageSize: 50);
+                openingDocs = page.Items;
+            }
+            alreadyConfirmed = openingDocs.Any(d => d.Status == InvDocStatus.Confirmed);
+            loaded = true;
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+        finally { busy = false; }
+    }
+
+    private async Task SaveAndConfirm()
+    {
+        if (openingType is null || docDate is null || alreadyConfirmed) return;
+        var lines = rows.Where(r => r.Qty > 0).ToList();
+        if (lines.Count == 0) { Toast.Error("هیچ کالایی با مقدار مثبت وارد نشده است."); return; }
+
+        saving = true;
+        InvDoc? draft = null;
+        try
+        {
+            var doc = new InvDoc
+            {
+                DocTypeId = openingType.Id,
+                Nature = openingType.Nature,
+                IsTransfer = false,
+                WarehouseId = warehouseId,
+                Date = docDate.Value,
+                Description = "موجودی اول دوره",
+                Status = InvDocStatus.Draft,
+                Lines = lines.Select((r, idx) => new InvDocLine
+                {
+                    RowNo = idx + 1,
+                    ProductId = r.ProductId,
+                    Quantity = r.Qty,
+                    UnitPrice = r.Price,
+                }).ToList(),
+            };
+
+            draft = await DocSvc.SaveAsync(doc);
+            var confirmed = await DocSvc.ConfirmAsync(draft.Id);
+            Toast.Success($"اول دوره انبار ثبت و سند {confirmed.Number} قطعی شد.");
+            Nav.NavigateTo($"/inv/docs/edit/{confirmed.Id}");
+        }
+        catch (Exception ex)
+        {
+            Toast.Error(draft is not null
+                ? $"سند پیش‌نویس ساخته شد اما قطعی نشد: {ex.Message}"
+                : ex.Message);
+            if (draft is not null) Nav.NavigateTo($"/inv/docs/edit/{draft.Id}");
+        }
+        finally { saving = false; }
+    }
+}
