+@namespace Inventory.Client.Shared
+@inject IPartyService PartySvc
+@inject IToastService Toast
+
+@* ================== مانده اول دوره‌ی طرف‌حساب ==================
+   مانده بدهکار/بستانکار شروع دوره را ثبت می‌کند. مثبت = بدهکار، منفی = بستانکار.
+   سند حسابداری تولید نمی‌کند؛ فقط به مانده‌ی طرف‌حساب اضافه می‌شود.
+   ================================================================ *@
+
+<Modal Visible="Visible" Title="@($"مانده اول دوره — {Target?.Name}")" OnClose="Close">
+    <ChildContent>
+        @if (loading)
+        {
+            <div class="text-center py-4"><span class="spinner-border"></span></div>
+        }
+        else
+        {
+            <div class="alert alert-light border py-2 fs-8 mb-3">
+                بدهکار یعنی طرف‌حساب در ابتدای دوره به شرکت بدهکار است؛ بستانکار یعنی شرکت به طرف‌حساب بدهکار است.
+            </div>
+            <div class="row g-3">
+                <div class="col-md-6">
+                    <label class="form-label">وضعیت مانده</label>
+                    <select class="form-select" @bind="side">
+                        <option value="debit">بدهکار (طلب شرکت)</option>
+                        <option value="credit">بستانکار (بدهی شرکت)</option>
+                    </select>
+                </div>
+                <div class="col-md-6">
+                    <label class="form-label">مبلغ (تومان)</label>
+                    <MoneyInput Value="amount" ValueChanged="v => amount = v" />
+                </div>
+                <div class="col-md-6">
+                    <label class="form-label">تاریخ شروع دوره <span class="text-danger">*</span></label>
+                    <DatePicker Value="asOfDate" ValueChanged="d => asOfDate = d" />
+                </div>
+                <div class="col-md-6">
+                    <label class="form-label">توضیح</label>
+                    <input class="form-control" @bind="note" maxlength="500" />
+                </div>
+            </div>
+            @if (!string.IsNullOrWhiteSpace(updatedInfo))
+            {
+                <div class="small text-muted mt-3">@updatedInfo</div>
+            }
+        }
+    </ChildContent>
+    <Footer>
+        <button class="btn btn-light" @onclick="Close">انصراف (Esc)</button>
+        <button class="btn btn-primary" @onclick="Save" disabled="@(saving || loading)">
+            @if (saving)
+            {
+                <span class="spinner-border spinner-border-sm ms-1"></span>
+            }
+            ذخیره مانده
+        </button>
+    </Footer>
+</Modal>
+
+@code {
+    [Parameter] public bool Visible { get; set; }
+    [Parameter] public Party? Target { get; set; }
+    [Parameter] public EventCallback OnSaved { get; set; }
+    [Parameter] public EventCallback OnCancel { get; set; }
+
+    private bool loading;
+    private bool saving;
+    private int loadedFor;
+    private string side = "debit";
+    private decimal amount;
+    private DateTime? asOfDate;
+    private string? note;
+    private string? updatedInfo;
+
+    protected override async Task OnParametersSetAsync()
+    {
+        if (!Visible)
+        {
+            loadedFor = 0;
+            return;
+        }
+        if (Target is not null && Target.Id != loadedFor)
+        {
+            loadedFor = Target.Id;
+            await LoadAsync();
+        }
+    }
+
+    private async Task LoadAsync()
+    {
+        loading = true;
+        try
+        {
+            var o = await PartySvc.GetOpeningBalanceAsync(Target!.Id);
+            side = o.Amount < 0 ? "credit" : "debit";
+            amount = Math.Abs(o.Amount);
+            asOfDate = o.AsOfDate ?? new DateTime(DateTime.Today.Year, 1, 1);
+            note = o.Note;
+            updatedInfo = o.UpdatedAt is null ? null
+                : $"آخرین ثبت: {o.UpdatedBy ?? "—"} — {o.UpdatedAt.Value:yyyy/MM/dd HH:mm}";
+        }
+        catch (Exception ex)
+        {
+            Toast.Error(ex.Message);
+        }
+        finally
+        {
+            loading = false;
+        }
+    }
+
+    private async Task Save()
+    {
+        if (Target is null) return;
+        if (asOfDate is null)
+        {
+            Toast.Error("تاریخ شروع دوره را وارد کنید.");
+            return;
+        }
+        saving = true;
+        try
+        {
+            var signed = side == "credit" ? -Math.Abs(amount) : Math.Abs(amount);
+            await PartySvc.SaveOpeningBalanceAsync(Target.Id, new PartyOpeningBalanceDto
+            {
+                PartyId = Target.Id,
+                AsOfDate = asOfDate,
+                Amount = signed,
+                Note = string.IsNullOrWhiteSpace(note) ? null : note.Trim(),
+            });
+            Toast.Success("مانده اول دوره ثبت شد.");
+            loadedFor = 0;
+            await OnSaved.InvokeAsync();
+        }
+        catch (Exception ex)
+        {
+            Toast.Error(ex.Message);
+        }
+        finally
+        {
+            saving = false;
+        }
+    }
+
+    private async Task Close()
+    {
+        loadedFor = 0;
+        await OnCancel.InvokeAsync();
+    }
+}
