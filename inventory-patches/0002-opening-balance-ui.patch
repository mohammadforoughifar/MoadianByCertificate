diff --git a/TotallCollectionSoftware/inventory/src/Inventory.Client/Pages/Warehousing/InvOpeningStock.razor b/TotallCollectionSoftware/inventory/src/Inventory.Client/Pages/Warehousing/InvOpeningStock.razor
