+using Inventory.Api.Infrastructure;
+using Inventory.Api.Services;
+using Inventory.Api.Services.StoreOpening;
+using Inventory.Shared;
+using Inventory.Shared.Dtos;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Inventory.Api.Controllers.StoreOpening;
+
+/// <summary>اول دوره‌ی فروشگاه (موجودی و طرف‌حساب). مجوز: ماژول StoreOpening (Read/Update).</summary>
+[ApiController]
+[Authorize]
+[ModulePermission("StoreOpening")]
+[Route("api/store-opening")]
+public class StoreOpeningController : ControllerBase
+{
+    private readonly IStoreOpeningService _service;
+    private readonly IInventoryService _inventory;
+
+    public StoreOpeningController(IStoreOpeningService service, IInventoryService inventory)
+    {
+        _service = service;
+        _inventory = inventory;
+    }
+
+    /// <summary>بازمحاسبه‌ی موجودی فروشگاه از سوابق فروشگاه (برای اصلاح مقدارهای قدیمی).</summary>
+    [HttpPost("rebuild-stock")]
+    public async Task<IActionResult> RebuildStock()
+    {
+        await _inventory.RebuildAllStockAsync();
+        return Ok(new { ok = true });
+    }
+
+    [HttpGet("stock")]
+    public async Task<ActionResult<StoreOpeningStockDto>> GetStock([FromQuery] int warehouseId)
+        => Ok(await _service.GetStockAsync(warehouseId));
+
+    [HttpPut("stock")]
+    public async Task<ActionResult<StoreOpeningStockDto>> SaveStock([FromBody] StoreOpeningStockDto dto)
+        => Ok(await _service.SaveStockAsync(dto, CurrentUser()));
+
+    [HttpGet("parties")]
+    public async Task<ActionResult<List<StoreOpeningPartyDto>>> GetParties([FromQuery] PartyType? type = null)
+        => Ok(await _service.GetPartiesAsync(type));
+
+    [HttpPut("parties/{partyId:int}")]
+    public async Task<ActionResult<StoreOpeningPartyDto>> SaveParty(int partyId, [FromBody] StoreOpeningPartyDto dto)
+        => Ok(await _service.SavePartyAsync(partyId, dto, CurrentUser()));
+
+    private string? CurrentUser() => User.Identity?.Name;
+}
