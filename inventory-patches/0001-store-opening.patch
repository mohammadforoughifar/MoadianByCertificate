+@page "/store/opening"
+@inject IStoreOpeningApi OpeningApi
+@inject IWarehouseService WarehouseSvc
+@inject IProductService ProductSvc
+@inject IToastService Toast
+@inject LayoutState Layout
+@inject IJSRuntime JS
+
+<PageTitle>اول دوره فروشگاه</PageTitle>
+
+<div class="page-head">
+    <div>
+        <h1 class="page-title">اول دوره فروشگاه</h1>
+        <p class="text-muted mb-0">
+            موجودی و مانده‌ی طرف‌حساب‌ها را برای شروع دوره‌ی فروشگاه ثبت کنید. این اطلاعات فقط در ماژول فروشگاه استفاده می‌شود
+            و هیچ سند انبارداری (ERP) یا سند حسابداری تولید نمی‌کند.
+        </p>
+    </div>
+</div>
+
+<ul class="nav nav-tabs mb-3">
+    <li class="nav-item">
+        <button class="nav-link @(tab == Tab.Stock ? "active" : "")" @onclick="() => SetTab(Tab.Stock)">موجودی کالا</button>
+    </li>
+    <li class="nav-item">
+        <button class="nav-link @(tab == Tab.Parties ? "active" : "")" @onclick="() => SetTab(Tab.Parties)">مانده طرف‌حساب‌ها</button>
+    </li>
+</ul>
+
+@if (tab == Tab.Stock)
+{
+    <div class="card mb-3">
+        <div class="card-body">
+            <div class="row g-3 align-items-end">
+                <div class="col-md-4">
+                    <label class="form-label">انبار <span class="text-danger">*</span></label>
+                    <select class="form-select" @onchange="WarehouseChanged" disabled="@busy">
+                        <option value="0">— انتخاب انبار —</option>
+                        @foreach (var w in warehouses)
+                        {
+                            <option value="@w.Id" selected="@(w.Id == warehouseId)">@w.Name</option>
+                        }
+                    </select>
+                </div>
+                <div class="col-md-3">
+                    <label class="form-label">تاریخ شروع دوره <span class="text-danger">*</span></label>
+                    <DatePicker Value="stockDate" ValueChanged="d => stockDate = d" />
+                </div>
+            </div>
+        </div>
+    </div>
+
+    @if (busy)
+    {
+        <div class="text-center py-4"><span class="spinner-border"></span></div>
+    }
+    else if (warehouseId > 0)
+    {
+        <div class="card">
+            <div class="table-responsive">
+                <table class="table table-sm align-middle mb-0">
+                    <thead>
+                        <tr>
+                            <th style="width:50px">#</th>
+                            <th>کالا</th>
+                            <th style="width:180px">مقدار اول دوره</th>
+                            <th style="width:220px">بهای واحد (تومان)</th>
+                            <th style="width:180px">ارزش</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        @{ var i = 0; }
+                        @foreach (var r in rows)
+                        {
+                            i++;
+                            <tr>
+                                <td class="num">@i</td>
+                                <td>@r.Name</td>
+                                <td><input type="number" step="any" min="0" class="form-control form-control-sm num text-center" @bind="r.Qty" /></td>
+                                <td><MoneyInput Value="r.Cost" ValueChanged="v => r.Cost = v" /></td>
+                                <td class="num">@((r.Qty * r.Cost).Money())</td>
+                            </tr>
+                        }
+                    </tbody>
+                    <tfoot>
+                        <tr>
+                            <th colspan="4" class="text-end">جمع ارزش</th>
+                            <th class="num">@rows.Where(r => r.Qty > 0).Sum(r => r.Qty * r.Cost).Money()</th>
+                        </tr>
+                    </tfoot>
+                </table>
+            </div>
+        </div>
+        <div class="d-flex justify-content-end gap-2 mt-3">
+            <button class="btn btn-primary" @onclick="SaveStock" disabled="@saving">
+                @if (saving)
+                {
+                    <span class="spinner-border spinner-border-sm ms-1"></span>
+                }
+                ذخیره موجودی اول دوره
+            </button>
+        </div>
+        <div class="small text-muted mt-2">
+            ذخیره، جایگزین اول دوره‌ی قبلی همین انبار می‌شود. فقط کالاهای با مقدار بزرگ‌تر از صفر ذخیره می‌شوند.
+        </div>
+    }
+}
+else
+{
+    <div class="card mb-3">
+        <div class="card-body d-flex flex-wrap gap-2 align-items-center">
+            <div class="btn-group">
+                <button class="btn @(partyType == PartyType.Customer ? "btn-primary" : "btn-light")" @onclick="() => SetPartyType(PartyType.Customer)">مشتریان</button>
+                <button class="btn @(partyType == PartyType.Supplier ? "btn-primary" : "btn-light")" @onclick="() => SetPartyType(PartyType.Supplier)">تأمین‌کنندگان</button>
+            </div>
+            <span class="text-muted small">بدهکار = طرف‌حساب در ابتدای دوره به شرکت بدهکار است. بستانکار = شرکت به طرف‌حساب بدهکار است.</span>
+        </div>
+    </div>
+
+    @if (busy)
+    {
+        <div class="text-center py-4"><span class="spinner-border"></span></div>
+    }
+    else
+    {
+        <div class="card">
+            <div class="table-responsive">
+                <table class="table table-sm align-middle mb-0">
+                    <thead>
+                        <tr>
+                            <th>طرف‌حساب</th>
+                            <th style="width:160px">وضعیت</th>
+                            <th style="width:200px">مبلغ (تومان)</th>
+                            <th style="width:200px">تاریخ شروع دوره</th>
+                            <th>توضیح</th>
+                            <th style="width:110px"></th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        @foreach (var p in parties)
+                        {
+                            <tr>
+                                <td>@p.Name</td>
+                                <td>
+                                    <select class="form-select form-select-sm" @bind="p.Side">
+                                        <option value="debit">بدهکار</option>
+                                        <option value="credit">بستانکار</option>
+                                    </select>
+                                </td>
+                                <td><MoneyInput Value="p.Amount" ValueChanged="v => p.Amount = v" /></td>
+                                <td><DatePicker Value="p.Date" ValueChanged="d => p.Date = d" /></td>
+                                <td><input class="form-control form-control-sm" @bind="p.Note" maxlength="500" /></td>
+                                <td class="text-end">
+                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveParty(p)" disabled="@(p.Saving)">ذخیره</button>
+                                </td>
+                            </tr>
+                        }
+                        @if (parties.Count == 0)
+                        {
+                            <tr><td colspan="6" class="text-center text-muted py-3">طرف‌حسابی برای این نوع ثبت نشده است.</td></tr>
+                        }
+                    </tbody>
+                </table>
+            </div>
+        </div>
+    }
+}
+
+@code {
+    private enum Tab { Stock, Parties }
+
+    private sealed class StockRow
+    {
+        public int ProductId { get; set; }
+        public string Name { get; set; } = "";
+        public decimal Qty { get; set; }
+        public decimal Cost { get; set; }
+    }
+
+    private sealed class PartyRow
+    {
+        public int PartyId { get; set; }
+        public string Name { get; set; } = "";
+        public string Side { get; set; } = "debit";
+        public decimal Amount { get; set; }
+        public DateTime? Date { get; set; }
+        public string? Note { get; set; }
+        public bool Saving { get; set; }
+    }
+
+    private Tab tab = Tab.Stock;
+    private bool busy, saving;
+
+    // موجودی
+    private List<LookupItem> warehouses = new();
+    private List<StockRow> rows = new();
+    private int warehouseId;
+    private DateTime? stockDate = DateTime.Today;
+
+    // طرف‌حساب
+    private PartyType partyType = PartyType.Customer;
+    private List<PartyRow> parties = new();
+
+    protected override async Task OnInitializedAsync()
+    {
+        Layout.SetTitle("اول دوره فروشگاه");
+        try
+        {
+            warehouses = (await WarehouseSvc.GetAllAsync())
+                .Select(w => new LookupItem { Id = w.Id, Name = w.Name }).ToList();
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+    }
+
+    private async Task SetTab(Tab t)
+    {
+        tab = t;
+        if (t == Tab.Parties) await LoadParties();
+    }
+
+    private async Task SetPartyType(PartyType t)
+    {
+        partyType = t;
+        await LoadParties();
+    }
+
+    private async Task WarehouseChanged(ChangeEventArgs e)
+    {
+        warehouseId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
+        await LoadStock();
+    }
+
+    private async Task LoadStock()
+    {
+        rows.Clear();
+        if (warehouseId <= 0) return;
+        busy = true;
+        try
+        {
+            var products = await ProductSvc.GetLookupsAsync();
+            var opening = await OpeningApi.GetStockAsync(warehouseId);
+            var byProduct = opening.Lines.ToDictionary(l => l.ProductId);
+            rows = products.OrderBy(p => p.Name).Select(p => new StockRow
+            {
+                ProductId = p.Id,
+                Name = p.Name,
+                Qty = byProduct.TryGetValue(p.Id, out var l) ? l.Quantity : 0,
+                Cost = byProduct.TryGetValue(p.Id, out var l2) ? l2.UnitCost : 0,
+            }).ToList();
+            if (opening.AsOfDate is not null) stockDate = opening.AsOfDate;
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+        finally { busy = false; }
+    }
+
+    private async Task SaveStock()
+    {
+        if (warehouseId <= 0) return;
+        if (stockDate is null) { Toast.Error("تاریخ شروع دوره را وارد کنید."); return; }
+        saving = true;
+        try
+        {
+            var dto = new StoreOpeningStockDto
+            {
+                WarehouseId = warehouseId,
+                AsOfDate = stockDate,
+                Lines = rows.Where(r => r.Qty > 0).Select(r => new StoreOpeningStockLineDto
+                {
+                    ProductId = r.ProductId,
+                    ProductName = r.Name,
+                    Quantity = r.Qty,
+                    UnitCost = r.Cost,
+                }).ToList(),
+            };
+            await OpeningApi.SaveStockAsync(dto);
+            Toast.Success("موجودی اول دوره فروشگاه ذخیره شد.");
+            await LoadStock();
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+        finally { saving = false; }
+    }
+
+    private async Task LoadParties()
+    {
+        busy = true;
+        try
+        {
+            var list = await OpeningApi.GetPartiesAsync(partyType);
+            parties = list.Select(p => new PartyRow
+            {
+                PartyId = p.PartyId,
+                Name = p.PartyName,
+                Side = p.Amount < 0 ? "credit" : "debit",
+                Amount = Math.Abs(p.Amount),
+                Date = p.AsOfDate,
+                Note = p.Note,
+            }).ToList();
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+        finally { busy = false; }
+    }
+
+    private async Task SaveParty(PartyRow p)
+    {
+        if (p.Date is null)
+        {
+            Toast.Error($"برای «{p.Name}» تاریخ شروع دوره را وارد کنید.");
+            return;
+        }
+        p.Saving = true;
+        try
+        {
+            var signed = p.Side == "credit" ? -Math.Abs(p.Amount) : Math.Abs(p.Amount);
+            await OpeningApi.SavePartyAsync(p.PartyId, new StoreOpeningPartyDto
+            {
+                PartyId = p.PartyId,
+                AsOfDate = p.Date,
+                Amount = signed,
+                Note = string.IsNullOrWhiteSpace(p.Note) ? null : p.Note.Trim(),
+            });
+            Toast.Success($"مانده «{p.Name}» ذخیره شد.");
+        }
+        catch (Exception ex) { Toast.Error(ex.Message); }
+        finally { p.Saving = false; }
+    }
+}
