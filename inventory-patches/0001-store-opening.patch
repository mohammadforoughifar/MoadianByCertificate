@@ -0,0 +1,33 @@
+using Inventory.Shared;
+using Inventory.Shared.Dtos;
+
+namespace Inventory.Client.Services;
+
+/// <summary>سرویس HTTP ماژول «اول دوره فروشگاه» (جدا از سرویس‌های ERP).</summary>
+public interface IStoreOpeningApi
+{
+    Task<StoreOpeningStockDto> GetStockAsync(int warehouseId);
+    Task<StoreOpeningStockDto> SaveStockAsync(StoreOpeningStockDto dto);
+    Task<List<StoreOpeningPartyDto>> GetPartiesAsync(PartyType? type);
+    Task<StoreOpeningPartyDto> SavePartyAsync(int partyId, StoreOpeningPartyDto dto);
+}
+
+public class StoreOpeningApiService : IStoreOpeningApi
+{
+    private readonly IApiClient _api;
+    public StoreOpeningApiService(IApiClient api) => _api = api;
+
+    public Task<StoreOpeningStockDto> GetStockAsync(int warehouseId)
+        => _api.GetAsync<StoreOpeningStockDto>($"api/store-opening/stock?warehouseId={warehouseId}");
+
+    public Task<StoreOpeningStockDto> SaveStockAsync(StoreOpeningStockDto dto)
+        => _api.PutAsync<StoreOpeningStockDto>("api/store-opening/stock", dto);
+
+    public Task<List<StoreOpeningPartyDto>> GetPartiesAsync(PartyType? type)
+        => _api.GetAsync<List<StoreOpeningPartyDto>>(type is null
+            ? "api/store-opening/parties"
+            : $"api/store-opening/parties?type={(int)type.Value}");
+
+    public Task<StoreOpeningPartyDto> SavePartyAsync(int partyId, StoreOpeningPartyDto dto)
+        => _api.PutAsync<StoreOpeningPartyDto>($"api/store-opening/parties/{partyId}", dto);
+}
