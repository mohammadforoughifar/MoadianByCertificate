+}
+
+/// <summary>اول دوره‌ی موجودی یک انبار (جایگزین کامل سطرهای همان انبار)</summary>
+public class StoreOpeningStockDto
+{
+    public int WarehouseId { get; set; }
+    public DateTime? AsOfDate { get; set; }
+    public List<StoreOpeningStockLineDto> Lines { get; set; } = new();
+}
+
+/// <summary>مانده اول دوره‌ی یک طرف‌حساب فروشگاه (مثبت = بدهکار، منفی = بستانکار)</summary>
+public class StoreOpeningPartyDto
+{
+    public int PartyId { get; set; }
+    public string PartyName { get; set; } = "";
+    public PartyType Type { get; set; }
+    public DateTime? AsOfDate { get; set; }
+    public decimal Amount { get; set; }
+    public string? Note { get; set; }
+    public string? UpdatedBy { get; set; }
+    public DateTime? UpdatedAt { get; set; }
+}
