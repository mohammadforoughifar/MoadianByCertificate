+/// <summary>سرویس «اول دوره فروشگاه» — فقط جدول‌های StoreOpening* را می‌نویسد؛
+/// بازمحاسبه‌ی موجودی فروشگاه از طریق IInventoryService انجام می‌شود.</summary>
+public interface IStoreOpeningService
+{
+    Task<StoreOpeningStockDto> GetStockAsync(int warehouseId);
+    Task<StoreOpeningStockDto> SaveStockAsync(StoreOpeningStockDto dto, string? user);
+    Task<List<StoreOpeningPartyDto>> GetPartiesAsync(PartyType? type);
+    Task<StoreOpeningPartyDto> SavePartyAsync(int partyId, StoreOpeningPartyDto dto, string? user);
+}
+
+public class StoreOpeningService : IStoreOpeningService
+{
+    private readonly Db.AppDbContext _db;
+    private readonly IInventoryService _inventory;
+
+    public StoreOpeningService(Db.AppDbContext db, IInventoryService inventory)
+    {
+        _db = db;
+        _inventory = inventory;
+    }
+
+    public async Task<StoreOpeningStockDto> GetStockAsync(int warehouseId)
+    {
+        var lines = await (from o in _db.StoreOpeningStocks.AsNoTracking()
+                           join p in _db.Products.AsNoTracking() on o.ProductId equals p.Id
+                           where o.WarehouseId == warehouseId
+                           orderby p.Name
+                           select new StoreOpeningStockLineDto
+                           {
+                               ProductId = p.Id,
+                               ProductName = p.Name,
+                               Quantity = o.Quantity,
+                               UnitCost = o.UnitCost,
+                           }).ToListAsync();
+
+        var asOf = await _db.StoreOpeningStocks.AsNoTracking()
+            .Where(o => o.WarehouseId == warehouseId)
+            .Select(o => (DateTime?)o.AsOfDate)
+            .FirstOrDefaultAsync();
+
+        return new StoreOpeningStockDto { WarehouseId = warehouseId, AsOfDate = asOf, Lines = lines };
+    }
+
+    public async Task<StoreOpeningStockDto> SaveStockAsync(StoreOpeningStockDto dto, string? user)
+    {
+        if (dto.WarehouseId <= 0 || !await _db.Warehouses.AnyAsync(w => w.Id == dto.WarehouseId))
+            throw new InvalidOperationException("انبار معتبر نیست.");
+        if (dto.AsOfDate is null)
+            throw new InvalidOperationException("تاریخ شروع دوره را وارد کنید.");
+
+        var lines = dto.Lines.Where(l => l.Quantity > 0).ToList();
+        if (lines.Select(l => l.ProductId).Distinct().Count() != lines.Count)
+            throw new InvalidOperationException("یک کالا بیش از یک بار وارد شده است.");
+        if (lines.Any(l => l.UnitCost <= 0))
+            throw new InvalidOperationException("برای هر کالای دارای مقدار، بهای واحد بزرگ‌تر از صفر لازم است.");
+        if (lines.Any(l => l.Quantity != decimal.Round(l.Quantity, 2)))
+            throw new InvalidOperationException("مقدار هر کالا حداکثر تا دو رقم اعشار قابل ثبت است.");
+
+        var productIds = lines.Select(l => l.ProductId).ToList();
+        var validCount = productIds.Count == 0 ? 0 : await _db.Products
+            .CountAsync(p => productIds.Contains(p.Id) && !p.IsService);
+        if (validCount != productIds.Count)
+            throw new InvalidOperationException("یکی از کالاها معتبر نیست یا خدماتی است.");
+
+        var existing = await _db.StoreOpeningStocks.Where(o => o.WarehouseId == dto.WarehouseId).ToListAsync();
+        var affected = existing.Select(o => o.ProductId).Union(productIds).Distinct().ToList();
+        var date = dto.AsOfDate.Value.Date;
+        var now = DateTime.Now;
+
+        await using var trx = await _db.Database.BeginTransactionAsync();
+        _db.StoreOpeningStocks.RemoveRange(existing);
+        await _db.SaveChangesAsync();
+
+        foreach (var l in lines)
+        {
+            _db.StoreOpeningStocks.Add(new Db.StoreOpeningStock
+            {
+                WarehouseId = dto.WarehouseId,
+                ProductId = l.ProductId,
+                AsOfDate = date,
+                Quantity = l.Quantity,
+                UnitCost = decimal.Round(l.UnitCost, 2),
+                UpdatedBy = user,
+                UpdatedAt = now,
+            });
+        }
+        await _db.SaveChangesAsync();
+
+        foreach (var pid in affected)
+            await _inventory.RebuildStockAsync(dto.WarehouseId, pid);
+
+        await _db.SaveChangesAsync();
+        await trx.CommitAsync();
+
+        return await GetStockAsync(dto.WarehouseId);
+    }
+
+    public async Task<List<StoreOpeningPartyDto>> GetPartiesAsync(PartyType? type)
+    {
+        var parties = _db.Parties.AsNoTracking()
+            .Where(p => type == null || p.Type == type.Value);
+
+        return await (from p in parties
+                      join o in _db.StoreOpeningParties.AsNoTracking() on p.Id equals o.PartyId into opening
+                      from o in opening.DefaultIfEmpty()
+                      orderby p.Name
+                      select new StoreOpeningPartyDto
+                      {
+                          PartyId = p.Id,
+                          PartyName = p.Name,
+                          Type = p.Type,
+                          AsOfDate = o == null ? null : o.AsOfDate,
+                          Amount = o == null ? 0 : o.Amount,
+                          Note = o == null ? null : o.Note,
+                          UpdatedBy = o == null ? null : o.UpdatedBy,
+                          UpdatedAt = o == null ? null : o.UpdatedAt,
+                      }).ToListAsync();
+    }
+
+    public async Task<StoreOpeningPartyDto> SavePartyAsync(int partyId, StoreOpeningPartyDto dto, string? user)
+    {
+        if (!await _db.Parties.AnyAsync(p => p.Id == partyId))
+            throw new InvalidOperationException("طرف حساب یافت نشد.");
+        if (dto.AsOfDate is null)
+            throw new InvalidOperationException("تاریخ شروع دوره را وارد کنید.");
+
+        var entity = await _db.StoreOpeningParties.FirstOrDefaultAsync(x => x.PartyId == partyId);
+        if (entity is null)
+        {
+            entity = new Db.StoreOpeningParty { PartyId = partyId };
+            _db.StoreOpeningParties.Add(entity);
+        }
+        entity.AsOfDate = dto.AsOfDate.Value.Date;
+        entity.Amount = decimal.Round(dto.Amount, 2);
+        entity.Note = string.IsNullOrWhiteSpace(dto.Note) ? null : dto.Note.Trim();
+        entity.UpdatedBy = user;
+        entity.UpdatedAt = DateTime.Now;
+        await _db.SaveChangesAsync();
+
+        return (await GetPartiesAsync(null)).First(x => x.PartyId == partyId);
+    }
+}
