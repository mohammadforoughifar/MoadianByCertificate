+using System.ComponentModel.DataAnnotations;
+namespace Inventory.Api.Data;
+
+// ============================================================
+//  ماژول «اول دوره فروشگاه» — جدول‌های مستقل از انبارداری (ERP)
+//  هیچ ارتباطی با InvDocs / InvStocks / InvLedger ندارد.
+// ============================================================
+
+/// <summary>
+/// موجودی اول دوره‌ی فروشگاه به تفکیک شرکت، انبار و کالا.
+/// مبنای محاسبه‌ی موجودی فروشگاه (Stocks) است: بازمحاسبه از این مقدار شروع می‌شود.
+/// </summary>
+public class StoreOpeningStock : ICompanyOwned
+{
+    public int Id { get; set; }
+    public int? CompanyId { get; set; }
+    public int WarehouseId { get; set; }
+    public int ProductId { get; set; }
+
+    /// <summary>تاریخ شروع دوره.</summary>
+    public DateTime AsOfDate { get; set; }
+
+    /// <summary>مقدار اول دوره.</summary>
+    public decimal Quantity { get; set; }
+
+    /// <summary>بهای واحد اول دوره.</summary>
+    public decimal UnitCost { get; set; }
+
+    [MaxLength(500)]
+    public string? Note { get; set; }
+
+    [MaxLength(80)]
+    public string? UpdatedBy { get; set; }
+
+    public DateTime UpdatedAt { get; set; } = DateTime.Now;
+}
+
+/// <summary>
+/// مانده اول دوره‌ی طرف‌حساب فروشگاه (مثبت = بدهکار، منفی = بستانکار).
+/// جداست از سوابق سند فروشگاه (Transactions) و به مانده‌ی طرف‌حساب اضافه می‌شود.
+/// </summary>
+public class StoreOpeningParty : ICompanyOwned
+{
+    public int Id { get; set; }
+    public int? CompanyId { get; set; }
+    public int PartyId { get; set; }
+    public DateTime AsOfDate { get; set; }
+    public decimal Amount { get; set; }
+
+    [MaxLength(500)]
+    public string? Note { get; set; }
+
+    [MaxLength(80)]
+    public string? UpdatedBy { get; set; }
+
+    public DateTime UpdatedAt { get; set; } = DateTime.Now;
+}
