@@ -0,0 +1,94 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace Inventory.Api.Data;
+
+// خودتعمیرِ جدول‌های «اول دوره فروشگاه» (idempotent برای SQLite و SQL Server)
+public static class StoreOpeningSchemaV1
+{
+    public static Task EnsureAsync(AppDbContext db) =>
+        db.Database.IsSqlite() ? EnsureSqliteAsync(db) : EnsureSqlServerAsync(db);
+
+    private static async Task EnsureSqlServerAsync(AppDbContext db)
+    {
+        await SafeAsync(db, @"
+IF OBJECT_ID(N'dbo.StoreOpeningStocks', N'U') IS NULL
+CREATE TABLE dbo.StoreOpeningStocks (
+    Id          int IDENTITY(1,1) NOT NULL CONSTRAINT PK_StoreOpeningStocks PRIMARY KEY,
+    CompanyId   int NULL,
+    WarehouseId int NOT NULL,
+    ProductId   int NOT NULL,
+    AsOfDate    datetime2 NOT NULL,
+    Quantity    decimal(18,2) NOT NULL CONSTRAINT DF_StoreOpeningStocks_Qty DEFAULT(0),
+    UnitCost    decimal(18,2) NOT NULL CONSTRAINT DF_StoreOpeningStocks_Cost DEFAULT(0),
+    Note        nvarchar(500) NULL,
+    UpdatedBy   nvarchar(80) NULL,
+    UpdatedAt   datetime2 NOT NULL CONSTRAINT DF_StoreOpeningStocks_UpdatedAt DEFAULT(GETDATE())
+);");
+        await SafeAsync(db, @"
+IF OBJECT_ID(N'dbo.StoreOpeningStocks', N'U') IS NOT NULL
+   AND NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'IX_StoreOpeningStocks_Company_Wh_Product')
+CREATE UNIQUE INDEX IX_StoreOpeningStocks_Company_Wh_Product ON dbo.StoreOpeningStocks (CompanyId, WarehouseId, ProductId);");
+
+        await SafeAsync(db, @"
+IF OBJECT_ID(N'dbo.StoreOpeningParties', N'U') IS NULL
+CREATE TABLE dbo.StoreOpeningParties (
+    Id          int IDENTITY(1,1) NOT NULL CONSTRAINT PK_StoreOpeningParties PRIMARY KEY,
+    CompanyId   int NULL,
+    PartyId     int NOT NULL,
+    AsOfDate    datetime2 NOT NULL,
+    Amount      decimal(18,2) NOT NULL CONSTRAINT DF_StoreOpeningParties_Amount DEFAULT(0),
+    Note        nvarchar(500) NULL,
+    UpdatedBy   nvarchar(80) NULL,
+    UpdatedAt   datetime2 NOT NULL CONSTRAINT DF_StoreOpeningParties_UpdatedAt DEFAULT(GETDATE())
+);");
+        await SafeAsync(db, @"
+IF OBJECT_ID(N'dbo.StoreOpeningParties', N'U') IS NOT NULL
+   AND NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'IX_StoreOpeningParties_Company_Party')
+CREATE UNIQUE INDEX IX_StoreOpeningParties_Company_Party ON dbo.StoreOpeningParties (CompanyId, PartyId);");
+    }
+
+    private static async Task EnsureSqliteAsync(AppDbContext db)
+    {
+        await SafeAsync(db, @"
+CREATE TABLE IF NOT EXISTS StoreOpeningStocks (
+    Id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    CompanyId   INTEGER NULL,
+    WarehouseId INTEGER NOT NULL,
+    ProductId   INTEGER NOT NULL,
+    AsOfDate    TEXT NOT NULL,
+    Quantity    TEXT NOT NULL DEFAULT '0',
+    UnitCost    TEXT NOT NULL DEFAULT '0',
+    Note        TEXT NULL,
+    UpdatedBy   TEXT NULL,
+    UpdatedAt   TEXT NOT NULL
+);");
+        await SafeAsync(db,
+            "CREATE UNIQUE INDEX IF NOT EXISTS IX_StoreOpeningStocks_Company_Wh_Product ON StoreOpeningStocks (CompanyId, WarehouseId, ProductId);");
+
+        await SafeAsync(db, @"
+CREATE TABLE IF NOT EXISTS StoreOpeningParties (
+    Id        INTEGER PRIMARY KEY AUTOINCREMENT,
+    CompanyId INTEGER NULL,
+    PartyId   INTEGER NOT NULL,
+    AsOfDate  TEXT NOT NULL,
+    Amount    TEXT NOT NULL DEFAULT '0',
+    Note      TEXT NULL,
+    UpdatedBy TEXT NULL,
+    UpdatedAt TEXT NOT NULL
+);");
+        await SafeAsync(db,
+            "CREATE UNIQUE INDEX IF NOT EXISTS IX_StoreOpeningParties_Company_Party ON StoreOpeningParties (CompanyId, PartyId);");
+    }
+
+    private static async Task SafeAsync(AppDbContext db, string sql)
+    {
+        try { await db.Database.ExecuteSqlRawAsync(sql); }
+        catch (Exception ex)
+        {
+            var m = ex.Message ?? "";
+            if (!m.Contains("duplicate", StringComparison.OrdinalIgnoreCase) &&
+                !m.Contains("already exists", StringComparison.OrdinalIgnoreCase))
+                Console.WriteLine($"[DB] StoreOpeningSchemaV1: {m}");
+        }
+    }
+}
