<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Inventory.Api</RootNamespace>
    <AssemblyName>TotallSoftwareForoughAriya.Api</AssemblyName>
    <!-- Deployment size: retain Persian and English satellite resources; other third-party cultures fall back to English. -->
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- کاهش حجم پابلیش: بدون فایل دیباگ (pdb) در خروجی Release -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <NoWarn>CS1998;NU1900;NU1902;NU1903;NU1904;CS0162</NoWarn>
    <!-- کاهش حجم خروجی انتشار: باندل تک‌فایل فشرده (فقط روی publish اثر دارد) -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- IIS in-process hosting cannot load single-file apps. -->
    <AspNetCoreHostingModel Condition="'$(PublishSingleFile)' == 'true'">OutOfProcess</AspNetCoreHostingModel>
    <!-- .NET 8 allows bundle compression only for self-contained publish.
         Keep the existing framework-dependent IIS deployment valid. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TotallSoftwareForoughAriya.Shared/TotallSoftwareForoughAriya.Shared.csproj">
      <Name>TotallSoftwareForoughAriya.Shared</Name>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>false</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Maintenance command travels with every publish, including Visual Studio/IIS publishes. -->
    <Content Include="../../update-database.bat" Link="update-database.bat"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <!-- فونت‌های فارسی برای PDF شناسنامه سیستم -->
    <Content Include="Resources/fonts/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- قالب‌های MRT و تصویر امضای آزمایشی برای رندر سروری گزارش. -->
    <Content Include="Reports/**/*.mrt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources/reports/**/*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- سربرگ شرکت آریا باید در خروجی لوکال و Publish نیز حتماً کپی شود. -->
    <Content Update="wwwroot/uploads/letterheads/aria_company1005_letterhead.pdf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <!-- همهٔ سربرگ‌های ثبت‌شدهٔ شرکت‌ها (هومپا/آریا/فوروث) باید با Publish منتشر شوند؛
         اگر فایل سربرگ روی سرور غایب باشد، چاپ نامه صادره از طرح داخل قالب MRT شرکت
         استفاده می‌کند اما این فایل‌ها هم باید برای مسیر «فایل ثبت‌شده» موجود باشند. -->
    <Content Update="wwwroot/uploads/letterheads/**/*"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- appsettings.Development فقط برای توسعه است؛ در انتشار منتشر نشود -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- ایمیل سازمانی: ارسال SMTP و دریافت IMAP (Gmail/Yahoo/وب‌میل/…) -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <!-- موتور سروری Stimulsoft: بارگذاری MRT و خروجی PDF؛ Viewer سمت Blazor لازم نیست. -->
    <PackageReference Include="Stimulsoft.Reports.Engine.NetCore" Version="2026.2.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.8.0" />
    <!-- قالب‌های قدیمی متغیرهای امضا را از نوع System.Drawing.Image تعریف کرده‌اند؛ سرور نهایی Windows است. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- PDFsharp برای قرار دادن متن نامه صادره روی سربرگ PDF شرکت (چاپ A4/A5) -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.8" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="7.3.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="TaxCollectData.Library" Version="2.0.29" /> <!-- از فید محلی packages (SDK رسمی گواهی امضا 2.0.29) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.1" />
    <!-- رفع تعارض نسخه: Stimulsoft به CodeAnalysis &gt;= 4.8 نیاز دارد و EF.Design 8.0.1 روی 4.5 پین است (NU1107) -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <!-- QR برای چاپ آرشیو اسناد -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- پایش SNMP ماشین‌های اداری (فقط‌خواندنی، v1/v2c/v3) — لایسنس MIT -->
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="App_Data/**;wwwroot/uploads/projects/.key;wwwroot/SecureFiles/.key" />
    <None Remove="App_Data/**;wwwroot/uploads/projects/.key;wwwroot/SecureFiles/.key" />
  </ItemGroup>

  <!-- حذف فونت Lato از خروجی انتشار: برنامه فقط از وزیرمتن استفاده می‌کند (۱۲ مگ صرفه‌جویی) -->
  <Target Name="RemoveLatoFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('LatoFont'))" />
    </ItemGroup>
  </Target>

</Project>
