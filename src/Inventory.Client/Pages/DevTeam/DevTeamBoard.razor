    private void OnColDragOver() { /* allow drop */ }
    private void OnColDragEnter(int statusId) => dragOverStatusId = statusId;
    private void OnColDragLeave() { /* keep highlight until drop/end */ }
    private async Task OnColDrop(int statusId)
    {
        if (dragTaskId is not int tid || !access.CanUpdate) return;
        var task = boardTasks.FirstOrDefault(x => x.Id == tid);
        dragOverStatusId = null;
        var movingId = tid;
        dragTaskId = null;
        if (task is null) return;
        // drop on empty column / end → beforeTaskId null
        if (task.StatusId == statusId) return; // same col empty area — no-op without target
        await MoveTask(movingId, statusId, null);
    }
    private void OnCardDragOver() { }
    private async Task OnCardDropOn(DtTaskListItemDto target)
    {
        if (dragTaskId is not int tid || !access.CanUpdate) return;
        if (tid == target.Id) return;
        var moving = boardTasks.FirstOrDefault(x => x.Id == tid);
        dragTaskId = null;
        dragOverStatusId = null;
        if (moving is null) return;
        await MoveTask(tid, target.StatusId, target.Id);
    }

    private void OnSubDragStart(int id) { if (access.CanUpdate) subDragId = id; }
    private void OnSubDragEnd() => subDragId = null;
    private async Task OnSubDrop(int targetId)
    {
        if (subDragId is not int sid || taskDetail is null || !access.CanUpdate) return;
        if (sid == targetId) { subDragId = null; return; }
        var list = taskDetail.SubTasks.OrderBy(x => x.SortOrder).ThenBy(x => x.Id).Select(x => x.Id).ToList();
        if (!list.Contains(sid) || !list.Contains(targetId)) { subDragId = null; return; }
        list.Remove(sid);
        var idx = list.IndexOf(targetId);
        list.Insert(idx, sid);
        subDragId = null;
        try
        {
            await Api.ReorderSubTasksAsync(taskDetail.Id, list);
            taskDetail = await Api.GetTaskAsync(taskDetail.Id);
            Toast.Success("ترتیب ساب‌تسک ذخیره شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

