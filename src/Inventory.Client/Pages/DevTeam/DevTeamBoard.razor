    private void OnCheckDragStart(int id) { if (access.CanUpdate) checkDragId = id; }
    private void OnCheckDragEnd() => checkDragId = null;
    private async Task OnCheckDrop(int targetId)
    {
        if (checkDragId is not int sid || taskDetail is null || !access.CanUpdate) return;
        if (sid == targetId) { checkDragId = null; return; }
        var list = taskDetail.Checklist.OrderBy(x => x.SortOrder).ThenBy(x => x.Id).Select(x => x.Id).ToList();
        if (!list.Contains(sid) || !list.Contains(targetId)) { checkDragId = null; return; }
        list.Remove(sid);
        list.Insert(list.IndexOf(targetId), sid);
        checkDragId = null;
        try
        {
            await Api.ReorderChecklistAsync(taskDetail.Id, list);
            taskDetail = await Api.GetTaskAsync(taskDetail.Id);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

