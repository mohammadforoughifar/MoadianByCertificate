    /// <summary>ثبت سریع تسک با یک عنوان — بدون باز کردن مودال.</summary>
    private async Task QuickAddTask(int? forceStatusId = null)
    {
        var title = (quickTitle ?? "").Trim();
        if (title.Length == 0) { Toast.Error("عنوان تسک را بنویسید."); return; }
        if (!lookups.Statuses.Any(x => x.IsActive)) { Toast.Error("ابتدا ستون‌ها را بسازید."); return; }

        quickSaving = true;
        try
        {
            int? statusId = forceStatusId
                ?? lookups.Statuses.FirstOrDefault(x => x.IsInitial)?.Id
                ?? lookups.Statuses.FirstOrDefault()?.Id;

            var dto = new DtTaskUpsertDto
            {
                Title = title,
                Type = string.IsNullOrWhiteSpace(quickType) ? "Feature" : quickType,
                Priority = quickPriority,
                StatusId = statusId,
                AssigneeUserId = quickAssigneeId > 0 ? quickAssigneeId : null,
                ModuleId = fltModuleId > 0 ? fltModuleId : null,
                SprintId = fltSprintId > 0 ? fltSprintId : null
            };
            await Api.CreateTaskAsync(dto);
            quickTitle = "";
            Toast.Success("تسک ثبت شد ✅");
            await LoadTabData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { quickSaving = false; }
    }

    /// <summary>دکمهٔ + روی سرِ ستون: ثبت سریع در همان ستون.</summary>
    private Task QuickAddTo(int statusId) => QuickAddTask(statusId);

    /// <summary>قالب آمادهٔ ستون‌های برد برای شروع سریع.</summary>
    private async Task ApplyDefaultStatuses()
    {
        setupSaving = true;
        try
        {
            var existing = new HashSet<string>(
                allStatuses.Select(x => x.Key), StringComparer.OrdinalIgnoreCase);
            var order = allStatuses.Count == 0 ? 0 : allStatuses.Max(x => x.SortOrder) + 10;

            foreach (var (key, name, color, isInit, isDone, isBlocked) in DefaultStatuses)
            {
                if (existing.Contains(key)) continue;
                var dto = new DtWorkflowStatusDto
                {
                    Key = key, NameFa = name, Color = color, SortOrder = order,
                    IsInitial = isInit, IsDone = isDone, IsBlocked = isBlocked, IsActive = true
                };
                await Api.UpsertStatusAsync(dto);
                order += 10;
            }
            Toast.Success("ستون‌های آماده ساخته شد.");
            await BootstrapAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { setupSaving = false; }
    }

    /// <summary>ستون‌های آماده را بساز و مستقیم برو به ثبت اولین تسک.</summary>
    private async Task ApplyDefaultStatusesThenNew()
    {
        await ApplyDefaultStatuses();
        OpenNewTask();
    }

    /// <summary>ستون‌های پیش‌فرض برد: بک‌لاگ ← در انجام ← بازبینی ← انجام‌شده.</summary>
    private static readonly (string key, string name, string color, bool isInit, bool isDone, bool isBlocked)[] DefaultStatuses =
    {
        ("backlog",  "بک‌لاگ",        "#94a3b8", true,  false, false),
        ("doing",    "در حال انجام", "#4f46e5", false, false, false),
        ("review",   "بازبینی",          "#f59e0b", false, false, false),
        ("blocked",  "مسدود",             "#ef4444", false, false, true),
        ("done",     "انجام‌شده",       "#10b981", false, true,  false),
    };
