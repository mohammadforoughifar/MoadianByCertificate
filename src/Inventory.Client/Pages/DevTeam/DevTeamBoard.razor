    protected override async Task OnInitializedAsync()
    {
        suppressUrlWrite = true;
        try { ApplyQueryFromUri(Nav.ToAbsoluteUri(Nav.Uri)); }
        finally { suppressUrlWrite = false; }

        var openId = PeekOpenId(Nav.ToAbsoluteUri(Nav.Uri));
        await BootstrapAsync();
        if (openId > 0) await OpenTask(openId);
        await RefreshGlobalTimerAsync();
        WriteUrl(replace: true);
    }

    private static int PeekOpenId(Uri uri)
    {
        var query = uri.Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            if (key != "open") continue;
            var val = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
            return int.TryParse(val, out var id) ? id : 0;
        }
        return 0;
    }

    private void ApplyQueryFromUri(Uri uri)
    {
        var query = uri.Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var val = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
            switch (key)
            {
                case "tab" when TabDefs.Any(x => x.key == val): tab = val; break;
                case "q": fltQ = val; break;
                case "module": int.TryParse(val, out fltModuleId); break;
                case "sprint": int.TryParse(val, out fltSprintId); break;
                case "assignee": int.TryParse(val, out fltAssigneeId); break;
                case "type": fltType = val; break;
                case "mine": onlyMine = val is "1" or "true" or "yes"; break;
                case "probSev": probSeverity = val; break;
                case "probSt": probStatus = val; break;
                case "probMod": int.TryParse(val, out probModuleId); break;
                case "chgMod": int.TryParse(val, out chgModuleId); break;
                case "bdSprint": int.TryParse(val, out burndownSprintId); break;
            }
        }
    }

    private void WriteUrl(bool replace = true)
    {
        if (suppressUrlWrite) return;
        var parts = new List<string>();
        if (tab != "board") parts.Add($"tab={Uri.EscapeDataString(tab)}");
        if (!string.IsNullOrWhiteSpace(fltQ)) parts.Add($"q={Uri.EscapeDataString(fltQ.Trim())}");
        if (fltModuleId > 0) parts.Add($"module={fltModuleId}");
        if (fltSprintId > 0) parts.Add($"sprint={fltSprintId}");
        if (fltAssigneeId > 0) parts.Add($"assignee={fltAssigneeId}");
        if (!string.IsNullOrWhiteSpace(fltType)) parts.Add($"type={Uri.EscapeDataString(fltType)}");
        if (onlyMine) parts.Add("mine=1");
        if (tab == "problems")
        {
            if (!string.IsNullOrWhiteSpace(probSeverity)) parts.Add($"probSev={Uri.EscapeDataString(probSeverity)}");
            if (!string.IsNullOrWhiteSpace(probStatus)) parts.Add($"probSt={Uri.EscapeDataString(probStatus)}");
            if (probModuleId > 0) parts.Add($"probMod={probModuleId}");
        }
        if (tab == "modules" && chgModuleId > 0) parts.Add($"chgMod={chgModuleId}");
        if (tab == "burndown" && burndownSprintId > 0) parts.Add($"bdSprint={burndownSprintId}");
        if (showTaskModal && editingTaskId is int oid && oid > 0) parts.Add($"open={oid}");

        var qs = parts.Count == 0 ? "" : "?" + string.Join("&", parts);
        var target = "/dev-team" + qs;
        var cur = Nav.ToBaseRelativePath(Nav.Uri);
        if (!cur.StartsWith('/')) cur = "/" + cur;
        // strip trailing slash noise
        if (string.Equals(cur, target, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(cur, target.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
            return;
        try { Nav.NavigateTo(target, forceLoad: false, replace: replace); }
        catch { /* navigation during dispose */ }
    }

