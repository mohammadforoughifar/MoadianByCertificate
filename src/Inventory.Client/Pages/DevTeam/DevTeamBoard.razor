    private static string FormatElapsed(int totalSec)
    {
        if (totalSec < 0) totalSec = 0;
        var h = totalSec / 3600;
        var m = (totalSec % 3600) / 60;
        var s = totalSec % 60;
        return h > 0 ? $"{h:00}:{m:00}:{s:00}" : $"{m:00}:{s:00}";
    }

    private void EnsureTimerClock()
    {
        timerUiClock ??= new System.Threading.Timer(async _ =>
        {
            var changed = false;
            if (taskDetail?.TimerRunning == true && taskDetail.TimerStartedAt is DateTime started)
            {
                timerDisplaySeconds = (int)Math.Max(0, (DateTime.Now - started).TotalSeconds);
                changed = true;
            }
            if (globalTimer is { Running: true, StartedAt: DateTime gs })
            {
                globalTimerSeconds = (int)Math.Max(0, (DateTime.Now - gs).TotalSeconds);
                changed = true;
            }
            if (changed)
            {
                try { await InvokeAsync(StateHasChanged); } catch { }
            }
        }, null, 0, 1000);
    }

    private async Task RefreshGlobalTimerAsync()
    {
        try
        {
            globalTimer = await Api.GetMyTimerAsync();
            if (globalTimer is { Running: true, StartedAt: DateTime gs })
            {
                globalTimerSeconds = globalTimer.ElapsedSeconds > 0
                    ? globalTimer.ElapsedSeconds
                    : (int)Math.Max(0, (DateTime.Now - gs).TotalSeconds);
                EnsureTimerClock();
            }
            else
            {
                globalTimer = null;
                globalTimerSeconds = 0;
            }
        }
        catch { /* non-fatal */ }
    }

    private async Task StopGlobalTimer()
    {
        if (globalTimer is not { TaskId: > 0 }) return;
        saving = true;
        try
        {
            var st = await Api.StopTimerAsync(globalTimer.TaskId);
            globalTimer = null;
            globalTimerSeconds = 0;
            if (editingTaskId == st.TaskId || (taskDetail?.Id == st.TaskId))
                taskDetail = await Api.GetTaskAsync(st.TaskId);
            Toast.Success(st.LastEntry is not null ? $"ثبت شد: {st.LastEntry.Hours} ساعت" : "تایمر متوقف شد");
            await LoadTabData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

