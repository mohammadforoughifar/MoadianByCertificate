@inject IAuthState Auth
@inject IOrderService OrderSvc
@inject IWarehouseService WarehouseSvc
@inject IPartyService PartySvc
@inject IProductService ProductSvc
@inject IStockService StockSvc
@inject IReferrerService ReferrerSvc
@inject ITrsAccountService AccountSvc
@inject IToastService Toast
@inject ICompanyProfileService ProfileSvc
@inject IJSRuntime JS
@using Inventory.Client.Pages.Orders

<Modal Visible="true" Title="@FormTitle" Size="modal-xl" OnClose="Cancel">

    <ChildContent>
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else
        {
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">انبار <span class="text-danger">*</span></label>
                    <SearchSelect Items="whLookup" Value="warehouseId" ValueChanged="OnWarehouseChanged" Placeholder="انتخاب انبار…" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">@(Type == TransactionType.Sale ? "مشتری" : "تأمین‌کننده") <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold" @onclick="() => showNewPartyModal = true">
                            <i class="bi bi-plus-circle-fill text-success"></i> @(Type == TransactionType.Sale ? "مشتری جدید" : "تأمین‌کننده جدید")
                        </button>
                    </div>
                    <SearchSelect Items="partyLookup" Value="partyId" ValueChanged="OnPartyChanged" Placeholder="انتخاب طرف حساب…" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">تاریخ سند <span class="text-danger">*</span></label>
                    <DatePicker @bind-Value="date" />
                </div>
                <div class="col-12">
                    <label class="form-label">توضیحات</label>
                    <input class="form-control" @bind="description" placeholder="اختیاری" />
                </div>
                @if (Type == TransactionType.Sale && referrerId > 0)
                {
                    <div class="col-12">
                        <div class="alert alert-info fs-8 py-2 mb-0">
                            <i class="bi bi-person-badge ms-1"></i>
                            معرف این مشتری: <b>@(referrers.FirstOrDefault(r => r.Id == referrerId)?.Name)</b>
                        </div>
                    </div>
                }

                @if (Type is TransactionType.Sale or TransactionType.Purchase)
                {
                    <div class="col-12">
                        <div class="pay-box">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="fw-700"><i class="bi bi-credit-card-2-front text-primary ms-1"></i>روش پرداخت (ترکیبی)</span>
                                <span class="fs-8 text-muted">
                                    می‌توانید چند جزء را هم‌زمان فعال کنید (نقد + چک + اقساط + نسیه)؛
                                    باقی‌ماندهٔ هر سطر بر اساس سطرهای قبلی و مبلغ نقدی محاسبه می‌شود.
                                </span>
                            </div>
                            <div class="pay-tabs">
                                <button type="button" class="pay-tab @(useCash ? "active" : "")" data-pay-comp="cash" @onclick="ToggleCash">
                                    <i class="bi bi-cash-coin"></i> نقدی
                                </button>
                                <button type="button" class="pay-tab @(useCheque ? "active" : "")" data-pay-comp="cheque" @onclick="ToggleCheque">
                                    <i class="bi bi-bank"></i> چک
                                </button>
                                <button type="button" class="pay-tab @(useInstallment ? "active" : "")" data-pay-comp="installment" @onclick="ToggleInstallment">
                                    <i class="bi bi-journal-check"></i> اقساطی
                                </button>
                                <button type="button" class="pay-tab @(useCredit ? "active" : "")" data-pay-comp="credit" @onclick="ToggleCredit">
                                    <i class="bi bi-hourglass-split"></i> نسیه
                                </button>
                            </div>

                            @* ---------- نوار خلاصهٔ پرداخت: هر جزء و باقی‌ماندهٔ نهایی ---------- *@
                            <div class="pay-summary mt-3" data-pay-summary>
                                <div>مبلغ @(Type == TransactionType.Sale ? "فاکتور" : "سند"): <b class="num text-primary" data-pay-total>@grandTotal.Money()</b> ریال</div>
                                <div>نقد: <b class="num text-success" data-pay-cash>@CashPart.Money()</b></div>
                                <div>چک: <b class="num" data-pay-cheques>@ChequeSum().Money()</b></div>
                                <div>اقساط: <b class="num" data-pay-insts>@InstSum().Money()</b></div>
                                <div class="fw-700 @(FinalRemaining < -1 ? "text-warning" : FinalRemaining > 1 ? "text-danger" : "text-success")">
                                    @if (FinalRemaining < -1)
                                    {
                                        <span>مازاد (سود مدت‌دار): <b class="num" data-pay-remain>@((-FinalRemaining).Money())</b></span>
                                    }
                                    else
                                    {
                                        <span>باقی‌مانده: <b class="num" data-pay-remain>@FinalRemaining.Money()</b>@(FinalRemaining > 1 ? " (به نسیه می‌رود)" : "")</span>
                                    }
                                </div>
                            </div>

                            @* ---------- جزء نقدی ---------- *@
                            @if (useCash)
                            {
                                <div class="mt-3" data-pay-cash-box>
                                    <div class="row g-2 align-items-end">
                                        @if (HasNonCash)
                                        {
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8"><i class="bi bi-cash-coin text-success"></i> @(Type == TransactionType.Sale ? "دریافت نقدی" : "پرداخت نقدی") (بخشی از مبلغ)</label>
                                                <input class="form-control form-control-sm num" value="@cashAmountText"
                                                       @oninput="OnCashAmountInput" inputmode="numeric" dir="ltr" placeholder="0" data-pay-cash-input />
                                            </div>
                                        }
                                        <div class="col-6 col-md-3">
                                            <label class="form-label fs-8">نوع @(Type == TransactionType.Sale ? "دریافت" : "پرداخت") نقدی</label>
                                            <select class="form-select form-select-sm" value="@cashTypeStr" @onchange="OnCashTypeSelect" data-pay-cashtype>
                                                <option value="0">وجه نقد</option>
                                                <option value="1">کارت‌خوان (POS)</option>
                                                <option value="2">کارت به کارت</option>
                                            </select>
                                        </div>
                                        <div class="col-6 col-md-4">
                                            <label class="form-label fs-8">بانک/صندوق</label>
                                            <div class="input-group input-group-sm">
                                                <select class="form-select form-select-sm" value="@(trsAccountId ?? 0)" @onchange="OnCashAccountChanged">
                                                    <option value="0">— انتخاب بانک —</option>
                                                    @foreach (var a in AccountsForCashType(CashKind))
                                                    {
                                                        <option value="@a.Id">@a.DisplayName</option>
                                                    }
                                                </select>
                                                <button type="button" class="btn btn-outline-primary" title="تعریف بانک/حساب جدید"
                                                        @onclick="() => OpenQuickBank(TreasuryAccountKind.Bank)">
                                                    <i class="bi bi-plus-lg ms-1"></i> تعریف بانک
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-2 fs-8 pb-1">
                                            @if (HasNonCash)
                                            {
                                                <span>باقی‌مانده پس از نقد: <b class="num text-primary" data-pay-remain-cash>@RemainingAfterCash.Money()</b></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">تمام مبلغ نقدی است.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ---------- جزء چک ---------- *@
                            @if (useCheque)
                            {
                                <div class="mt-3" data-pay-cheque-box>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="fs-8 fw-700">@(Type == TransactionType.Purchase ? "چک‌های پرداختی به تأمین‌کننده" : "چک‌های دریافتی از مشتری")</span>
                                        <button type="button" class="btn btn-sm btn-calc ms-auto" @onclick="() => OpenCalc(true)">
                                            <i class="bi bi-calculator"></i> محاسبه اقساطِ چک
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-pay-add-cheque @onclick="AddCheque">
                                            <i class="bi bi-plus-lg"></i> افزودن چک
                                        </button>
                                    </div>
                                    @for (var ci = 0; ci < cheques.Count; ci++)
                                    {
                                        var i = ci;
                                        <div class="cheque-row row g-2 align-items-end" data-cheque-row="@i">
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">شماره چک/صیاد *</label>
                                                <input class="form-control form-control-sm" @bind="cheques[i].Number" dir="ltr" />
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8">بانک @(Type == TransactionType.Purchase ? "(حساب ما) *" : "")</label>
                                                <div class="input-group input-group-sm">
                                                    @if (Type == TransactionType.Purchase)
                                                    {
                                                        <select class="form-select form-select-sm" value="@(cheques[i].TrsAccountId ?? 0)"
                                                                @onchange="@(e => OnChequeAccountChanged(i, e))">
                                                            <option value="0">— انتخاب حساب بانکی —</option>
                                                            @foreach (var b in bankAccounts.Where(x => x.Kind == TreasuryAccountKind.Bank))
                                                            {
                                                                <option value="@b.Id">@b.DisplayName</option>
                                                            }
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <input class="form-control form-control-sm" list="orderBankDataList" @bind="cheques[i].BankName" placeholder="نام بانک…" />
                                                    }
                                                    <button type="button" class="btn btn-outline-primary" title="تعریف بانک جدید"
                                                            @onclick="() => OpenQuickBankForCheque(i, TreasuryAccountKind.Bank)">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">@(Type == TransactionType.Purchase ? "در وجه / گیرنده" : "صاحب چک")</label>
                                                <input class="form-control form-control-sm" @bind="cheques[i].OwnerName" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">مبلغ (ریال) *</label>
                                                <input class="form-control form-control-sm num" value="@chequeAmounts[i]"
                                                       @oninput="@(e => OnChequeAmountInput(i, e))" inputmode="numeric" dir="ltr" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">سررسید چک *</label>
                                                <DatePicker @bind-Value="chequeDates[i]" />
                                            </div>
                                            <div class="col-6 col-md-1 text-center">
                                                <button type="button" class="btn btn-sm btn-light" data-pay-remove-cheque="@i" @onclick="() => RemoveCheque(i)"><i class="bi bi-x-lg text-danger"></i></button>
                                            </div>
                                            <div class="col-12 fs-9">
                                                <span class="text-muted">باقی‌مانده پس از این چک:</span>
                                                <b class="num text-primary" data-rem-cheque="@i">@RemainingAfterCheque(i).Money()</b> ریال
                                            </div>
                                        </div>
                                    }
                                    @if (cheques.Count == 0)
                                    {
                                        <div class="fs-8 text-muted">هنوز چکی اضافه نشده است؛ با «افزودن چک» ردیف جدید با مبلغ باقی‌مانده ساخته می‌شود.</div>
                                    }
                                </div>
                            }

                            @* ---------- جزء اقساط ---------- *@
                            @if (useInstallment)
                            {
                                <div class="mt-3" data-pay-inst-box>
                                    <div class="row g-2 align-items-end mb-2">
                                        <div class="col-6 col-md-2">
                                            <label class="form-label fs-8">تعداد قسط</label>
                                            <input class="form-control form-control-sm num" @bind="instCount" type="number" min="1" max="60" dir="ltr" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label fs-8">تاریخ اولین قسط</label>
                                            <DatePicker @bind-Value="instFirstDue" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label fs-8">فاصله (روز)</label>
                                            <input class="form-control form-control-sm num" @bind="instIntervalDays" type="number" min="1" dir="ltr" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <button type="button" class="btn btn-sm btn-primary w-100" data-pay-build-inst @onclick="() => BuildInstallments()">
                                                <i class="bi bi-journal-plus"></i> ساخت دفترچه
                                            </button>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <button type="button" class="btn btn-sm btn-calc w-100" @onclick="() => OpenCalc(false)">
                                                <i class="bi bi-calculator"></i> محاسبه با سود
                                            </button>
                                        </div>
                                    </div>
                                    @if (installments.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-1">
                                                <thead>
                                                    <tr>
                                                        <th>قسط</th><th>سررسید</th><th class="text-start">مبلغ (ریال)</th>
                                                        <th class="text-start">باقی‌مانده پس از این قسط</th><th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (var xi = 0; xi < installments.Count; xi++)
                                                    {
                                                        var i = xi;
                                                        <tr data-inst-row="@i">
                                                            <td class="num">قسط @((i + 1).Num())</td>
                                                            <td style="max-width:170px"><DatePicker @bind-Value="instDates[i]" /></td>
                                                            <td class="text-start">
                                                                <input class="form-control form-control-sm num" value="@instAmounts[i]"
                                                                       @oninput="@(e => OnInstAmountInput(i, e))" inputmode="numeric" dir="ltr" />
                                                            </td>
                                                            <td class="text-start"><b class="num text-primary" data-rem-inst="@i">@RemainingAfterInstallment(i).Money()</b></td>
                                                            <td><button type="button" class="btn btn-sm btn-light" data-pay-remove-inst="@i" @onclick="() => RemoveInstallment(i)"><i class="bi bi-x-lg text-danger"></i></button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="fs-8">
                                            جمع اقساط: <b class="num">@InstSum().Money()</b> —
                                            باقی‌ماندهٔ تجمعی: <b class="num text-primary" data-pay-remain-inst>@FinalRemaining.Money()</b>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fs-8 text-muted">با «ساخت دفترچه» اقساط بر اساس باقی‌ماندهٔ فعلی ساخته می‌شوند.</div>
                                    }
                                </div>
                            }

                            @* ---------- جزء نسیه (باقی‌ماندهٔ نهایی) ---------- *@
                            @if (useCredit)
                            {
                                <div class="mt-3 row g-2 align-items-end" data-pay-credit-box>
                                    <div class="col-6 col-md-4">
                                        <label class="form-label fs-8">تاریخ سررسید نسیه <span class="text-danger">*</span></label>
                                        <DatePicker @bind-Value="creditDue" />
                                    </div>
                                    <div class="col-12 col-md-8 fs-8 pb-1">
                                        مبلغ نسیه (باقی‌ماندهٔ نهایی): <b class="num text-danger" data-pay-credit-amount>@Math.Max(0, FinalRemaining).Money()</b> ریال
                                    </div>
                                </div>
                            }

                            <div class="fs-8 mt-2" data-pay-hint>
                                @if (FinalRemaining > 1)
                                {
                                    <span class="text-danger"><i class="bi bi-info-circle"></i> جمع پرداخت‌ها @((grandTotal - FinalRemaining).Money()) ریال است؛ باقی‌ماندهٔ @FinalRemaining.Money() ریال به‌صورت نسیه ثبت می‌شود.</span>
                                }
                                else if (FinalRemaining < -1)
                                {
                                    <span class="text-warning"><i class="bi bi-info-circle"></i> جمع پرداخت‌ها @((-FinalRemaining).Money()) ریال بیشتر از مبلغ سند است (سود مدت‌دار).</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check2-circle"></i> جمع اجزای پرداخت با مبلغ سند برابر است.</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-700 fs-7"><i class="bi bi-list-ul text-primary ms-1"></i>اقلام فاکتور</span>
                <button class="btn btn-sm btn-outline-primary" data-hotkey="f2" title="کلید میانبر: F2" @onclick="AddLine">
                    <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                </button>
            </div>

            <div>
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: @(Type == TransactionType.Sale ? "30%" : "35%")">کالا</th>
                            <th style="width: 12%">مقدار (تا ۲ رقم اعشار)</th>
                            <th style="width: 18%">قیمت واحد (ریال)</th>
                            <th style="width: 16%">تخفیف (تا ۱۰۰=٪، بالا=ریال)</th>
                            <th class="text-start">مبلغ کل</th>
                            @if (Type == TransactionType.Sale)
                            {
                                @if (CanSeeProfit)
                                {
                                    <th class="text-start">سود</th>
                                }
                                @if (referrerId > 0)
                                {
                                    <th class="text-start">پورسانت</th>
                                }
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lines)
                        {
                            <tr>
                                <td>
                                    <SearchSelect Items="productLookup"
                                                  Value="l.ProductId"
                                                  ValueChanged="id => OnProductPicked(l, id)"
                                                  Placeholder="جستجوی کالا…" />
                                    @if (!string.IsNullOrEmpty(l.Unit) || l.ProductId > 0)
                                    {
                                        <div class="fs-8 text-muted mt-1 d-flex gap-2 flex-wrap">
                                            @if (!string.IsNullOrEmpty(l.Unit))
                                            {
                                                <span>واحد: @l.Unit</span>
                                            }
                                            @if (l.ProductId > 0 && warehouseId > 0 && !IsServiceProduct(l.ProductId))
                                            {
                                                var avail = warehouseStocks.TryGetValue(l.ProductId, out var q) ? q : 0m;
                                                <span class="@(avail <= 0 ? "text-danger" : "text-success")">
                                                    · موجودی انبار: <b class="num">@avail.ToString("0.##")</b>
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <input class="form-control num" inputmode="decimal" dir="ltr" placeholder="1.25"
                                           title="مقدار می‌تواند اعشاری و تا دو رقم اعشار باشد"
                                           value="@l.QtyText" @oninput="@(e => { l.QtyText = FormatQuantity(e.Value); RecalcDiscount(l); })" />
                                </td>
                                <td>
                                    <input class="form-control num" inputmode="decimal" dir="ltr"
                                           value="@l.PriceText" @oninput="@(e => { l.PriceText = FormatNum(e.Value); RecalcDiscount(l); })" />
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input class="form-control form-control-sm text-center num"
                                               value="@l.DiscountText"
                                               @oninput="e => OnLineDiscountInput(l, e.Value?.ToString())"
                                               @onblur="() => OnLineDiscountBlur(l)"
                                               placeholder="0" inputmode="numeric" dir="ltr" />
                                        <span class="input-group-text @(l.DiscountIsAmount ? "text-primary" : "")"
                                              style="font-size:0.75rem;min-width:32px;justify-content:center;"
                                              title="@(l.DiscountIsAmount ? "مبلغ ریالی" : "درصد")">
                                            @(l.DiscountIsAmount ? "ریال" : "٪")
                                        </span>
                                    </div>
                                    @if (l.DiscountAmount > 0)
                                    {
                                        <div class="fs-9 mt-1 text-danger num text-start">
                                            @l.DiscountAmount.Money() ریال
                                            @if (l.DiscountIsAmount)
                                            {
                                                <span class="text-muted">(@l.DiscountPercent.ToString("0.##")٪)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-start num fw-500">@l.Total.Money()</td>
                                @if (Type == TransactionType.Sale)
                                {
                                    @if (CanSeeProfit)
                                    {
                                        <td class="text-start num">
                                            @{ var profit = LineProfit(l); }
                                            @if (l.ProductId > 0 && l.Qty > 0)
                                            {
                                                <span class="fw-500 @(profit >= 0 ? "text-success" : "text-danger")">@profit.Money()</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    }
                                    @if (referrerId > 0)
                                    {
                                        <td class="text-start num">
                                            @if (l.ProductId > 0 && l.Qty > 0)
                                            {
                                                <span class="text-primary">@LineCommission(l).Money()</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    }
                                }
                                <td class="text-end text-nowrap">
                                    @if (Type == TransactionType.Sale && l.ProductId > 0 && !IsServiceProduct(l.ProductId))
                                    {
                                        <button class="btn btn-sm btn-light" title="آخرین فاکتور خرید این کالا" @onclick="() => ShowLastPurchase(l.ProductId)">
                                            <i class="bi bi-receipt text-primary"></i>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-light" @onclick="() => RemoveLine(l)">
                                        <i class="bi bi-x-lg text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-top-2 table-light" style="border-top: 2px solid #cbd5e1;">
                        <tr class="align-middle">
                            <td class="fw-bold text-secondary">
