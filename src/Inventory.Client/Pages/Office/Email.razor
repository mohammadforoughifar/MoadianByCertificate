    private bool HasActiveFilters()
    {
        return FiltersDirty
            || dateFrom.HasValue
            || dateTo.HasValue
            || readFilter != "all"
            || attachmentFilter != "all";
    }

    private int ActiveFilterCount()
    {
        int c = 0;
        if (dateFrom.HasValue) c++;
        if (dateTo.HasValue) c++;
        if (readFilter != "all") c++;
        if (attachmentFilter != "all") c++;
        return c;
    }

    private async Task ClearFiltersAsync()
    {
        // پیش‌نویس و مقدارِ اعمال‌شده هر دو صفر می‌شوند تا شمارندهٔ فیلترها هم درست شود
        fDateFrom = null; fDateTo = null;
        dReadFilter = "all"; dAttachmentFilter = "all";
        dateFrom = null; dateTo = null;
        readFilter = "all"; attachmentFilter = "all";
        await RunQueryAsync();
    }

