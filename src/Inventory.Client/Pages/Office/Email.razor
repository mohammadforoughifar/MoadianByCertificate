@* ==================== فرم ایجاد نامه داخلی (تبدیل ایمیل به نامه) ==================== *@
<ComposeLetterModal @ref="letterCompose" />
<ComposeIncomingModal @ref="composeIncomingModal" OnSaved="() => StateHasChanged()" />

@code {
    private bool showGuide;
    private void BackFromGuide() => showGuide = false;

    /// <summary>
    /// آماده‌سازی بدنهٔ HTML ایمیل برای نمایش: تصاویرِ درونِ متن به آدرسِ پیوست
    /// تبدیل شده‌اند؛ اینجا آن آدرس‌ها مطلق می‌شوند و توکن دسترسی به آن‌ها اضافه
    /// می‌شود (تگ img نمی‌تواند هدر Bearer بفرستد).
    /// </summary>
    /// <summary>پیوست‌های واقعیِ ایمیلِ باز (تصاویر درون‌متن حذف می‌شوند)</summary>
    private List<EmailAttachmentDto> FileAttachments =>
        openMsg?.Attachments.Where(a => !a.IsInline).ToList() ?? new();

    /// <summary>تعداد تصاویرِ درونِ متن (برای نمایش اطلاع‌رسانی کوچک)</summary>
    private int InlineImageCount => openMsg?.Attachments.Count(a => a.IsInline) ?? 0;

    private string RenderEmailBody(string? body)
    {
        var html = string.IsNullOrWhiteSpace(body) ? "—" : body!;
        var marker = "/api/email/attachments/";
        var pos = 0;
        while ((pos = html.IndexOf(marker, pos, StringComparison.OrdinalIgnoreCase)) >= 0)
        {
            var end = pos + marker.Length;
            while (end < html.Length && html[end] is not ('"' or '\'' or ' ' or '>' or ')' or '&')) end++;

            // نسبی → مطلق (اگر از قبل مطلق باشد دست نمی‌خورد)
            var isAbsolute = pos > 0 && (html[pos - 1] == '/' || html[pos - 1] == ':');
            if (!isAbsolute)
            {
                var absolute = Api.BuildUrl(html.Substring(pos, end - pos));
                html = html.Remove(pos, end - pos).Insert(pos, absolute);
                end = pos + absolute.Length;
            }

            if (html.IndexOf("?access_token=", pos, end - pos, StringComparison.OrdinalIgnoreCase) < 0)
            {
                html = html.Insert(end, "?access_token=" + Uri.EscapeDataString(Auth.Token ?? ""));
                pos = end + 15;
            }
            else pos = end;
        }
        return html;
    }

    private bool loading = true;
    private bool syncing;

    /// <summary>در حال کار: همگام‌سازی با سرور یا بارگذاریِ فهرست.
    /// تا زمانی که درست است، تغییرِ بخش مجاز نیست تا کاربر وسطِ کار جابه‌جا نشود.</summary>
    private bool busy => syncing || loading;

    private string busyText => syncing ? "در حال دریافت ایمیل‌ها از سرور…"
        : searching ? "در حال جستجو…"
        : "در حال بارگذاری…";
    private string tab = "inbox";

    /// <summary>متنِ داخل کادر جستجو (پیش‌نویس) — با تایپ‌کردن جستجو اجرا نمی‌شود.</summary>
    private string searchInput = "";

    /// <summary>عبارتِ جستجویِ اعمال‌شده؛ فقط با دکمهٔ «جستجو» یا Enter عوض می‌شود.</summary>
    private string search = "";

    /// <summary>جستجو/اعمال فیلتر در جریان است (نوار پیشرفت و اسپینر دکمه‌ها).</summary>
    private bool searching;

    private int accFilter;

    // ---------- فیلترهای پیشرفته (اعمال‌شده) ----------
    private DateTime? dateFrom;   // تاریخ شروع
    private DateTime? dateTo;     // تاریخ پایان
    private string readFilter = "all";          // all | read | unread
    private string attachmentFilter = "all";    // all | with | without

    // ---------- پیش‌نویس فیلترها (تا زدنِ «اعمال فیلتر» به کوئری تبدیل نمی‌شوند) ----------
    private DateTime? fDateFrom;
    private DateTime? fDateTo;
    private string dReadFilter = "all";
    private string dAttachmentFilter = "all";

    /// <summary>پیش‌نویس با فیلترِ اعمال‌شده تفاوت دارد ⇒ دکمهٔ «اعمال فیلتر» معنا پیدا می‌کند.</summary>
    private bool FiltersDirty => fDateFrom != dateFrom || fDateTo != dateTo
                                 || dReadFilter != readFilter || dAttachmentFilter != attachmentFilter;
    private bool showFilters;

    /// <summary>true وقتی کاربر از مسیر «ایمیل شخصی» آمده — فقط حساب‌های شخصیِ خودش</summary>
    private bool personalMode;

    /// <summary>صفحهٔ ایمیل شخصی بدون مجوز Email.Personal باز شده — نمایش پیام راهنما</summary>
    private bool noPersonalAccess;

    // ---------- صفحه‌بندیِ سمت سرور ----------
    private int curPage = 1;
    private int pageSize = 25;
    private int totalItems;
    private int totalPages = 1;
    private int spamCount;

    private List<EmailAccountDto> accounts = new();
    private List<EmailMessageListItemDto> messages = new();
    private EmailMessageDetailDto? openMsg;
    private int openId;
    private string openBox = "";
    private int unreadCount;

    /// <summary>حساب‌هایی که در این صفحه دیده می‌شوند — در حالت شخصی فقط حساب‌های خودِ کاربر</summary>
    private List<EmailAccountDto> VisibleAccounts =>
        personalMode ? accounts.Where(a => a.IsMine && !a.IsDabirkhane).ToList() : accounts;

    /// <summary>
    /// حساب‌های شخصی برای فهرستِ «حساب‌های شخصی من».
    /// حساب‌های رسمیِ دبیرخانه در بخش جداگانه‌ای نمایش داده می‌شوند؛ اگر این‌جا هم
    /// بیایند، در صفحهٔ «ایمیل سازمانی» دو بار دیده می‌شدند.
    /// </summary>
    private List<EmailAccountDto> PersonalAccounts => accounts.Where(a => !a.IsDabirkhane).ToList();

    private ComposeLetterModal? letterCompose;
    private bool converting;

    /// <summary>
    /// تبدیل ایمیل شخصی به نامه داخلی — فرم ایجاد نامه با عنوان و متنِ ایمیل
    /// و پیوست‌های آن باز می‌شود؛ کاربر بقیهٔ موارد را خودش پر می‌کند.
    /// </summary>
    private async Task DownloadAttachmentAsync(EmailAttachmentDto att)
    {
        try
        {
            var (data, name) = await EmailSvc.DownloadAttachmentAsync(att.AttachmentId);
            if (data is null || data.Length == 0) { Toast.Error("فایل پیوست پیدا نشد یا خالی است."); return; }
            await JS.InvokeVoidAsync("downloadBlob", string.IsNullOrWhiteSpace(name) ? att.RealName : name,
                "application/octet-stream", Convert.ToBase64String(data));
        }
        catch (Exception ex) { Toast.Error($"دانلود پیوست انجام نشد: {ex.Message}"); }
    }

    private async Task ConvertToLetterAsync()
    {
        if (openMsg == null) return;
        converting = true;
        try
        {
            // عنوانِ نامه نباید خالی باشد — ایمیل‌های بدون موضوع جایگزین می‌شوند
            var title = string.IsNullOrWhiteSpace(openMsg.Subject) ? "(بدون موضوع)" : openMsg.Subject.Trim();

            // متن نامه از روی ایمیل ساخته می‌شود: بدنهٔ پاک‌سازی‌شده + تصاویرِ داخل متن و
            // تصاویرِ پیوستی، همه به‌صورت data URI داخل خودِ متن — بدون برچسب یا نام فایل،
            // تا متن نامه «مثل خودِ ایمیل دریافتی» دیده شود.
            var letterBody = await EmailLetterBodyBuilder.BuildAsync(openMsg, EmailSvc);

            // ---------- همهٔ پیوست‌های ایمیل، با هر فرمتی ----------
            // همان منطقِ مشترکِ «تبدیل به نامهٔ وارده»: هیچ فیلتری روی نوع/پسوند نیست و
            // تصویرِ داخل متن هم علاوه بر دیده‌شدن در متن، فایل ضمیمهٔ نامه می‌شود.
            var transfer = await EmailAttachmentTransferService.CollectAsync(openMsg.Attachments, EmailSvc);
            var files = transfer.Files;

            var images = letterBody.InlineImages + letterBody.AttachedImages;
            if (images > 0)
                Toast.Success($"{images.FaDigits()} تصویر ایمیل داخل متن نامه قرار گرفت.");
            if (letterBody.Skipped > 0)
                Toast.Error($"{letterBody.Skipped.FaDigits()} تصویر منتقل نشد (حجم بیش از ۵ مگابایت یا قالب پشتیبانی‌نشده).");
            if (transfer.Count > 0)
                Toast.Success($"{transfer.Count.FaDigits()} پیوست ایمیل به نامه اضافه شد.");
            if (transfer.TooBig.Count > 0)
                Toast.Error($"{transfer.TooBig.Count.FaDigits()} پیوست به دلیل عبور از سقف مجاز (۲۰ مگابایت هر فایل / ۱۰۰ مگابایت مجموع) منتقل نشد: "
                            + string.Join("، ", transfer.TooBig.Take(5)));
            if (transfer.Failed.Count > 0)
                Toast.Error($"دریافت {transfer.Failed.Count.FaDigits()} پیوست از سرور ایمیل ناموفق بود: "
                            + string.Join("، ", transfer.Failed.Take(5)));

            // یک خطِ کوتاهِ منبع در بالای متن (نه کادرِ چندخطی) تا نامه مثل خودِ ایمیل بماند
            var header = "<p style=\"color:#64748b;font-size:12px;margin:0 0 10px\">"
                       + $"برگرفته از ایمیل {(openMsg.Box == "Sent" ? "ارسالی" : "دریافتی")} — {openMsg.Date.ToFaDateTime()}"
                       + "</p>";

            letterCompose?.Open(title, header + letterBody.Html, null, files);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { converting = false; }
    }

