    private async Task SetTab(string t)
    {
        showGuide = false;
        tab = t; openMsg = null; openId = 0; openBox = ""; archOpen = false; curPage = 1;
        if (t == "accounts") await LoadAccountsAsync();
        if (t == "archive" && folders.Count == 0) { try { folders = await EmailSvc.GetFoldersAsync(); } catch { } }
        // دریافتی/ارسالی/اسپم: اول فهرستِ صفحه‌بندی‌شده از بانک خوانده می‌شود تا کاربر
        // معطلِ سرورِ IMAP نماند؛ بعد همگام‌سازی در پس‌زمینه انجام و در صورت رسیدنِ
        // پیامِ تازه فهرست بازخوانی می‌شود (حداکثر هر ۶۰ ثانیه یک‌بار برای هر صندوق).
        if (t is "inbox" or "sent" or "spam")
        {
            if (!VisibleAccounts.Any(a => a.IsActive))
            {
                messages = new(); totalItems = 0; totalPages = 1; unreadCount = 0; spamCount = 0;
                return;
            }
            await ReloadAsync();
            if (ShouldAutoSync(t)) _ = SyncFolderAsync(t);
            return;
        }
        await ReloadAsync();
    }

    /// <summary>آخرین همگام‌سازیِ موفقِ هر صندوق (برای جلوگیری از تکرارِ پشت‌سرهم)</summary>
    private readonly Dictionary<string, DateTime> _lastSyncAt = new();

    private bool ShouldAutoSync(string box) =>
        !_lastSyncAt.TryGetValue(box, out var last) || (DateTime.UtcNow - last).TotalSeconds >= 60;

    /// <summary>
    /// همگام‌سازیِ افزایشی: بارِ اول همه‌ی پیام‌ها را در بانک می‌نشاند؛
    /// در دفعات بعد فقط پیام‌های جدیدتر از آخرین نوبت را می‌گیرد.
    /// </summary>
    private async Task SyncFolderAsync(string box)
    {
        syncing = true;
        _lastSyncAt[box] = DateTime.UtcNow;
        StateHasChanged();
        try
        {
            // در صفحهٔ «ایمیل شخصی» فقط حساب‌های شخصیِ خودِ کاربر همگام می‌شوند
            var r = box switch
            {
                "sent" => await EmailSvc.SyncSentAsync(personalMode),
                "spam" => await EmailSvc.SyncJunkAsync(personalMode),
                _ => await EmailSvc.SyncInboxAsync(personalMode)
            };
            // فقط هنگام رسیدنِ پیام تازه اطلاع می‌دهیم تا هر بار کلیک مزاحم نشود
            if (r.NewCount > 0)
            {
                Toast.Success(r.Message);
                await ReloadAsync();   // پیام‌های تازه در همان لحظه در فهرست دیده شوند
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { syncing = false; StateHasChanged(); }
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts = await EmailSvc.GetAccountsAsync();
            var pool = VisibleAccounts;
            if (cpAccountId == 0 && pool.Any(x => x.IsActive))
                cpAccountId = pool.First(x => x.IsActive).EmailId;
            if (accFilter > 0 && accounts.All(x => x.EmailId != accFilter)) accFilter = 0;

            // انتخابِ پیش‌فرضِ کمبوی حساب‌ها: حسابی که «تازه‌ترین ایمیل» را دارد.
            // فقط یک‌بار (اولین بارگذاری) اعمال می‌شود تا اگر کاربر «همه حساب‌ها» را انتخاب کرد،
            // بارگذاری‌های بعدی انتخاب او را بازنویسی نکنند.
            if (!_accountDefaultApplied)
            {
                _accountDefaultApplied = true;
                if (accFilter == 0)
                {
                    var newest = NewestMailAccount(pool);
                    if (newest != null) accFilter = newest.EmailId;
                }
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>انتخابِ پیش‌فرضِ حساب (تازه‌ترین ایمیل) فقط یک‌بار در هر نشست اعمال می‌شود.</summary>
    private bool _accountDefaultApplied;

    /// <summary>متن کمکیِ کنار نام حساب در کمبو: تاریخِ آخرین ایمیل</summary>
    private static string MailHint(EmailAccountDto a)
        => a.LastMessageAt.HasValue ? $" — آخرین ایمیل: {a.LastMessageAt.Value.ToFaDate()}" : "";

    /// <summary>
    /// حسابی که تازه‌ترین ایمیل را دارد: اول بر اساس <c>LastMessageAt</c> (تاریخِ آخرین پیام)،
    /// اگر هیچ حسابی پیامی نداشت بر اساس <c>LastSync</c>، و در نهایت اولین حسابِ فعال.
    /// فقط حساب‌های فعال در نظر گرفته می‌شوند.
    /// </summary>
    private static EmailAccountDto? NewestMailAccount(IEnumerable<EmailAccountDto> pool)
    {
        var active = pool.Where(a => a.IsActive).ToList();
        if (active.Count == 0) return null;

        var withMail = active.Where(a => a.LastMessageAt.HasValue).ToList();
        if (withMail.Count > 0)
            return withMail.OrderByDescending(a => a.LastMessageAt).First();

        var synced = active.Where(a => a.LastSync.HasValue).ToList();
        if (synced.Count > 0)
            return synced.OrderByDescending(a => a.LastSync).First();

        return active[0];
    }

    /// <summary>شمارنده‌ی درخواست‌ها — اگر کاربر سریع چند فیلتر را عوض کند، فقط نتیجه‌ی
    /// آخرین درخواست روی صفحه می‌نشیند (قبلاً نتیجه‌ی درخواستِ قدیمی‌تر می‌توانست
    /// دیرتر برسد و فیلتر را «بی‌اثر» نشان دهد).</summary>
    private int _reloadVersion;

    /// <summary>
    /// خواندنِ یک صفحه از فهرست. همه‌ی پالایش‌ها (جستجو، پوشه، اسپم، نشان،
    /// حساب) و برشِ صفحه در بانک انجام می‌شود و فقط همین صفحه به کلاینت می‌آید.
    /// </summary>
    private async Task ReloadAsync()
    {
        var version = ++_reloadVersion;
        loading = true;
        try
        {
            // نبود حساب ایمیل یک وضعیت عادی است، نه خطای احراز هویت؛
            // در این حالت صندوق‌ها خالی نمایش داده می‌شوند تا کاربر حساب بسازد.
            if (tab != "accounts" && !VisibleAccounts.Any(a => a.IsActive))
            {
                messages = new(); totalItems = 0; totalPages = 1; unreadCount = 0; spamCount = 0;
                return;
            }
            int? fid = accFilter > 0 ? accFilter : null;
            var term = string.IsNullOrWhiteSpace(search) ? null : search.Trim();

            // فیلترهای پیشرفته
            DateTime? df = dateFrom;
            DateTime? dt = dateTo;
            // اگر کاربر «از تاریخ» را بعد از «تا تاریخ» انتخاب کند، بازه بی‌صدا خالی
            // برمی‌گشت؛ اینجا جای دو تاریخ عوض می‌شود تا بازه همیشه معتبر باشد.
            if (df.HasValue && dt.HasValue && df.Value.Date > dt.Value.Date) (df, dt) = (dt, df);
            // «خوانده‌شده» و «خوانده‌نشده» هر دو به سرور می‌روند (isRead: true = فقط خوانده‌شده).
            // قبلاً انتخابِ «خوانده‌شده» هیچ پارامتری نمی‌فرستاد و مثلِ «همه» رفتار می‌کرد.
            bool? uo = readFilter == "unread" ? true : null;
            bool? ir = readFilter == "read" ? true : readFilter == "unread" ? false : null;
            bool? ha = attachmentFilter == "with" ? true : attachmentFilter == "without" ? false : null;

            EmailListPageDto res;
            if (tab == "archive")
                res = await EmailSvc.GetArchiveAsync(fid, term, curPage, pageSize, personalMode, df, dt, ha, uo, ir);
            else if (tab == "sent")
                res = await EmailSvc.GetSentAsync(fid, term, null, curPage, pageSize, false, personalMode, df, dt, ha, ir);
            else if (tab == "starred")
                res = await EmailSvc.GetInboxAsync(fid, term, uo, null, curPage, pageSize, false, true, personalMode, df, dt, ha, ir);
            else if (tab == "spam")
                res = await EmailSvc.GetInboxAsync(fid, term, uo, null, curPage, pageSize, true, false, personalMode, df, dt, ha, ir);
            else
                res = await EmailSvc.GetInboxAsync(fid, term, uo, null, curPage, pageSize, false, false, personalMode, df, dt, ha, ir);

            // درخواستِ تازه‌تری در جریان است — این نتیجه دور ریخته می‌شود
            if (version != _reloadVersion) return;

            totalItems = res.TotalCount;
            totalPages = res.PageCount;
            spamCount = res.SpamCount;
            if (tab == "inbox") unreadCount = res.UnreadCount;

            // اگر بعد از حذف/اسپم/تغییرِ فیلتر، شماره‌ی صفحه از محدوده بیرون رفته باشد
            // (مثلاً آخرین آیتمِ آخرین صفحه حذف شده)، یک‌بار با صفحه‌ی معتبر بازخوانی می‌شود
            if (curPage > totalPages && totalPages >= 1)
            {
                curPage = totalPages;
                await ReloadAsync();
                return;
            }

            messages = res.Items;

            // وضعیتِ «خوانده‌شده»ٔ ایمیل‌هایی که در این نشست باز شده‌اند دوباره اعمال می‌شود.
            // بدون این کار، بعد از «دریافتِ» ایمیل‌های جدید، ایمیل‌های قبلی که کاربر
            // دیده بود ممکن است دوباره خوانده‌نشده (بولد) نمایش داده شوند.
            var restoredRead = 0;
            foreach (var m in res.Items)
            {
                if (!m.IsRead && m.Box == "Inbox" && _readKeys.Contains(ReadKey(m.Box, m.Id)))
                {
                    m.IsRead = true;
                    restoredRead++;
                }
            }
            // شمارنده فقط مربوط به صندوقِ دریافتی است
            if (restoredRead > 0 && tab == "inbox") unreadCount = Math.Max(0, unreadCount - restoredRead);
        }
        catch (Exception ex) { if (version == _reloadVersion) Toast.Error(ex.Message); }
        finally { if (version == _reloadVersion) loading = false; }
    }

    /// <summary>رفتن به یک صفحه — همیشه از سرور خوانده می‌شود</summary>
    private async Task GoPageAsync(int p)
    {
        if (p < 1 || p > totalPages || p == curPage) return;
        curPage = p;
        await ReloadAsync();
    }

    /// <summary>شماره‌های صفحه برای نمایش — پنجره‌ای تا هفت دکمه</summary>
    private List<int> PageButtons()
    {
        const int win = 7;
        if (totalPages <= win) return Enumerable.Range(1, totalPages).ToList();
        var start = Math.Max(1, Math.Min(curPage - win / 2, totalPages - win + 1));
        return Enumerable.Range(start, win).ToList();
    }

    // ---------- جستجو و فیلتر فقط با دکمه ----------
    // قبلاً هر کلید یک درخواست (با تأخیر ۴۰۰ms) می‌فرستاد؛ حالا متن فقط در «searchInput»
    // نگه داشته می‌شود و تا زدن دکمهٔ «جستجو» (یا Enter) چیزی به سرور نمی‌رود.

    /// <summary>تایپ در کادر جستجو — عمداً درخواستی نمی‌فرستد.</summary>
