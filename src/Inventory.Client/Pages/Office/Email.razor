        await RunQueryAsync();
    }

    /// <summary>پاک کردن کادر جستجو و بازگرداندن فهرست کامل.</summary>
    private void ClearSearchBox() => searchInput = "";

    /// <summary>پاک کردن کامل جستجو (کادر + عبارت اعمال‌شده) و بازخوانی فهرست.</summary>
    private async Task ClearSearchAsync()
    {
        searchInput = "";
        search = "";
        await RunQueryAsync();
    }

    /// <summary>اعمال فیلترهای پیش‌نویس روی فهرست.</summary>
    private async Task ApplyFiltersAsync()
    {
        dateFrom = fDateFrom;
        dateTo = fDateTo;
        readFilter = dReadFilter;
        attachmentFilter = dAttachmentFilter;
        await RunQueryAsync();
    }

