    /// <summary>اجرای کوئری با نشانگر پیشرفت (جستجو/فیلتر).</summary>
    private async Task RunQueryAsync()
    {
        curPage = 1;
        searching = true;
        StateHasChanged();
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally
        {
            searching = false;
            StateHasChanged();
        }
