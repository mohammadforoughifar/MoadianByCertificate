    // ---------- فرم ----------
    private ProjectEntryExitDto form = new();
    private bool showModal, saving;
    private bool editing => form.Id != 0;
    private bool isFolder { get => form.IsFolder == true; set => form.IsFolder = value; }
    private string? editUserName;

    // ---------- حالت برگشتی ----------
    private bool isReturnMode;
    private int selectedReturnId, reNum = 1;
    private string parentCode = "";
    private string nextSerialSuggestion = "";
    /// <summary>کدهای برگشتی ثبت‌شده برای پروژه مبدأ انتخابی (نمایش به کاربر)</summary>
    private List<string> existingReturns = new();

    // ---------- فاکتور (فرم مجزا) ----------
    private bool showFactor;
    private ProjectEntryExitDto? factorProject;
    private int factorTypeId;
    private string? factorNumber;

    // ---------- تاریخ‌های پروژه (فرم مجزا — خروج/خروج موقت/نیاز مشتری/تحویل/تحویل پرونده) ----------
    private bool showDates;
