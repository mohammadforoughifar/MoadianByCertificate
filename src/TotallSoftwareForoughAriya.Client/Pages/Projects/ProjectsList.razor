@code {
    // ردیف‌های «همین صفحه» که از سرور خوانده شده‌اند (صفحه‌بندی سمت سرور)
    private List<ProjectEntryExitDto> items = new();
    private int total;          // تعداد کل رکوردهای منطبق با فیلترها
    private int pageCount = 1;  // تعداد صفحه‌ها (از سرور)
    private ProjectLookups lookups = new();
    private bool loading = true;
    private string search = "";
    private int filterKarfarma, filterTypeFactor, filterUser;
    private bool filterReturned;
    // ---------- جستجوی پیشرفته: وضعیت داده برای هر فیلد ----------
    /// <summary>فیلدهای جستجوی پیشرفته: کلید، برچسب، داشتن بازهٔ تاریخ، وابسته به مجوز فاکتور.</summary>
    private static readonly (string Key, string Label, bool IsDate, bool FactorOnly)[] AdvancedFields =
    {
        ("serial", "شماره سریال", false, false),
        ("entry", "تاریخ ورود", true, false),
        ("exit", "تاریخ خروج", true, false),
        ("temporaryExit", "خروج موقت", true, false),
        ("registration", "تاریخ ثبت پروژه", true, false),
        ("customerNeed", "تاریخ نیاز مشتری", true, false),
        ("delivery", "تاریخ تحویل", true, false),
        ("file", "تاریخ پرونده", true, false),
        ("factor", "شماره فاکتور", false, true),
        ("factorType", "نوع فاکتور", false, true),
        ("karshenasi", "کارشناسی اولیه", false, false),
    };

    /// <summary>وضعیت انتخاب‌شدهٔ هر فیلد: "" = همه، "has" = دارد، "empty" = ندارد.</summary>
    private readonly Dictionary<string, string> presence = new();

    private string PresenceOf(string key) => presence.TryGetValue(key, out var v) ? v : "";

    private bool IsPresence(string key, string value) => PresenceOf(key) == value;

    /// <summary>تغییر وضعیت یک فیلد (همه / دارد / ندارد) و بارگذاری دوبارهٔ لیست.</summary>
    private async Task SetPresenceAsync(string key, string? value)
    {
        value ??= "";
        if (value.Length == 0) presence.Remove(key);
        else presence[key] = value;

        // در حالت «ندارد» بازهٔ تاریخ همان فیلد بی‌معنی است؛ پاک می‌شود تا فیلتر متناقض نماند
        if (value == "empty") ClearRange(key);

        await OnFilterChanged();
    }

    private DateTime? RangeFrom(string key) => key switch
    {
        "entry" => advancedEntryFrom,
        "exit" => advancedExitFrom,
        "temporaryExit" => advancedTemporaryExitFrom,
        "registration" => advancedRegistrationFrom,
        "customerNeed" => advancedCustomerNeedFrom,
        "delivery" => advancedDeliveryFrom,
        "file" => advancedFileFrom,
        _ => null
    };

    private DateTime? RangeTo(string key) => key switch
    {
        "entry" => advancedEntryTo,
        "exit" => advancedExitTo,
        "temporaryExit" => advancedTemporaryExitTo,
        "registration" => advancedRegistrationTo,
        "customerNeed" => advancedCustomerNeedTo,
        "delivery" => advancedDeliveryTo,
        "file" => advancedFileTo,
        _ => null
    };

    private void ClearRange(string key)
    {
        switch (key)
        {
            case "entry": advancedEntryFrom = advancedEntryTo = null; break;
            case "exit": advancedExitFrom = advancedExitTo = null; break;
            case "temporaryExit": advancedTemporaryExitFrom = advancedTemporaryExitTo = null; break;
            case "registration": advancedRegistrationFrom = advancedRegistrationTo = null; break;
            case "customerNeed": advancedCustomerNeedFrom = advancedCustomerNeedTo = null; break;
            case "delivery": advancedDeliveryFrom = advancedDeliveryTo = null; break;
            case "file": advancedFileFrom = advancedFileTo = null; break;
        }
    }

    /// <summary>یک انتخاب‌گر تاریخ شمسی (از/تا) برای فیلدهای تاریخی جستجوی پیشرفته.</summary>
    private Microsoft.AspNetCore.Components.RenderFragment RenderRangePicker(string key, bool isFrom) => builder =>
    {
        var seq = 0;
        builder.OpenComponent<DatePicker>(seq++);
        builder.AddAttribute(seq++, "Value", isFrom ? RangeFrom(key) : RangeTo(key));
        builder.AddAttribute(seq++, "ValueChanged",
            EventCallback.Factory.Create<DateTime?>(this, async v =>
            {
                SetRange(key, isFrom, v);
                await OnFilterChanged();
            }));
        builder.AddAttribute(seq++, "Placeholder", isFrom ? "از تاریخ" : "تا تاریخ");
        builder.CloseComponent();
    };

    private void SetRange(string key, bool isFrom, DateTime? value)
    {
        switch (key)
        {
            case "entry": if (isFrom) advancedEntryFrom = value; else advancedEntryTo = value; break;
            case "exit": if (isFrom) advancedExitFrom = value; else advancedExitTo = value; break;
            case "temporaryExit": if (isFrom) advancedTemporaryExitFrom = value; else advancedTemporaryExitTo = value; break;
            case "registration": if (isFrom) advancedRegistrationFrom = value; else advancedRegistrationTo = value; break;
            case "customerNeed": if (isFrom) advancedCustomerNeedFrom = value; else advancedCustomerNeedTo = value; break;
            case "delivery": if (isFrom) advancedDeliveryFrom = value; else advancedDeliveryTo = value; break;
            case "file": if (isFrom) advancedFileFrom = value; else advancedFileTo = value; break;
        }
    }

    /// <summary>آیا در جستجوی پیشرفته چیزی انتخاب شده است؟</summary>
    private bool HasAdvancedFilter => AdvancedFields.Any(f =>
        PresenceOf(f.Key).Length > 0 || (f.IsDate && (RangeFrom(f.Key).HasValue || RangeTo(f.Key).HasValue)));

    private int AdvancedActiveCount => AdvancedFields.Count(f =>
        PresenceOf(f.Key).Length > 0 || (f.IsDate && (RangeFrom(f.Key).HasValue || RangeTo(f.Key).HasValue)));

    /// <summary>خلاصهٔ خوانا از فیلترهای پیشرفتهٔ فعال — برای نمایش به‌صورت برچسب.</summary>
    private IEnumerable<string> AdvancedSummary()
    {
        foreach (var f in AdvancedFields)
        {
            var pv = PresenceOf(f.Key);
            if (pv.Length == 0 && !(f.IsDate && (RangeFrom(f.Key).HasValue || RangeTo(f.Key).HasValue))) continue;

            var state = pv == "has" ? "دارد" : pv == "empty" ? "ندارد" : "همه";
            var text = $"{f.Label}: {state}";
            if (f.IsDate && pv != "empty")
            {
                var from = RangeFrom(f.Key);
                var to = RangeTo(f.Key);
                if (from.HasValue || to.HasValue)
                    text += from.HasValue && to.HasValue
                        ? $" ({from.Value.ToFa()} تا {to.Value.ToFa()})"
                        : from.HasValue ? $" (از {from.Value.ToFa()})" : $" (تا {to.Value.ToFa()})";
            }
            yield return text;
        }
    }

    /// <summary>پاک کردن فقط فیلترهای جستجوی پیشرفته.</summary>
    private async Task ClearAdvanced()
    {
        presence.Clear();
        foreach (var f in AdvancedFields.Where(x => x.IsDate).Select(x => x.Key))
            ClearRange(f);
        page = 1;
        await Load();
    }
    private DateTime? advancedEntryFrom, advancedEntryTo, advancedExitFrom, advancedExitTo, advancedTemporaryExitFrom, advancedTemporaryExitTo;
    private DateTime? advancedRegistrationFrom, advancedRegistrationTo, advancedCustomerNeedFrom, advancedCustomerNeedTo, advancedDeliveryFrom, advancedDeliveryTo, advancedFileFrom, advancedFileTo;

    /// <summary>رویت ستون‌های شماره/نوع فاکتور — مجوز جدا (Projects.ViewFactor)</summary>
    private bool canViewFactor => Auth.Has("Projects.ViewFactor");

    /// <summary>مدیر کارتابل پروژه — ویرایش/حذف او بدون نیاز به تایید، بلافاصله اعمال می‌شود</summary>
    private bool canApproveChanges => Auth.Has("ProjectCartable.Manager");

    // ---------- جستجوی سرستون‌ها ----------
    private string fNum = "", fName = "", fSerial = "", fKarfarma = "";
    private string fEntry = "", fExit = "", fFactor = "", fFactorType = "";
    private string fKarshenasi = "", fSabt = "", fNeed = "", fSpent = "", fFolder = "", fStatus = "";

    private bool HasColFilter =>
        !string.IsNullOrWhiteSpace(fNum) || !string.IsNullOrWhiteSpace(fName) ||
        !string.IsNullOrWhiteSpace(fSerial) || !string.IsNullOrWhiteSpace(fKarfarma) ||
        !string.IsNullOrWhiteSpace(fEntry) || !string.IsNullOrWhiteSpace(fExit) ||
        !string.IsNullOrWhiteSpace(fFactor) || !string.IsNullOrWhiteSpace(fFactorType) ||
        !string.IsNullOrWhiteSpace(fKarshenasi) || !string.IsNullOrWhiteSpace(fSabt) ||
        !string.IsNullOrWhiteSpace(fNeed) || !string.IsNullOrWhiteSpace(fSpent) ||
        !string.IsNullOrWhiteSpace(fFolder) || !string.IsNullOrWhiteSpace(fStatus);

    /// <summary>آیا هیچ فیلتری (بالای صفحه یا سرستون) فعال است؟</summary>
    private bool HasAnyFilter => HasColFilter || !string.IsNullOrWhiteSpace(search)
        || filterKarfarma > 0 || filterTypeFactor > 0 || filterUser > 0 || filterReturned
        || HasAdvancedFilter
        || advancedEntryFrom.HasValue || advancedEntryTo.HasValue || advancedExitFrom.HasValue || advancedExitTo.HasValue
        || advancedTemporaryExitFrom.HasValue || advancedTemporaryExitTo.HasValue || advancedRegistrationFrom.HasValue || advancedRegistrationTo.HasValue
        || advancedCustomerNeedFrom.HasValue || advancedCustomerNeedTo.HasValue || advancedDeliveryFrom.HasValue || advancedDeliveryTo.HasValue
        || advancedFileFrom.HasValue || advancedFileTo.HasValue;

    private async Task ClearColFilters()
    {
        fNum = fName = fSerial = fKarfarma = fEntry = fExit = fFactor = fFactorType = "";
        fKarshenasi = fSabt = fNeed = fSpent = fFolder = fStatus = "";
        presence.Clear();
        advancedEntryFrom = advancedEntryTo = advancedExitFrom = advancedExitTo = advancedTemporaryExitFrom = advancedTemporaryExitTo = null;
        advancedRegistrationFrom = advancedRegistrationTo = advancedCustomerNeedFrom = advancedCustomerNeedTo = advancedDeliveryFrom = advancedDeliveryTo = advancedFileFrom = advancedFileTo = null;
        page = 1;
        await Load();
    }

    // ---------- مرتب‌سازی (صعودی/نزولی) ----------
    private string sortKey = "id";
    private bool sortAsc; // پیش‌فرض: جدیدترین‌ها اول (نزولی بر اساس Id)

    private async Task SortBy(string key)
    {
        if (sortKey == key) sortAsc = !sortAsc;
        else { sortKey = key; sortAsc = true; }
        page = 1;
        await Load(); // مرتب‌سازی هم سمت سرور انجام می‌شود (روی کل رکوردها، نه فقط صفحهٔ جاری)
    }

    private string SortIcon(string key)
        => key != sortKey
            ? "<i class=\"bi bi-arrow-down-up sort-ic muted\"></i>"
            : sortAsc
                ? "<i class=\"bi bi-caret-up-fill sort-ic active\"></i>"
                : "<i class=\"bi bi-caret-down-fill sort-ic active\"></i>";

    // ---------- نمای جدول/کارت (با حفظ انتخاب کاربر) ----------
    private bool viewCards;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                viewCards = (await JS.InvokeAsync<string?>("localStorage.getItem", "projectsViewMode")) == "cards";
                StateHasChanged();
