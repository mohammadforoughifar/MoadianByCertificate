    /// <summary>نمایش بازه زمانی با ارقام فارسی — مثلاً «۱۲:۳۰ ساعت»</summary>
    private static string Fmt(TimeSpan t) =>
        $"{t.HoursFa()} ساعت";

    /// <summary>نمایش کد پروژه با ارقام فارسی — همان‌طور که ثبت شده (بدون جداکننده هزارگان)</summary>
    private static string ShowCode(string? code)
        => string.IsNullOrEmpty(code) ? "—" : Fa.Digits(code);

    /// <summary>کد پروژه در جزئیات/مودال‌ها: کدهای ساده با ارقام فارسی؛ کدهای RE همان لاتین (dir=ltr)</summary>
    private static string ShowDetailCode(ProjectEntryExitDto p)
        => string.IsNullOrWhiteSpace(p.CodeProject)
            ? Fa.Digits(p.Id)
            : (p.ReturnProjectId > 0 || p.CodeProject.StartsWith("RE", StringComparison.OrdinalIgnoreCase))
                ? p.CodeProject
                : Fa.Digits(p.CodeProject);

    /// <summary>نمایش متن با ارقام فارسی یا خط تیره در صورت خالی بودن</summary>
    private static string Dash(string? s)
        => string.IsNullOrWhiteSpace(s) ? "—" : Fa.Digits(s);

    /// <summary>حجم فایل خوانا با ارقام فارسی</summary>
    private static string FormatSize(long b) =>
        Fa.Digits(b < 1024 ? $"{b}B" : b < 1024 * 1024 ? $"{b / 1024}KB" : $"{b / 1024.0 / 1024:0.#}MB");

