    /// <summary>
    /// خواندن «فقط یک صفحه» از سرور — فیلتر، مرتب‌سازی و شمارش همه در دیتابیس انجام می‌شود
    /// تا لیست‌های چندهزارتایی هم سریع باز شوند.
    /// </summary>
    /// <summary>شمارندهٔ نسخهٔ بارگذاری — پاسخ درخواست‌های قدیمی‌تر نادیده گرفته می‌شود.</summary>
    private int loadVersion;

    private CancellationTokenSource? loadCts;

    /// <summary>جستجو/فیلتر در جریان است — جدول و کادر جستجوی سرستون‌ها از صفحه حذف نمی‌شوند.</summary>
    private bool searching;

    /// <summary>
    /// بارگذاری یک صفحه از سرور. <paramref name="blocking"/> فقط برای بارگذاری اولیه true است؛
    /// در جستجوی زنده جدول سرجایش می‌ماند تا فوکوس کادر جستجو از دست نرود و تایپ ادامه پیدا کند.
    /// هر بار درخواست قبلی لغو و پاسخ‌های قدیمی نادیده گرفته می‌شوند.
    /// </summary>
    private async Task Load(bool blocking = false)
    {
        var version = ++loadVersion;

        // لغو درخواست قبلی (بدون Dispose؛ توکنِ در حال استفاده نباید آزاد شود)
        loadCts?.Cancel();
        var cts = new CancellationTokenSource();
        loadCts = cts;

        if (blocking) loading = true; else searching = true;
        try
        {
            var res = await ProjectSvc.GetPagedAsync(BuildQuery(PageSize), cts.Token);
            if (version != loadVersion) return; // پاسخ قدیمی
            items = res.Items;
            total = res.Total;
            pageCount = res.PageCount;
            if (page > pageCount) page = pageCount;
        }
        catch (OperationCanceledException) { /* درخواست تازه‌تر جایش را گرفت */ }
        catch (Exception ex) { if (version == loadVersion) Toast.Error(ex.Message); }
        finally
        {
            if (version == loadVersion) { loading = false; searching = false; }
        }
    }

