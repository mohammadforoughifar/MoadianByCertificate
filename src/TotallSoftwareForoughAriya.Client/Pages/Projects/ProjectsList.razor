    private async Task Delete(ProjectEntryExitDto p)
    {
        CloseMenu();
        var ok = await JS.InvokeAsync<bool>("confirm",
            canApproveChanges
                ? $"آیا از حذف پروژه «{p.ProjectName}» مطمئن هستید؟ گزارش‌های کار و پیوست‌های آن هم حذف می‌شوند."
                : $"درخواست حذف پروژه «{p.ProjectName}» برای تایید مدیر ارسال شود؟ (حذف فقط پس از تایید مدیر انجام می‌شود)");
        if (!ok) return;
        try
        {
            var res = await ProjectSvc.DeleteAsync(p.Id);
            if (res.Pending)
                Toast.Info(string.IsNullOrWhiteSpace(res.Message)
                    ? "درخواست حذف برای تایید مدیر ارسال شد." : res.Message!);
            else
                Toast.Success("پروژه حذف شد.");
            try { lookups = await ProjectSvc.GetLookupsAsync(); } catch { }
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

