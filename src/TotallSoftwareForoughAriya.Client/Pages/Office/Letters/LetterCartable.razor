                                    {
                                        <button type="button" class="att att-zip" @onclick="DownloadAttachmentsZip" title="دانلود کلی همهٔ پیوست‌ها به صورت فایل ZIP">
                                            <div class="ic"><i class="bi bi-file-earmark-zip"></i></div>
