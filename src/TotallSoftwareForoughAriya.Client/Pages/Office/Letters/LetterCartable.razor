    private async Task OnSearchChanged()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, searchCts.Token);
            await ReloadAsync();
        }
        catch (OperationCanceledException) { }
    }

    private void ApplySort()
    {
        // ترتیب نمایش باید با ترتیب بریدگی صفحه در سرور یکی باشد (تاریخ، سپس شناسه)؛
        // وگرنه ردیف‌ها بین صفحه‌ها جابه‌جا می‌شوند و بعضی نامه‌ها عملاً پیدا نمی‌شوند.
        items = sortKey switch
        {
            "date-asc" => items.OrderBy(x => x.Date).ThenBy(x => x.LetterId).ToList(),
            "title-asc" => items.OrderBy(x => x.Title).ToList(),
            "title-desc" => items.OrderByDescending(x => x.Title).ToList(),
            "number-asc" => items.OrderBy(x => x.LetterNumber).ToList(),
            "number-desc" => items.OrderByDescending(x => x.LetterNumber).ToList(),
            _ => items.OrderByDescending(x => x.Date).ThenByDescending(x => x.LetterId).ToList()
        };
    }

