                                }
                                @if (aiTasks != null && aiForLetterId == AiLetterId)
                                {
                                    <div class="ai-res">
                                        <b>اقدام‌ها و مهلت‌ها:</b>
                                        @foreach (var t in aiTasks.Tasks)
                                        {
                                            <div class="ai-task">
                                                <i class="bi bi-check2-square"></i> @t.Action
                                                @if (!string.IsNullOrWhiteSpace(t.AssigneeHint))
                                                {
                                                    <small> — @t.AssigneeHint</small>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(t.DeadlineText))
                                                {
                                                    <span class="tg amber"><i class="bi bi-clock"></i> @t.DeadlineText</span>
