                                            <div class="ic"><i class="bi @FileIcon(aa.FileName)"></i></div>
                                            <div>@aa.FileName<small>@FmtSize(aa.Size) — @aa.UploaderName</small></div>
                                            @if (selected.IsMine || Auth.IsAdmin)
                                            {
                                                <i class="bi bi-x-circle-fill arm" title="حذف پیوست"
                                                   @onclick="() => DeleteAttachment(aa)" @onclick:preventDefault="true" @onclick:stopPropagation="true"></i>
                                            }
                                        </button>
                                    }
