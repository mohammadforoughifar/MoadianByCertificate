    private async Task SetFolder(string f)
    {
        folder = f; filter = "all"; search = ""; openMenuId = 0; page = 1;
        selected = null; selectedItem = null; readerOpen = false;
        if (f == "guide")
        {
            loading = false;
            return;
        }
        await ReloadAsync();
    }

    private async Task SetFilter(string f)
    {
        // همهٔ چیپ‌ها «سمت سرور» اعمال می‌شوند؛ وگرنه فیلتر فقط روی همان ۱۵ ردیف
        // بارگذاری‌شده کار می‌کرد، نامه‌های صفحات بعد هرگز دیده نمی‌شدند و
        // شماره‌گذاری صفحه‌ها هم با فهرست هم‌خوان نبود. تنها استثنا «دستورکارشده» است
        // که فهرست شناسه‌هایش از ماژول دستور کار می‌آید.
        var needsServer = folder != "guide" && f != "workorder" && filter != "workorder";
        filter = f;
        page = 1;
        if (needsServer)
        {
            await ReloadAsync(keepSelection: true, resetPage: true);
            return;
        }
        // «دستورکارشده» روی دادهٔ همین صفحه اعمال می‌شود.
        loading = false;
        StateHasChanged();
    }

