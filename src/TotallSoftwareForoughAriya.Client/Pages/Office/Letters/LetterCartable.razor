                                @if (aiCategory != null && aiForLetterId == AiLetterId)
                                {
                                    <div class="ai-res">
                                        <b>دسته‌بندی:</b> @aiCategory.Category
                                        <span class="tg">اولویت @aiCategory.Priority</span>
