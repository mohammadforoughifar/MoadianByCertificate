@page "/letters"
@using Inventory.Shared.Security
@page "/letters/{Tab}"
@using System.Net.Http.Headers
@inject ILetterService LetterSvc
@inject LetterPrintWorkflow PrintWorkflow
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject LayoutState Layout
@inject RealtimeService Rt
@inject IJSRuntime JS
@inject HttpClient Http
@inject AiAssistantService AiSvc
@implements IDisposable

<PageTitle>کارتابل نامه داخلی</PageTitle>

@* ============================================================
   کارتابل نامه داخلی — طرح مصوب (پروتوتایپ طرح ۱ نسخه ۶):
   ریل پوشه‌ها | لیست نامه‌ها با چیپ فیلتر | صفحه خواندن
   ============================================================ *@

<div class="ltx @(readerOpen ? "rd-open" : "") @(folder == "guide" ? "guide-open" : "")" style="animation:none;transform:none">
    <div class="shell" @onclick="CloseMenus">

        @* ---------- ریل پوشه‌ها ---------- *@
        <nav class="rail">
            <div class="logo"><i class="bi bi-envelope-paper-fill"></i></div>
            <button class="compose" title="نامه جدید" @onclick="OpenCompose"><i class="bi bi-plus-lg"></i></button>
            <div style="height:8px"></div>

            @* عدد روی «دریافتی» = تعداد نامه‌های خوانده‌نشده (متمایز، بدون احتساب نامه‌های بایگانی‌شده) *@
            <button class="@(folder == "inbox" ? "on" : "")" title="@($"دریافتی — {stats.InboxUnread.FaDigits()} نامهٔ خوانده‌نشده")" aria-label="@($"دریافتی، {stats.InboxUnread.FaDigits()} نامهٔ خوانده‌نشده")" @onclick='() => SetFolder("inbox")'>
                <i class="bi bi-inbox-fill"></i>
                @if (stats.InboxUnread > 0) { <span class="rbadge">@stats.InboxUnread.FaDigits()</span> }
            </button>
            <span class="rlbl">دریافتی</span>
            <button class="@(folder == "sent" ? "on" : "")" title="ارسالی" @onclick='() => SetFolder("sent")'><i class="bi bi-send"></i></button>
            <span class="rlbl">ارسالی</span>
            <button class="@(folder == "draft" ? "on" : "")" title="پیش‌نویس" @onclick='() => SetFolder("draft")'><i class="bi bi-pencil-square"></i></button>
            <span class="rlbl">پیش‌نویس</span>
            <button class="@(folder == "starred" ? "on" : "")" title="نشان‌شده" @onclick='() => SetFolder("starred")'><i class="bi bi-star"></i></button>
            <span class="rlbl">نشان‌شده</span>
            <button class="@(folder == "archive" ? "on" : "")" title="بایگانی" @onclick='() => SetFolder("archive")'><i class="bi bi-archive"></i></button>
            <span class="rlbl">بایگانی</span>
            <button class="@(folder == "guide" ? "on" : "")" title="راهنمای نامه داخلی" @onclick='() => SetFolder("guide")'><i class="bi bi-journal-check"></i></button>
            <span class="rlbl">راهنما</span>
            <div class="grow"></div>
        </nav>

        @if (folder == "guide")
        {
            @* راهنمای نامه داخلی داخل خود کارتابل و هم‌سطح پوشه‌های آن *@
            <section class="guide-workspace">
                <InnerLetterGuide OnBack="BackFromGuide" />
            </section>
        }
        else
        {
        @* ---------- لیست ---------- *@
        <section class="pane">
            <div class="pane-head">
                <div class="pane-title">
                    <h1>کارتابل نامه داخلی — @FolderTitle</h1>
                    <span class="sync"><span class="dot"></span> بروزرسانی زنده</span>
                </div>
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input placeholder="@(folder == "archive" ? "جستجو بر اساس موضوع و شماره نامه…" : "جستجو در عنوان، شماره، فرستنده…")" @bind="search" @bind:event="oninput" @bind:after="OnSearchChanged" />
                </div>
                <select class="tin" style="max-width:170px" @bind="sortKey" @bind:after="ApplySort">
                    <option value="date-desc">جدیدترین</option><option value="date-asc">قدیمی‌ترین</option>
                    <option value="title-asc">عنوان صعودی</option><option value="title-desc">عنوان نزولی</option>
                    <option value="number-asc">شماره صعودی</option><option value="number-desc">شماره نزولی</option>
                </select>
                @if (folder != "archive")
                {
                <div class="chips">
                    <button class="chip @(filter == "all" ? "on" : "")" @onclick='() => SetFilter("all")'>همه <span class="n">@ChipAllCount.FaDigits()</span></button>
                    @if (folder != "draft")
                    {
                        @if (folder == "inbox")
                        {
                            <button class="chip @(filter == "unread" ? "on" : "")" @onclick='() => SetFilter("unread")' title="فقط نامه‌های خوانده‌نشده (روی همهٔ صفحات)">خوانده‌نشده <span class="n">@stats.InboxUnread.FaDigits()</span></button>
                        }
                        <button class="chip @(filter == "starred" ? "on" : "")" @onclick='() => SetFilter("starred")'><i class="bi bi-star-fill" style="font-size:10px;color:#eab308"></i> نشان‌شده</button>
                        @if (folder != "sent")
                        {
                            <button class="chip @(filter == "deadline" ? "on" : "")" @onclick='() => SetFilter("deadline")' title="نامه‌های دارای مهلت پاسخ (روی همهٔ صفحات)"><i class="bi bi-clock" style="font-size:10px"></i> مهلت‌دار</button>
                        }
                        <button class="chip @(filter == "attach" ? "on" : "")" @onclick='() => SetFilter("attach")'><i class="bi bi-paperclip" style="font-size:10px"></i> پیوست‌دار</button>
                    <button class="chip @(filter == "workorder" ? "on" : "")" @onclick='() => SetFilter("workorder")' title="نامه‌هایی که دستور کار دارند (در صفحهٔ جاری)"><i class="bi bi-list-task" style="font-size:10px"></i> دستورکارشده</button>
                        @if (selectedErjaIds.Count > 0)
                        {
                            <button class="chip on" style="background:#f59e0b;color:#fff;border-color:#d97706;" @onclick="OpenBatchBayeganiModal">
                                <i class="bi bi-archive-fill me-1"></i> بایگانی گروهی (@selectedErjaIds.Count.FaDigits())
                            </button>
                        }
                    }
                </div>
                }
            </div>
            <div class="list">
                @if (folder == "archive")
                {
                    <BayeganiTree @ref="bayeganiTree" Filter="@search" OnOpenLetter="OpenArchivedLetter" OnChanged="OnArchiveChanged" OnLetterUnarchived="OnLetterUnarchived" />
                }
                else if (loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (folder == "draft")
                {
                    <button class="draft-add" @onclick="() => pishModal?.Open()">
                        <i class="bi bi-plus-lg"></i> افزودن پیش‌نویس
                    </button>
                    @if (drafts.Count == 0)
                    {
                        <div class="empty"><i class="bi bi-pencil-square"></i>پیش‌نویسی ندارید</div>
                    }
                    @foreach (var d in PagedDrafts)
                    {
                        var dd = d;
                        <div class="mail" @onclick="() => OpenDraft(dd)">
                            <div class="avt"><i class="bi bi-pencil"></i></div>
                            <div class="mail-b">
                                <div class="mail-r1"><span class="who">پیش‌نویس</span></div>
                                <div class="mail-tt">@dd.Title</div>
                                <div class="mail-pv">@Preview(dd.Text)</div>
                            </div>
                            <div class="dd">
                                <button @onclick="e => ToggleMenu(-dd.PishnevisId)" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (openMenuId == -dd.PishnevisId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        <button @onclick="() => OpenDraft(dd)"><i class="bi bi-send"></i> ادامه و ارسال</button>
                                        <button @onclick="() => EditDraft(dd)"><i class="bi bi-pencil-square"></i> ویرایش عنوان و متن</button>
                                        <div class="mdiv"></div>
                                        <button class="danger" @onclick="() => DeleteDraft(dd)"><i class="bi bi-trash"></i> حذف پیش‌نویس</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    @if (Filtered.Count == 0)
                    {
                        <div class="empty"><i class="bi bi-inbox"></i>نامه‌ای یافت نشد</div>
                    }
                    string lastDay = "";
                    @foreach (var l in Paged)
                    {
                        var ll = l;
                        var day = ll.Date.ToFaLong();
                        @if (day != lastDay)
                        {
                            lastDay = day;
                            <div class="day">@day</div>
                        }
                        <div class="mail @(folder == "inbox" && !ll.IsRead ? "unread" : "") @(ll.IsNeshan ? "starred" : "") @(selected?.LetterId == ll.LetterId ? "sel" : "")"
                             @onclick="() => OpenLetter(ll)"
                             @oncontextmenu="() => ToggleMenu(ll.LetterId)" @oncontextmenu:preventDefault="true">
                            @if (ll.ErjaId.HasValue && ll.ErjaId.Value > 0)
                            {
                                <div class="me-2 d-flex align-items-center" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@(selectedErjaIds.Contains(ll.ErjaId.Value))" @onchange="() => ToggleSelectErja(ll.ErjaId)" style="width:16px;height:16px;cursor:pointer;" />
                                </div>
                            }
                            @{ var rowIsSent = FolderIsSent || string.IsNullOrEmpty(ll.Sender); }
                            <div class="avt">@AvatarText(rowIsSent ? ll.Reciver : ll.Sender)</div>
                            <div class="mail-b">
                                <div class="mail-r1">
                                    <span class="who">
                                        @(rowIsSent ? "به: " + ll.Reciver + (ll.ReciverCount > 1 ? " +" + (ll.ReciverCount - 1).FaDigits() : "") : ll.Sender)
                                        <i class="bi bi-star-fill star-ico"></i>
                                    </span>
                                    <span class="tm num">@ll.Date.ToFaDateTime()</span>
                                </div>
                                <div class="mail-tt">@ll.Title</div>
                                <div class="tags">
                                    @* لیبل «خوانده‌نشده» — علاوه بر بولد شدن عنوان، وضعیت را صریح نشان می‌دهد *@
                                    @if (folder == "inbox" && !ll.IsRead)
                                    {
                                        <span class="tg unread" title="این نامه هنوز خوانده نشده است"><i class="bi bi-envelope-fill"></i> خوانده‌نشده</span>
                                    }
                                    <span class="tg purple num"># @ll.LetterNumber.FaDigits()</span>
                                    @if (ll.Foriat != "عادی") { <span class="tg red">! @ll.Foriat</span> }
                                    @if (ll.Mahramanegi != "عادی") { <span class="tg dark"><i class="bi bi-lock-fill"></i> @ll.Mahramanegi</span> }
                                    @if (ll.HasAttachment) { <span class="tg gray"><i class="bi bi-paperclip"></i></span> }
                                    @if (workOrderLetterIds.Contains(ll.LetterId)) { <span class="tg green workorder-mark" title="دستورکارشده"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18" aria-label="دستورکارشده"><rect x="7" y="5" width="34" height="38" rx="9" fill="#FFEDD5" stroke="#F97316" stroke-width="2.5"/><rect x="17" y="2" width="14" height="7" rx="3.5" fill="#F97316"/><g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M13 18l2.5 2.5 4.5-5.5" stroke="#EA580C"/><path d="M13 27l2.5 2.5 4.5-5.5" stroke="#EA580C"/><circle cx="16" cy="35" r="2.8" stroke="#FDBA74"/><path d="M25 18h9M25 27h9M25 35h6" stroke="#FDBA74"/></g></svg></span> }
                                    @if (ll.MohlatPasokh is { } mp) { <span class="tg amber"><i class="bi bi-clock"></i> مهلت: @mp.ToFa()</span> }
                                    @if (ll.TypeTaeed == 1) { <span class="tg green"><i class="bi bi-check2-all"></i> تایید شد</span> }
                                    else if (ll.TypeTaeed == 2) { <span class="tg red"><i class="bi bi-x-lg"></i> رد شد</span> }
                                    else if (ll.HasAnswer) { <span class="tg green"><i class="bi bi-check2-all"></i> پاسخ داده شد</span> }
                                    @if (!string.IsNullOrEmpty(ll.ErjaType) && ll.ErjaType != "گیرنده") { <span class="tg gray">@ll.ErjaType</span> }
                                </div>
                            </div>
                            <div class="dd">
                                <button @onclick="() => ToggleMenu(ll.LetterId)" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (openMenuId == ll.LetterId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        @if (FolderIsSent)
                                        {
                                            <button @onclick="() => EditLetter(ll.LetterId)"><i class="bi bi-pencil-square"></i> ویرایش</button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => MenuReply(ll)"><i class="bi bi-reply"></i> پاسخ</button>
                                        }
                                        @if (CanErja)
                                        {
                                            <button @onclick="() => MenuErja(ll)"><i class="bi bi-arrow-left-circle"></i> ارجاع / هامش</button>
                                        }
                                        <button @onclick="() => ToggleStar(ll)">
                                            <i class="bi @(ll.IsNeshan ? "bi-star-fill" : "bi-star")" style="@(ll.IsNeshan ? "color:#eab308" : "")"></i>
                                            @(ll.IsNeshan ? "حذف نشان" : "نشان‌کردن")
                                        </button>
                                        <div class="mdiv"></div>
                                        <button @onclick="() => MenuGardesh(ll)"><i class="bi bi-diagram-3"></i> گردش نامه</button>
                                        <button class="lbtn ghost" @onclick="() => TogglePrintMenu(ll)" @onclick:stopPropagation="true"><i class="bi bi-printer"></i> چاپ</button>
                                        @if (printMenuOpen && printMenuLetterId == ll.LetterId)
                                        {
                                            <div class="ltmenu" @onclick:stopPropagation="true">
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA4, false); }"><i class="bi bi-file-earmark"></i> A4 — بدون هامش</button>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA4, true); }"><i class="bi bi-file-earmark"></i> A4 — با هامش</button>
                                                <div class="mdiv"></div>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA5, false); }"><i class="bi bi-file-earmark"></i> A5 — بدون هامش</button>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA5, true); }"><i class="bi bi-file-earmark"></i> A5 — با هامش</button>
                                            </div>
                                        }
                                        <button class="warn" @onclick="() => ToggleArchive(ll)">
                                            <i class="bi bi-archive"></i> بایگانی <small style="opacity:.55;margin-inline-start:auto">Ctrl+Shift+B</small>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* ---------- صفحه‌بندی ---------- *@
            @if (folder != "archive" && PageCount > 1)
            {
                <div class="lt-pager">
                    <button class="pgbtn" disabled="@(page <= 1)" @onclick="() => GoPage(1)"><i class="bi bi-chevron-double-left"></i></button>
                    <button class="pgbtn" disabled="@(page <= 1)" @onclick="() => GoPage(page - 1)"><i class="bi bi-chevron-left"></i></button>
                    @foreach (var p in PageNumbers)
                    {
                        var pp = p;
                        <button class="pgbtn @(pp == page ? "on" : "")" @onclick="() => GoPage(pp)">@pp.FaDigits()</button>
                    }
                    <button class="pgbtn" disabled="@(page >= PageCount)" @onclick="() => GoPage(page + 1)"><i class="bi bi-chevron-right"></i></button>
                    <button class="pgbtn" disabled="@(page >= PageCount)" @onclick="() => GoPage(PageCount)"><i class="bi bi-chevron-double-right"></i></button>
                    <div class="pg-jump">
                        <label>رفتن به صفحه: </label>
                        <input type="number" @bind="jumpPage" min="1" max="@PageCount" style="width:50px" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoPage(jumpPage)"><i class="bi bi-arrow-right"></i></button>
                    </div>
                    <span class="pginfo">@TotalCount.FaDigits() نامه — صفحه @(page.FaDigits()) از @PageCount.FaDigits()</span>
                </div>
            }
        </section>

        @* ---------- ریدر ---------- *@
        <main class="reader">
            <div class="rd-top">
                <button class="icb rd-back" title="بازگشت به لیست" @onclick="CloseReader"><i class="bi bi-arrow-right"></i></button>
                <span class="t">@(selected?.Title ?? "—")</span>
                @if (selected != null)
                {
                    @if (selected.MyErja != null || selected.IsMine)
                    {
                        <button class="icb @(ReaderStarOn ? "gold" : "")" title="نشان‌کردن" @onclick="ToggleStarReader">
                            <i class="bi @(ReaderStarOn ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    }
                    <button class="icb" title="@(folder == "archive" ? "خروج از بایگانی (Ctrl+Shift+B)" : "بایگانی (Ctrl+Shift+B)")" data-hotkey="ctrl+shift+b" @onclick="ArchiveCurrent"><i class="bi bi-archive"></i></button>
                    <span class="print-wr">
                        <button class="lbtn ghost" title="چاپ نامٔ داخلی روی سربرگ" disabled="@printingPdf" @onclick="TogglePrintSelected" @onclick:stopPropagation="true"><i class="bi bi-printer"></i> چاپ</button>
                        @if (printMenuOpen)
                        {
                            <div class="ltmenu" @onclick:stopPropagation="true">
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA4, false); }"><i class="bi bi-file-earmark"></i> A4 — بدون هامش</button>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA4, true); }"><i class="bi bi-file-earmark"></i> A4 — با هامش</button>
                                <div class="mdiv"></div>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA5, false); }"><i class="bi bi-file-earmark"></i> A5 — بدون هامش</button>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA5, true); }"><i class="bi bi-file-earmark"></i> A5 — با هامش</button>
                            </div>
                        }
                    </span>
                    <button class="icb" title="کپی نامه" @onclick="CopyLetter"><i class="bi bi-files"></i></button>
                    @if (selected.CanEdit)
                    {
                        <button class="icb" title="ویرایش" @onclick="() => EditLetter(selected.LetterId)"><i class="bi bi-pencil-square"></i></button>
                    }
                    @if (selected.MyErja != null)
                    {
                        <button class="lbtn ghost" @onclick="OpenReply"><i class="bi bi-reply"></i> پاسخ</button>
                    }
                    @if (CanErja && (selected.IsMine || selected.MyErja != null))
                    {
                        <button class="lbtn pri" @onclick="OpenErjaSheet"><i class="bi bi-arrow-left-circle"></i> ارجاع / هامش</button>
                    }
                    @* ---------- اتصال به دستور کار ---------- *@
                    @* نامه‌ای که قبلاً دستورکار شده هم باید بتواند دوباره دستورکار بگیرد؛
                       بنابراین دکمهٔ «افزودن دستورکار» در کنار گزارشِ دستورکارهای موجود
                       نمایش داده می‌شود و دیگر پنهان نمی‌شود. *@
                    @if (woLoaded && CanConvertToWorkOrder)
                    {
                        <button class="lbtn pri"
                                title="@(IsConverted ? "افزودن دستورکار جدید از این نامه" : "تبدیل این نامه به دستور کار")"
                                @onclick="ConvertToWorkOrder">
                            <i class="bi @(IsConverted ? "bi-plus-circle" : "bi-arrow-right-circle")"></i>
                            @(IsConverted ? "افزودن دستورکار" : "تبدیل به دستور کار")
                        </button>
                    }
                    @if (IsConverted)
                    {
                        <button class="lbtn grn" title="نمایش گزارش دستورکارهای این نامه" @onclick="ToggleWorkOrderReport">
                            <i class="bi bi-list-task"></i> دستورکار شده (@WorkOrderCount)
                        </button>
                    }
                }
            </div>
            @if (showWorkOrderReport && IsConverted)
            {
                <section class="wo-report" aria-label="گزارش دستورکارهای نامه">
                    <div class="wo-report-head">
                        <strong><i class="bi bi-list-task"></i> گزارش دستورکارهای این نامه</strong>
                        <button class="icb" title="بستن" @onclick="ToggleWorkOrderReport"><i class="bi bi-x"></i></button>
                    </div>
                    <div class="wo-report-summary">این نامه تاکنون <b>@WorkOrderCount</b> بار دستورکار شده است.</div>
                    @foreach (var wo in letterWorkOrders)
                    {
                        <div class="wo-report-row">
                            <div><b>@wo.Number</b> — @wo.Title</div>
                            <div class="wo-report-meta">
                                <span><i class="bi bi-person"></i> @(wo.AssigneeCount) نفر</span>
                                @if (wo.Assignees.Count > 0) { <span>@string.Join("، ", wo.Assignees)</span> }
                                <span class="badge">@wo.Status</span>
                                <button class="lbtn ghost" @onclick="() => GoToWorkOrder(wo.Id)">مشاهده دستورکار</button>
                            </div>
                        </div>
                    }
                </section>
            }
            <div class="rd-scroll">
                @if (selected == null)
                {
                    <div class="empty" style="grid-column:1/-1"><i class="bi bi-envelope-open"></i>نامه‌ای انتخاب نشده است</div>
                }
                else
                {
                    <div>
                        <div class="paper">
                            <div class="paper-h">
                                <div class="avt">@AvatarText(selected.SenderName)</div>
                                <div class="ph-meta">
                                    <div class="n1">@selected.SenderName</div>
                                    <div class="n2">فرستنده @(selected.IsMine ? "(شما)" : "")</div>
                                </div>
                                <div class="ind">
                                    <div class="no num"># @selected.LetterNumber.FaDigits()</div>
                                    <div class="dt">@selected.DateSabt.ToFaDateTime()</div>
                                </div>
                            </div>
                            <div class="paper-body letter-body">@((MarkupString)RichLetterHtml.Sanitize(selected.Text ?? "—"))</div>
                            @* بخش پیوست‌ها باید «همیشه» برای هر کاربرِ حاضر در گردش (فرستنده/گیرنده) یا مدیر
                               دیده شود — حتی اگر نامه هنوز پیوستی نداشته باشد تا دکمه افزودن در دسترس بماند *@
                            @if (attachments.Count > 0 || selected.IsMine || selected.MyErja != null || Auth.IsAdmin)
                            {
                                <div class="paper-foot">
                                    @foreach (var a in attachments)
                                    {
                                        var aa = a;
