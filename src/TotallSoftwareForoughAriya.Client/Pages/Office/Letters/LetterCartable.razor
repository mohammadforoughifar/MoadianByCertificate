                        @* 🤖 دستیار نامه — خلاصه، پیشنهاد ارجاع، اقدام‌ها، دسته‌بندی، پیش‌نویس پاسخ *@
                        @if (Auth.IsAdmin || Auth.Has("AiAssistant.Use"))
                        {
                            <div class="ai-card">
                                <div class="ai-head">
                                    <b><i class="bi bi-robot"></i> دستیار نامه</b>
                                    <div class="ai-btns">
                                        <button class="lbtn ghost" disabled="@aiBusy" @onclick="AiSummarize">خلاصه</button>
                                        <button class="lbtn ghost" disabled="@aiBusy" @onclick="AiSuggest">پیشنهاد ارجاع</button>
                                        <button class="lbtn ghost" disabled="@aiBusy" @onclick="AiTasks">اقدام‌ها و مهلت‌ها</button>
                                        <button class="lbtn ghost" disabled="@aiBusy" @onclick="AiCategorize">دسته‌بندی</button>
                                        <button class="lbtn ghost" disabled="@aiBusy" @onclick="AiDraftReply">✍️ پیش‌نویس پاسخ</button>
                                    </div>
                                </div>
                                @if (aiBusy)
                                {
                                    <div class="ai-status-line"><span class="spinner-border spinner-border-sm"></span> در حال پردازش…</div>
