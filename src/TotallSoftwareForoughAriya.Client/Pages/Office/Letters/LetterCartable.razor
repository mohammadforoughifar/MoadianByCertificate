        if (item.ErjaId == null && selected.MyErja != null && !selected.IsMine)
            item.ErjaId = selected.MyErja.ErjaId;
        await ToggleArchive(item);
    }

    /// <summary>باز کردن نامه از درخت بایگانی</summary>
    private async Task OpenArchivedLetter(BayeganiNodeDto n)
    {
        if (n.LetterId is not { } lid) return;
        selectedItem = new InnerLetterListItemDto
        {
            LetterId = lid,
            ErjaId = n.ErjaId,
            LetterNumber = n.LetterNumber ?? "",
            Title = n.Title,
            Sender = n.Sender ?? "",
            Date = n.Date ?? DateTime.Now
        };
        await LoadDetailAsync(lid);
        readerOpen = true;
    }

    private async Task OnArchiveChanged() => stats = await LetterSvc.GetStatsAsync();

    // ==================== پیوست‌ها در ریدر ====================

    private bool attUploading;

    /// <summary>افزودن پیوست جدید به نامه باز در ریدر — فرستنده یا گیرنده حاضر در گردش</summary>
    private async Task OnReaderFiles(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (selected == null || attUploading) return;
        attUploading = true;
        try
        {
            foreach (var f in e.GetMultipleFiles(int.MaxValue))
            {
                if (f.Size <= 0) { Toast.Error($"فایل «{f.Name}» خالی است."); continue; }
                if (f.Size > 20 * 1024 * 1024) { Toast.Error($"فایل «{f.Name}» بزرگ‌تر از ۲۰ مگابایت است."); continue; }
                try
                {
                    await using var stream = f.OpenReadStream(long.MaxValue);
                    await LetterSvc.UploadAttachmentAsync(selected.LetterId, stream, f.Name, f.ContentType);
                }
                catch (Exception ex) { Toast.Error($"«{f.Name}»: {ex.Message}"); }
            }
            attachments = await LetterSvc.GetAttachmentsAsync(selected.LetterId);
            Toast.Success("پیوست‌ها بروزرسانی شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { attUploading = false; }
    }

    private async Task PreviewOrDownloadAttachmentAsync(LetterAttachmentDto a)
    {
        var previewable = (a.ContentType ?? "").StartsWith("image/", StringComparison.OrdinalIgnoreCase)
                          || a.ContentType is "application/pdf" or "text/plain";
        if (!previewable) { await DownloadAttachmentAsync(a); return; }
        try
        {
            var bytes = await Http.GetByteArrayAsync(LetterSvc.AttachmentDownloadUrl(a.Id));
            await JS.InvokeVoidAsync("openBlob", a.ContentType ?? "application/octet-stream", Convert.ToBase64String(bytes));
        }
        catch { await DownloadAttachmentAsync(a); }
    }

    private async Task DownloadAttachmentAsync(LetterAttachmentDto a)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(LetterSvc.AttachmentDownloadUrl(a.Id));
            await JS.InvokeVoidAsync("downloadBlob", a.FileName, a.ContentType ?? "application/octet-stream", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Toast.Error($"دانلود پیوست انجام نشد: {ex.Message}"); }
    }

    /// <summary>دانلود کلی همهٔ پیوست‌های نامه داخلی به صورت فایل ZIP</summary>
    private async Task DownloadAttachmentsZip()
    {
        if (selected == null) return;
        try
        {
            var bytes = await LetterSvc.DownloadAttachmentsZipAsync(selected.LetterId);
            await JS.InvokeVoidAsync("downloadBlob", $"inner-letter-{selected.LetterNumber}-attachments.zip", "application/zip", Convert.ToBase64String(bytes));
            Toast.Success("همهٔ پیوست‌ها به صورت فایل ZIP دانلود شدند.");
        }
        catch (Exception ex) { Toast.Error($"دانلود کلی پیوست‌ها انجام نشد: {ex.Message}"); }
    }

    /// <summary>حذف پیوست از نامه باز در ریدر</summary>
    private async Task DeleteAttachment(LetterAttachmentDto a)
    {
        if (selected == null) return;
        try
        {
            await LetterSvc.DeleteAttachmentAsync(a.Id);
            attachments = await LetterSvc.GetAttachmentsAsync(selected.LetterId);
            Toast.Success("پیوست حذف شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>وقتی نامه‌ای از داخل درخت از بایگانی خارج شد، اگر همان نامه در ریدر باز است ببند</summary>
    private void OnLetterUnarchived(BayeganiNodeDto n)
    {
        if (n.LetterId is { } lid && (selected?.LetterId == lid || selectedItem?.LetterId == lid))
        {
            selected = null; selectedItem = null; readerOpen = false;
            StateHasChanged();
        }
    }

    // ==================== پاسخ ====================

    private void OpenReply()
    {
        if (selected?.MyErja == null) { Toast.Error("شما گیرنده این نامه نیستید."); return; }
        replyText = selected.MyErja.Answer ?? "";
        replyPrivate = !selected.MyErja.ShowForAll && !string.IsNullOrEmpty(selected.MyErja.Answer);
        pendingAnswerType = 0;
        replyOpen = true;
    }

    private void QuickAnswer(int typeTaeed)
    {
        if (selected?.MyErja is not { } my) return;
        replyText = "";
        replyPrivate = false;
        pendingAnswerType = typeTaeed;
        // ابتدا متن پاسخ از کاربر گرفته می‌شود؛ ثبت فقط بعد از زدن دکمه تأیید مودال انجام می‌شود.
        replyOpen = true;
    }

    private async Task SubmitReply(int typeTaeed)
    {
        if (string.IsNullOrWhiteSpace(replyText)) { Toast.Error("متن پاسخ را بنویسید."); return; }
        await SubmitAnswerCore(replyText, replyPrivate, typeTaeed);
        replyOpen = false;
    }

    private async Task SubmitAnswerCore(string text, bool isPrivate, int typeTaeed)
    {
        if (selected?.MyErja is not { } my) return;
        busy = true;
        try
        {
            await LetterSvc.AnswerAsync(my.ErjaId, new AnswerErjaDto
            {
                Answer = text,
                ShowForAll = !isPrivate,
                TypeTaeed = typeTaeed
            });
            Toast.Success(typeTaeed == 1 ? "نامه تایید و پاسخ ثبت شد." : typeTaeed == 2 ? "نامه رد شد." : "پاسخ ثبت شد.");
            await LoadDetailAsync(selected.LetterId);
            await ReloadAsync(keepSelection: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    // ==================== ارجاع / هامش ====================

    private void OpenErjaSheet()
    {
        if (selected == null) return;
        erjaSheet?.Open(selected.LetterId, selected.LetterNumber, selected.MyErja?.ErjaId);
    }

    private async Task OnErjaSubmitted()
    {
        // گردش باید همه‌جا به‌روز شود: ریدر + لیست + مودال گردش دفعه بعد
        if (selected != null) await LoadDetailAsync(selected.LetterId);
        await ReloadAsync(keepSelection: true);
        StateHasChanged();
    }

    // ==================== 🤖 دستیار نامه ====================

    private bool aiBusy;
    private string aiErr = "";
    private int aiForLetterId;
    private AiLetterSummary? aiSummary;
    private AiReferralResponse? aiSuggest;
    private AiLetterTasks? aiTasks;
    private AiLetterCategory? aiCategory;

    private int? AiLetterId => selected?.LetterId;

    private async Task AiSummarize()
    {
        if (AiLetterId is not { } id || aiBusy) return;
        aiBusy = true; aiErr = ""; aiForLetterId = id;
        try { aiSummary = await AiSvc.SummarizeLetterAsync(id); }
        catch (Exception ex) { aiErr = ex.Message; }
        finally { aiBusy = false; }
    }

    private async Task AiSuggest()
    {
        if (AiLetterId is not { } id || aiBusy) return;
        aiBusy = true; aiErr = ""; aiForLetterId = id;
        try { aiSuggest = await AiSvc.SuggestReferralAsync(id); }
        catch (Exception ex) { aiErr = ex.Message; }
        finally { aiBusy = false; }
    }

    private async Task AiTasks()
    {
        if (AiLetterId is not { } id || aiBusy) return;
        aiBusy = true; aiErr = ""; aiForLetterId = id;
        try { aiTasks = await AiSvc.ExtractTasksAsync(id); }
        catch (Exception ex) { aiErr = ex.Message; }
        finally { aiBusy = false; }
    }

    private async Task AiCategorize()
    {
        if (AiLetterId is not { } id || aiBusy) return;
        aiBusy = true; aiErr = ""; aiForLetterId = id;
        try { aiCategory = await AiSvc.CategorizeLetterAsync(id); }
        catch (Exception ex) { aiErr = ex.Message; }
        finally { aiBusy = false; }
    }

    private async Task AiDraftReply()
    {
        var sel = selected;
        if (sel == null || aiBusy) return;
        var id = sel.LetterId;
        aiBusy = true; aiErr = ""; aiForLetterId = id;
        try
        {
            var draft = await AiSvc.DraftReplyAsync(id, null);
            if (sel.IsMine || sel.SenderUserId <= 0)
                compose?.Open(draft.Subject, draft.BodyHtml);
            else
                compose?.OpenReply(draft.Subject, draft.BodyHtml, sel.SenderUserId,
                    sel.LetterId, sel.LetterNumber, sel.Title);
            if (draft.UsedFallback) Toast.Info("پیش‌نویس پاسخ (حالت آفلاین) باز شد؛ متن را بازبینی کن.");
        }
        catch (Exception ex) { aiErr = ex.Message; }
        finally { aiBusy = false; }
    }

    public void Dispose() => Rt.DataChanged -= OnDataChanged;

    // ==================== مدل‌ها ====================
