    }

    private async Task ReloadAsync() { await ReloadAsync(false, true); }

    private async Task ReloadAsync(bool keepSelection, bool resetPage = true)
    {
        if (resetPage) page = 1;
        loading = true;
        try
        {
            if (folder == "guide")
            {
                // راهنما دادهٔ کارتابل ندارد؛ فقط شمارنده ریل را تازه نگه می‌داریم.
                stats = await LetterSvc.GetStatsAsync();
                totalServerCount = 0;
                return;
            }

            var s = string.IsNullOrWhiteSpace(search) ? null : search;
            var unread = filter == "unread" ? (bool?)true : null;
            var starredOnly = filter == "starred" ? (bool?)true : null;
            var attachOnly = filter == "attach" ? (bool?)true : null;
            var deadlineOnly = filter == "deadline" ? (bool?)true : null;
            if (folder == "draft")
            {
                var draftPage = await LetterSvc.GetPishnevisPageAsync((page - 1) * PageSize, PageSize, s);
                drafts = draftPage.Items;
                totalServerCount = draftPage.TotalCount;
            }
            else
            {
                PagedResult<InnerLetterListItemDto> res;
                switch (folder)
                {
                    case "sent":
                        res = await LetterSvc.GetSentAsync(s, page, PageSize, starredOnly, attachOnly);
                        break;
                    case "archive":
                        res = await LetterSvc.GetArchiveAsync(s, page, PageSize);
                        break;
                    case "starred":
                        var starredInbox = await LetterSvc.GetInboxAsync(s, null, page, PageSize, starredOnly: true);
                        var starredSent = await LetterSvc.GetSentAsync(s, page, PageSize, starredOnly: true);
                        res = new PagedResult<InnerLetterListItemDto>
                        {
                            Items = starredInbox.Items.Concat(starredSent.Items).Where(x => x.IsNeshan).ToList(),
                            TotalCount = starredInbox.Items.Count(x => x.IsNeshan) + starredSent.Items.Count(x => x.IsNeshan),
                            Page = page, PageSize = PageSize
                        };
                        break;
                    default:
                        res = await LetterSvc.GetInboxAsync(s, unread, page, PageSize, starredOnly, attachOnly, deadlineOnly);
                        break;
                }
                items = res.Items;
                try { workOrderLetterIds = (await Http.GetFromJsonAsync<List<int>>("/api/workorders/source-ids?module=InnerLetter") ?? new()).ToHashSet(); } catch { workOrderLetterIds.Clear(); }
                totalServerCount = res.TotalCount;
                ApplySort();
            }
            stats = await LetterSvc.GetStatsAsync();
            if (keepSelection && selected != null)
            {
                selectedItem = items.FirstOrDefault(l => l.LetterId == selected.LetterId) ?? selectedItem;
            }
        }
        catch (Exception ex) { if (!_openingFromLink) Toast.Error(ex.Message); }
        finally { loading = false; }
    }

