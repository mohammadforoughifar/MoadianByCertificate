                                        <label class="att att-add" title="افزودن پیوست جدید">
                                            <div class="ic"><i class="bi @(attUploading ? "bi-hourglass-split" : "bi-plus-lg")"></i></div>
                                            <div>@(attUploading ? "در حال بارگذاری…" : "افزودن پیوست")<small>حداکثر ۲۰ مگابایت</small></div>
                                            <InputFile OnChange="OnReaderFiles" multiple disabled="@attUploading" style="display:none" />
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        @* دستور ارجاع برای من *@
                        @if (selected.MyErja is { } my && my.Type != "گیرنده" && !string.IsNullOrWhiteSpace(my.MatnErja))
                        {
