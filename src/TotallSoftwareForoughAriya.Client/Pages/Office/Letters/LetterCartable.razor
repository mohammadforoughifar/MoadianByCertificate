    @if (batchBayeganiModalOpen)
    {
        <div class="gov" @onclick="() => batchBayeganiModalOpen = false">
            <div class="gmodal" style="width:min(480px,96vw)" @onclick:stopPropagation="true">
                <div class="gm-h">
                    <div class="ttl"><b><i class="bi bi-archive" style="color:var(--p2)"></i> بایگانی گروهی نامه‌ها</b><small>@selectedErjaIds.Count.FaDigits() نامه انتخاب شده است</small></div>
                    <button class="x" @onclick="() => batchBayeganiModalOpen = false"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="gm-b">

                </div>
                <div class="gm-f">
                    <button class="lbtn ghost" @onclick="() => batchBayeganiModalOpen = false">انصراف</button>
                    <button class="lbtn pri" disabled="@busy" @onclick="SubmitBatchBayegani"><i class="bi bi-folder2-open"></i> انتخاب پوشه و بایگانی</button>
                </div>
            </div>
