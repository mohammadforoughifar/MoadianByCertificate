</div>

<ComposeLetterModal @ref="compose" OnSent="OnComposed" />
<ErjaSheet @ref="erjaSheet" OnSubmitted="OnErjaSubmitted" />
<GardeshModal @ref="gardesh" />
<BayeganiFolderPickerModal @ref="folderPicker" />
<PishnevisModal @ref="pishModal" OnSaved="OnDraftSaved" />
<LetterConfirmModal @ref="confirmModal" />

@code {
    [Parameter] public string? Tab { get; set; }

    // اندازهٔ چاپ — به‌صورت ثابت تعریف می‌شود تا داخل صفت‌های HTML
    // نیازی به نوشتن رشتهٔ داخل کوتیشن نباشیم (در Razor بک‌اسلش داخل صفت HTML معتبر نیست).
    private const string SizeA4 = "A4";
    private const string SizeA5 = "A5";

    private HashSet<int> selectedErjaIds = new();
    private bool batchBayeganiModalOpen;
    private string batchBayeganiNote = "";

    private void ToggleSelectErja(int? erjaId)
    {
        if (!erjaId.HasValue || erjaId.Value <= 0) return;
        var id = erjaId.Value;
        if (selectedErjaIds.Contains(id)) selectedErjaIds.Remove(id);
        else selectedErjaIds.Add(id);
    }

    private void OpenBatchBayeganiModal()
    {
        if (selectedErjaIds.Count == 0) return;
        batchBayeganiNote = "";
        batchBayeganiModalOpen = true;
    }

    private async Task SubmitBatchBayegani()
    {
        if (selectedErjaIds.Count == 0) return;
        busy = true;
        try
        {
            if (folderPicker == null) return;
            var destination = await folderPicker.PickAsync("انتخاب پوشه برای بایگانی گروهی");
            if (destination is not { } folderId || folderId <= 0) return;
            await LetterSvc.ArchiveLettersAsync(new ArchiveLettersDto
            {
                FolderId = folderId,
                ErjaIds = selectedErjaIds.ToList(),
                Title = string.IsNullOrWhiteSpace(batchBayeganiNote) ? null : batchBayeganiNote.Trim()
            });
            Toast.Success($"{selectedErjaIds.Count.FaDigits()} نامه با موفقیت بایگانی شدند.");
            selectedErjaIds.Clear();
            batchBayeganiModalOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private string folder = "inbox";
    private string filter = "all";
    private string search = "";
    private string sortKey = "date-desc";
    private CancellationTokenSource? searchCts;
    private bool loading = true;
    private bool busy;
    private bool readerOpen;
    private int openMenuId;

    private List<InnerLetterListItemDto> items = new();
    private HashSet<int> workOrderLetterIds = new();
    private List<PishnevisDto> drafts = new();
    private LetterCartableStatsDto stats = new();

    private InnerLetterDetailDto? selected;
    private InnerLetterListItemDto? selectedItem;
    private List<LetterAttachmentDto> attachments = new();

    private bool replyOpen;
    private string replyText = "";
    private bool replyPrivate;
    private int pendingAnswerType; // 0=پاسخ عادی، 1=تایید، 2=رد

    private ComposeLetterModal? compose;
    private ErjaSheet? erjaSheet;
    private GardeshModal? gardesh;
    private BayeganiFolderPickerModal? folderPicker;
    private PishnevisModal? pishModal;
    private LetterConfirmModal? confirmModal;
    private BayeganiTree? bayeganiTree;

    // دستور کارِ ساخته‌شده از نامه (برای نشان «دستورکار شده» و لینک)
    private List<WoSourceItem> letterWorkOrders = new();
    private bool woLoaded;
    private bool showWorkOrderReport;
    private int WorkOrderCount => letterWorkOrders.Count;

    private void ToggleWorkOrderReport() => showWorkOrderReport = !showWorkOrderReport;

    private bool CanErja => Auth.Has("InnerLetters.Erja");
    private bool FolderIsSent => folder == "sent";

    // تبدیل نامه به دستور کار: فقط فرستنده یا مدیر، و داشتن مجوز ایجاد دستور کار
    private bool CanConvertToWorkOrder =>
        (selected?.IsMine == true || selected?.MyErja != null || Auth.IsAdmin) && Auth.Has("WorkOrders.Create");
    private bool IsConverted => letterWorkOrders.Count > 0;

    /// <summary>لینک منبع نامه در صفحه دستور کار — برای نمایش در لیست دستور کارها</summary>
    public const string SourceModule = "InnerLetter";

    private string FolderTitle => folder switch
    {
        "sent" => "ارسالی", "draft" => "پیش‌نویس‌ها", "starred" => "نشان‌شده‌ها",
        "archive" => "بایگانی", "guide" => "راهنما", _ => "دریافتی"
    };

    private List<InnerLetterListItemDto> BaseItems =>
        folder == "starred" ? items.Where(l => l.IsNeshan).ToList() : items;

    /// <summary>
    /// فیلترهای «خوانده‌نشده / نشان‌شده / مهلت‌دار / پیوست‌دار» <b>سمت سرور</b> اعمال می‌شوند
    /// (روی همهٔ نامه‌های کاربر، نه فقط ۱۵ ردیف صفحهٔ جاری). پیش‌تر این فیلترها فقط روی
    /// صفحهٔ بارگذاری‌شده کار می‌کردند و نامه‌های بقیهٔ صفحه‌ها بی‌صدا ناپدید می‌شدند؛
    /// کاربر با جستجو همان نامه را پیدا می‌کرد و فکر می‌کرد نامه از کارتابل حذف شده است.
    /// تنها «دستورکارشده» در همین صفحه فیلتر می‌شود، چون فهرست شناسه‌های آن از ماژول
    /// دستور کار می‌آید و پارامتر سروری ندارد.
    /// </summary>
    private List<InnerLetterListItemDto> Filtered
    {
        get
        {
            var arr = BaseItems;
            if (filter == "workorder") arr = arr.Where(l => workOrderLetterIds.Contains(l.LetterId)).ToList();
            return arr;
        }
    }

    /// <summary>عدد چیپ «همه» — برای دریافتی از شمارندهٔ سرور و برای بقیهٔ پوشه‌ها از تعداد کل سرور (نه ۱۵ ردیف صفحه).</summary>
    private int ChipAllCount => filter == "all"
        ? (folder == "inbox" ? stats.InboxTotal : totalServerCount)
        : BaseItems.Count;

    private List<PishnevisDto> FilteredDrafts => drafts;

    // ==================== صفحه‌بندی ====================

    private const int PageSize = 15;
    private int page = 1;
    private int totalServerCount = 0;

    private int TotalCount => totalServerCount;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));

    private List<InnerLetterListItemDto> Paged => Filtered;

    private List<PishnevisDto> PagedDrafts =>
        drafts;

    private int jumpPage;

    private IEnumerable<int> PageNumbers
    {
        get
        {
            // نمایش 7 صفحه حول صفحه فعلی برای ناوبری راحت‌تر در پرچند بودن نامه‌ها
            int start = Math.Max(1, page - 3), end = Math.Min(PageCount, page + 3);
            for (int i = start; i <= end; i++) yield return i;
        }
    }

    private void GoPage(int p)
    {
        if (p < 1 || p > PageCount || p == page) return;
        page = p;
        _ = InvokeAsync(async () => { await ReloadAsync(keepSelection: true, resetPage: false); StateHasChanged(); });
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("کارتابل نامه داخلی");
        Rt.DataChanged += OnDataChanged;

        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);

        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (!string.IsNullOrEmpty(Tab) && Tab is "inbox" or "sent" or "draft" or "starred" or "archive" or "guide")
            folder = Tab;

        // باز کردن مستقیم یک نامه (لینک نوتیفیکیشن یا «نامه» در دستور کار): letters?open=ID
        // اگر کاربر در گردش همین نامه باشد ولی مجوز عمومی کارتابل را نداشته باشد،
        // بارگذاری فهرست خطا می‌دهد؛ در این حالت پیام خطا نمایش داده نمی‌شود و نامه باز می‌شود.
        var hasOpenParam = int.TryParse(qs["open"], out var openId) && openId > 0;
        _openingFromLink = hasOpenParam;
        await ReloadAsync();
        _openingFromLink = false;
        if (hasOpenParam)
            await OpenById(openId);

        if (qs["compose"] == "1" && qs["source"] == "MeetingMinutes" && int.TryParse(qs["sourceId"], out var minId) && minId > 0 && !_composeHandled)
        {
            _composeHandled = true;
            await OpenComposeFromMinutesAsync(minId, int.TryParse(qs["itemId"], out var itmId) && itmId > 0 ? itmId : null);
        }
    }

    private bool _composeHandled;
    /// <summary>در حال باز کردن نامه از لینک مستقیم هستیم — خطای فهرست بی‌صدا رد می‌شود.</summary>
    private bool _openingFromLink;
    private async Task OpenComposeFromMinutesAsync(int minutesId, int? itemId)
    {
        try
        {
            var m = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.MinutesDetailDto>($"/api/meeting-minutes/{minutesId}");
            if (m != null)
            {
                if (itemId.HasValue)
                {
                    var item = m.Items.FirstOrDefault(i => i.Id == itemId.Value);
                    var rowNo = item?.RowNo ?? 1;
                    var title = $"پیگیری بند {rowNo} صورتجلسه «{m.Title}»";
                    var body = $"<p>با سلام و احترام،</p>" +
                               $"<p>پیرو صورتجلسه <b>«{m.Title}»</b> مورخ {PersianDate.ToShortFa(m.MeetingDate)}، بند شماره {rowNo} جهت اقدام و پیگیری ابلاغ می‌گردد:</p>" +
                               $"<p><b>شرح مصوبه:</b> {item?.Description}</p>" +
                               $"<p><b>مهلت انجام:</b> {(item?.DueDate != null ? PersianDate.ToShortFa(item.DueDate.Value) : "تعیین‌نشده")}</p>";
                    compose?.Open(title, body);
                }
                else
                {
                    var title = $"ابلاغ مصوبات صورتجلسه «{m.Title}»";
                    var sb = new System.Text.StringBuilder();
                    sb.Append($"<p>با سلام و احترام،</p>");
                    sb.Append($"<p>مصوبات صورتجلسه <b>«{m.Title}»</b> مورخ {PersianDate.ToShortFa(m.MeetingDate)} به شرح ذیل جهت استحضار و اقدام لازم ارسال می‌گردد:</p><ul>");
                    foreach (var itm in m.Items)
                    {
                        var due = itm.DueDate != null ? PersianDate.ToShortFa(itm.DueDate.Value) : "—";
                        sb.Append($"<li><b>بند {itm.RowNo}:</b> {itm.Description} (مهلت: {due})</li>");
                    }
                    sb.Append("</ul>");
                    compose?.Open(title, sb.ToString());
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری صورتجلسه: {ex.Message}");
            compose?.Open();
        }
    }

