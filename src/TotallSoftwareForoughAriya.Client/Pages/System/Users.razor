            ? SelectableRoles
            : SelectableRoles.Where(r =>
                r.Name.Contains(roleSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (r.Description ?? "").Contains(roleSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    public class RoleOpt
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("کاربران");
        if (!Auth.IsAdmin && !Auth.IsOperator) { loading = false; return; }
        EnsureAuthHeader(); // بدون این هدر، فراخوانی‌های مستقیم HttpClient (نقش‌ها، عکس، دستور کار) ۴۰۱ می‌گرفتند
        await Load();
    }

    /// <summary>افزودن توکن به هدر HttpClient — این صفحه چند فراخوانی مستقیم (بدون ApiClient) دارد.</summary>
    private void EnsureAuthHeader()
    {
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);
    }

    /// <summary>نام و نام خانوادگی کاربر (اگر خالی بود، رشتهٔ خالی)</summary>
    private static string FullName(UserDto u) => $"{u.FirstName} {u.LastName}".Trim();

    private async Task Load()
    {
        loading = true;
        EnsureAuthHeader();
        try
        {
            items = await AuthApi.GetUsersAsync();
            try { companyOptions = await Http.GetFromJsonAsync<List<CompanyOption>>("/api/SystemCompanies") ?? new(); } catch { companyOptions = new(); }
            try
            {
                organizations = await Http.GetFromJsonAsync<List<OrgOption>>("/api/SystemOrganizations") ?? new();
                var names = companyOptions.ToDictionary(c => c.Id, c => c.Name);
                foreach (var o in organizations)
                    o.CompanyName = o.CompanyId is int cid && names.TryGetValue(cid, out var cn) ? cn : "";
            }
            catch { organizations = new(); }
            referrers = await ReferrerSvc.GetAllAsync(activeOnly: true);
            try { allRoles = (await Http.GetFromJsonAsync<List<RoleOpt>>("/api/roles") ?? new()).Where(r => r.IsActive).ToList(); }
            catch (Exception rex)
            {
                allRoles = new();
                Toast.Error($"فهرست نقش‌ها خوانده نشد: {rex.Message}");
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenNew()
    {
        // سطح قدیمی (Admin/Operator/Referrer) هنگام ذخیره از روی نقش‌های RBAC انتخاب‌شده تعیین می‌شود؛
        // پس اینجا هرگز «Admin» پیش‌فرض نمی‌گذاریم (اگر فهرست نقش‌ها لود نشده باشد، کاربر بی‌نقش = مدیر کل می‌شد).
        form = new UserDto
        {
            Role = "Operator",
            IsActive = true,
            // واحد پیش‌فرضِ شرکت (اگر تعریف شده باشد) از ابتدا انتخاب می‌شود
            OrganizationId = organizations.FirstOrDefault(o => o.IsActive && o.IsDefault)?.OrganizationId
        };
        referrerIdStr = "0";
        selectedRoleIds = new();
        selectedCompanyIds = new();
        positionInputs = new List<string> { "" };
        roleDropdownOpen = false; roleSearch = "";
        saveError = "";
        luPhotoBytes = null; luPhotoPreview = null; luSignatureBytes = null; luSignaturePreview = null;
        luStoredSignaturePreview = null; signaturePreviewLoading = false;
        showModal = true;
    }

    private async Task OpenEdit(UserDto u)
    {
        form = new UserDto
        {
            Id = u.Id,
            Username = u.Username,
            Role = u.Role,
            FirstName = u.FirstName,
            LastName = u.LastName,
            Mobile = u.Mobile,
            BaleChatId = u.BaleChatId,
            EitaaChatId = u.EitaaChatId,
            SignaturePath = u.SignaturePath,
            RoleIds = u.RoleIds is null ? null : new List<int>(u.RoleIds),
            ReferrerId = u.ReferrerId,
            IsActive = u.IsActive,
            CreatedAt = u.CreatedAt,
            OrganizationId = u.OrganizationId
        };
        referrerIdStr = (u.ReferrerId ?? 0).ToString();
        selectedRoleIds = new HashSet<int>(u.RoleIds ?? new List<int>());
        positionInputs = new List<string>();
        if (u.Positions is { Count: > 0 }) positionInputs.AddRange(u.Positions);
        positionInputs.Add("");
        roleDropdownOpen = false; roleSearch = "";
        saveError = "";
        woSearch = "";
        _ = LoadWoAllowed(u.Id);
        _ = LoadCompanyAccess(u.Id);
        luPhotoBytes = null; luPhotoPreview = null; luSignatureBytes = null; luSignaturePreview = null;
        luStoredSignaturePreview = null;
        showModal = true;
        StateHasChanged();
        if (form.Id > 0 && !string.IsNullOrWhiteSpace(form.SignaturePath))
            await LoadStoredSignaturePreviewAsync(form.Id);
    }

    private void CloseModal() => showModal = false;

    private string saveError = "";

    private async Task Save()
    {
        saveError = "";

        if (string.IsNullOrWhiteSpace(form.Username))
        { saveError = "نام کاربری را وارد کنید."; return; }

        if (!editing && string.IsNullOrWhiteSpace(form.Password))
        { saveError = "رمز عبور را وارد کنید."; return; }

        if (string.IsNullOrWhiteSpace(form.FirstName))
        { saveError = "نام کاربر را وارد کنید."; return; }

        if (string.IsNullOrWhiteSpace(form.LastName))
        { saveError = "نام خانوادگی کاربر را وارد کنید."; return; }

        // بدون نقش، کاربر «هیچ محدودیت واقعی» ندارد (سرور هم ثبتِ کاربر جدید بدون نقش را رد می‌کند)
        if (allRoles.Count == 0)
        { saveError = "فهرست نقش‌ها در دسترس نیست (اتصال به سرور یا تنظیمات نقش‌ها را بررسی کنید) — بدون نقش، کاربر ثبت نمی‌شود."; return; }

        if (selectedRoleIds.Count == 0)
        { saveError = "حداقل یک نقش برای کاربر انتخاب کنید."; return; }

        form.RoleIds = selectedRoleIds.ToList();
        // سمت‌های فعالِ کاربر (هر کاربر می‌تواند چند سمت داشته باشد)
        form.Positions = CollectPositions();
        form.ReferrerId = int.TryParse(referrerIdStr, out var rid) && rid > 0 ? rid : null;
        form.Username = form.Username.Trim();
        form.FirstName = form.FirstName?.Trim();
        form.LastName = form.LastName?.Trim();
        form.Mobile = string.IsNullOrWhiteSpace(form.Mobile) ? null : Fa.ToEn(form.Mobile).Trim();
        saving = true;
        EnsureAuthHeader();
        try
        {
            var saved = await AuthApi.SaveUserAsync(form);
            if (Auth.IsAdmin)
            {
                var cr = await Http.PutAsJsonAsync($"/api/company-context/users/{saved.Id}", new { companyIds = selectedCompanyIds.ToList() });
                if (!cr.IsSuccessStatusCode) Toast.Error("کاربر ذخیره شد ولی تخصیص شرکت‌ها ذخیره نشد.");
            }
            if (luPhotoBytes != null)
            {
                try
                {
                    using var pf = new MultipartFormDataContent();
                    var pc = new ByteArrayContent(luPhotoBytes);
                    pc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
                    pf.Add(pc, "file", "photo.jpg");
                    var pr = await Http.PostAsync($"/api/auth/users/photo/{saved.Id}", pf);
                    if (!pr.IsSuccessStatusCode)
                        Toast.Error("کاربر ذخیره شد ولی عکس ذخیره نشد.");
                }
                catch { Toast.Error("خطا در آپلود عکس."); }
            }
            if (luSignatureBytes != null)
            {
                try
                {
                    using var sf = new MultipartFormDataContent();
                    var sc = new ByteArrayContent(luSignatureBytes);
                    sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/png");
                    sf.Add(sc, "file", "signature.png");
                    var sr = await Http.PostAsync($"/api/auth/users/signature/{saved.Id}", sf);
                    if (!sr.IsSuccessStatusCode) Toast.Error("کاربر ذخیره شد ولی امضا ذخیره نشد.");
                    else form.SignaturePath = $"/api/auth/users/signature/{saved.Id}";
                }
                catch { Toast.Error("خطا در آپلود امضای کاربر."); }
            }
            luPhotoBytes = null; luPhotoPreview = null; luSignatureBytes = null; luSignaturePreview = null;
            photoBust++;
            if (Auth.IsAdmin && editing) await SaveWoAllowed(saved.Id);
            Toast.Success(editing ? "کاربر ویرایش شد." : "کاربر ثبت شد.");
            showModal = false;
            await Load();
        }
        catch (Exception ex) { saveError = ex.Message; Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Delete(UserDto u)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف کاربر «{u.Username}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await AuthApi.DeleteUserAsync(u.Id);
            Toast.Success("کاربر حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ================== برچسب و رنگ فارسی نقش‌های RBAC ==================
    private static string RoleLabel(string name) => name switch
    {
        "Admin"       => "مدیر کل",
        "Operator"    => "اپراتور",
        "Accountant"  => "حسابدار",
        "Referrer"    => "معرف",
        "HrManager"   => "مدیر منابع انسانی",
        "Employee"    => "کارمند",
        _             => name
    };

    private static string RoleBadgeClass(string name) => name switch
    {
        "Admin"      => "badge-soft-danger",
        "Operator"   => "badge-soft-warning",
        "Accountant" => "badge-soft-info",
        "Referrer"   => "badge-soft-success",
        "HrManager"  => "badge-soft-primary",
        "Employee"   => "badge-soft-muted",
        _            => "badge-soft-primary"
    };
}

<style>
    /* ===== کمبوی چندانتخابی نقش‌ها ===== */
    .ms-combo { position: relative; }
    .ms-combo-control {
        display: flex; flex-wrap: wrap; align-items: center; gap: .35rem;
        min-height: 42px; cursor: pointer; padding-left: 2rem;
    }
    .ms-combo-control.focus { border-color: var(--bs-primary, #2563eb); box-shadow: 0 0 0 .2rem rgba(37,99,235,.15); }
    .ms-caret { position: absolute; left: .75rem; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; }
    .ms-chip {
        display: inline-flex; align-items: center; gap: .35rem;
        background: #eef4ff; color: #2563eb; border: 1px solid #dbe7ff;
        border-radius: 999px; padding: .15rem .6rem; font-size: .8rem; font-weight: 600;
    }
    .ms-chip i { cursor: pointer; font-size: .8rem; opacity: .7; }
    .ms-chip i:hover { opacity: 1; color: #dc3545; }
    .ms-combo-menu {
        position: absolute; top: calc(100% + 4px); right: 0; left: 0; z-index: 1060;
        background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;
    }
    .ms-combo-items { max-height: 220px; overflow-y: auto; }
    .ms-combo-item {
        display: flex; align-items: center; gap: .5rem;
        padding: .5rem .85rem; cursor: pointer; font-size: .9rem;
    }
    .ms-combo-item:hover { background: #f1f5f9; }
    .ms-combo-item.sel { background: #eef4ff; }
    .ms-combo-item.sel i { color: var(--bs-primary, #2563eb); }
    .ms-combo-item small { font-size: .72rem; }
</style>

<style>
    .signature-checkerboard {
        background-color: #f8fafc;
        background-image: linear-gradient(45deg, #e2e8f0 25%, transparent 25%),
            linear-gradient(-45deg, #e2e8f0 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, #e2e8f0 75%),
            linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
        background-size: 12px 12px;
        background-position: 0 0, 0 6px, 6px -6px, -6px 0;
    }
    /* ===== نشان‌های بله و ایتا ===== */
    .msgr-badge {
        display: inline-flex; align-items: center; gap: .2rem;
        font-size: .64rem; font-weight: 800; border-radius: 999px;
        padding: .1rem .5rem; margin-right: .25rem; vertical-align: 2px;
    }
    .msgr-bale { background: #e8f7ef; color: #12a150; border: 1px solid #b7e4c7; }
    .msgr-bale::before { content: "🕊"; font-size: .7rem; }
    .msgr-eitaa { background: #fff3e6; color: #ef7c1a; border: 1px solid #ffd9b0; }
    .msgr-eitaa::before { content: "🦅"; font-size: .7rem; }
</style>
