    // ================== کمبوی چندانتخابی نقش‌ها ==================
    private bool roleDropdownOpen;
    private string roleSearch = "";

    // ---------- منوی شناور کمبوی نقش‌ها (fixed + پوشش نامرئی — مصون از کارت‌ویو/مودال) ----------
    private ElementReference _roleComboEl;
    private double _roleTop, _roleLeft, _roleWidth;
    private string RoleMenuStyle => Popover.FixedStyle(_roleTop, _roleLeft, _roleWidth, 300);

    private async Task ToggleRoleDropdown()
    {
        if (roleDropdownOpen) { roleDropdownOpen = false; return; }
