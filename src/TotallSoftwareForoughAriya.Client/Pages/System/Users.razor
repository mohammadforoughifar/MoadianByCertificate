    private async Task OnLoginUserPhotoPicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size == 0) return;
        if (file.Size > 5 * 1024 * 1024) { saveError = "حداکثر حجم عکس ۵ مگابایت است."; StateHasChanged(); return; }
        var buf = new byte[file.Size];
        await file.OpenReadStream(long.MaxValue).ReadAsync(buf);
        luPhotoBytes = buf;
        luPhotoPreview = "data:" + (file.ContentType ?? "image/jpeg") + ";base64," + Convert.ToBase64String(buf);
        StateHasChanged();
    }

    private async Task OnUserSignaturePicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size == 0) return;
        if (file.Size > 10 * 1024 * 1024) { saveError = "حداکثر حجم امضا ۱۰ مگابایت است."; return; }
        if (file.ContentType != "image/png" || !Path.GetExtension(file.Name).Equals(".png", StringComparison.OrdinalIgnoreCase))
        { saveError = "فقط فایل PNG مجاز است."; return; }
        luSignatureBytes = new byte[file.Size];
        await using (var signatureStream = file.OpenReadStream(10 * 1024 * 1024))
            await signatureStream.ReadExactlyAsync(luSignatureBytes);
        luSignaturePreview = "data:" + file.ContentType + ";base64," + Convert.ToBase64String(luSignatureBytes);
        StateHasChanged();
    }

