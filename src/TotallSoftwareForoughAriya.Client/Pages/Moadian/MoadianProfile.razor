@page "/moadian/profile"
@inject IMoadianClientService Mdn
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>سامانه مودیان — پرونده و گواهی امضا</PageTitle>

<MoadianSubNav />

<div class="page-head">
    <div>
        <h1>پرونده مالیاتی و گواهی امضای الکترونیکی</h1>
        <p class="lead">پیکربندی شناسه یکتای حافظه، کلید خصوصی و گواهی امضای X.509، توکن PKCS#11 و تشخیص فنی ارتباط</p>
    </div>
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-outline-success" disabled="@busy" @onclick="RunDiagnosticsAsync">
            @if (busyAction == "diag")
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi bi-shield-check me-1"></i>
            }
            تست کامل اتصال به سامانه مودیان
        </button>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (profile is not null)
{
    <div class="row g-3">
        <!-- ستون راست: مشخصات مودی و تنظیمات حافظه مالیاتی -->
        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-building-gear me-1"></i>مشخصات مودی و حافظه مالیاتی (شرکت فعال: @profile.CompanyName)</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">نام تجاری / عنوان مودی <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="form.TradeName" placeholder="نام رسمی شرکت یا واحد صنفی" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">نوع مودی</label>
                            <select class="form-select" @bind="form.TaxpayerType">
                                <option value="@MdnTaxpayerType.Legal">حقوقی</option>
                                <option value="@MdnTaxpayerType.Natural">حقیقی</option>
                                <option value="@MdnTaxpayerType.CivicPartnership">مشارکت مدنی</option>
                                <option value="@MdnTaxpayerType.ForeignNational">اتباع غیر ایرانی</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">شماره اقتصادی مودی (tins) <span class="text-danger">*</span></label>
                            <input class="form-control font-monospace" dir="ltr" @bind="form.EconomicCode" placeholder="14003778990" />
                            <div class="form-text">در نظام جدید معمولاً همان شناسه ملی ۱۱ رقمی (حقوقی) یا کد اقتصادی ۱۴ رقمی است.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">شناسه یکتای حافظه مالیاتی (۶ کاراکتر) <span class="text-danger">*</span></label>
                            <input class="form-control font-monospace text-uppercase" dir="ltr" maxlength="6" @bind="form.MemoryId" placeholder="A11226" />
                            <div class="form-text">شناسه ۶ کاراکتری دریافتی از کارپوشه my.tax.gov.ir (بخش عضویت ← ابزارهای پرداخت/حافظه).</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">شناسه / کد ملی</label>
                            <input class="form-control font-monospace" dir="ltr" @bind="form.NationalId" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">کد پستی ۱۰ رقمی</label>
                            <input class="form-control font-monospace" dir="ltr" maxlength="10" @bind="form.PostalCode" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">کد شعبه (۴ رقم)</label>
                            <input class="form-control font-monospace" dir="ltr" maxlength="10" @bind="form.BranchCode" placeholder="0000" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">نشانی اقامتگاه قانونی</label>
                            <input class="form-control" @bind="form.Address" />
                        </div>

                        <hr class="my-1" />

                        <div class="col-md-4">
                            <label class="form-label">محیط سامانه مودیان</label>
                            <select class="form-select" @bind="form.Environment">
                                <option value="@MdnEnvironment.Production">عملیاتی (tp.tax.gov.ir)</option>
                                <option value="@MdnEnvironment.Sandbox">آزمایشی (rc.tax.gov.ir)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">سریال داخلی بعدی</label>
                            <input type="number" min="1" class="form-control num" @bind="form.NextSerial" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">نرخ پیش‌فرض ارزش افزوده (٪)</label>
                            <input type="number" step="0.1" min="0" max="100" class="form-control num" @bind="form.DefaultVatRate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">آدرس درگاه عملیاتی (Production)</label>
                            <input class="form-control font-monospace small" dir="ltr" @bind="form.ProductionBaseUrl" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">آدرس درگاه آزمایشی (Sandbox / RC)</label>
                            <input class="form-control font-monospace small" dir="ltr" @bind="form.SandboxBaseUrl" />
                        </div>
                    </div>

                    @if (Auth.Has("Moadian.Certificate"))
                    {
                        <div class="mt-3 text-end">
                            <button class="btn btn-primary" disabled="@busy" @onclick="SaveProfileAsync">
                                <i class="bi bi-check-lg me-1"></i>ذخیره مشخصات پرونده مالیاتی
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ستون چپ: گاوصندوق گواهی امضای الکترونیکی -->
        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-patch-check-fill text-primary me-1"></i>گاوصندوق گواهی امضای الکترونیکی (X.509 / ویندوز / PKCS#11)</h6>
                    @if (profile.SignatureMode == MdnSignatureMode.Pkcs8Certificate && profile.HasPrivateKey && profile.HasCertificate)
                    {
                        <span class="badge bg-success">امضای نرم‌افزاری فعال</span>
                    }
                    else if (profile.SignatureMode == MdnSignatureMode.WindowsStore && !string.IsNullOrWhiteSpace(profile.CertificateThumbprint))
                    {
                        <span class="badge bg-primary">مخزن گواهی ویندوز فعال</span>
                    }
                    else if (profile.SignatureMode == MdnSignatureMode.Pkcs11Token && profile.HasPkcs11Pin)
                    {
                        <span class="badge bg-info text-dark">توکن سخت‌افزاری فعال</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">بارگذاری نشده</span>
                    }
                </div>

                <div class="card-body">
                    <!-- کارت نمایش وضعیت گواهی فعلی در صورت وجود -->
                    @if (!string.IsNullOrWhiteSpace(profile.CertificateSubject))
                    {
                        <div class="alert @(profile.IsCertificateExpired ? "alert-danger" : "alert-success") py-2 px-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold mb-1">
                                        <i class="bi bi-award me-1"></i>
                                        @(profile.SignatureMode switch
                                        {
                                            MdnSignatureMode.WindowsStore => "گواهی امضای متصل به مخزن گواهی ویندوز (certmgr.msc)",
                                            MdnSignatureMode.Pkcs11Token => "گواهی امضای متصل به توکن سخت‌افزاری (PKCS#11)",
                                            _ => "گواهی امضای ذخیره شده در گاوصندوق AES-256-GCM"
                                        })
                                    </div>
                                    <div class="small"><strong>صاحب گواهی (Subject):</strong> <span dir="ltr">@profile.CertificateSubject</span></div>
                                    <div class="small"><strong>مرکز صادرکننده (Issuer):</strong> <span dir="ltr">@profile.CertificateIssuer</span></div>
                                    <div class="small font-monospace"><strong>اثر انگشت SHA-1:</strong> @profile.CertificateThumbprint</div>
                                    <div class="small mt-1">
                                        <strong>اعتبار:</strong> از @profile.CertificateNotBefore?.ToFaDate() تا @profile.CertificateNotAfter?.ToFaDate()
                                        @if (profile.CertificateDaysRemaining.HasValue)
                                        {
                                            <span class="badge bg-dark ms-1">
                                                @(profile.IsCertificateExpired ? "منقضی شده" : $"{profile.CertificateDaysRemaining.Value.FaDigits()} روز مانده")
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (Auth.Has("Moadian.Certificate"))
                                {
                                    <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="ClearCertificateAsync" title="پاک‌سازی کلید از گاوصندوق">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (Auth.Has("Moadian.Certificate"))
                    {
                        <!-- تب‌های روش بارگذاری گواهی -->
                        <ul class="nav nav-tabs mb-3">
                            <li class="nav-item">
                                <button type="button" class="nav-link @(certTab == "pem" ? "active" : "")" @onclick='() => SwitchCertTab("pem")'>
                                    کلید + گواهی (.pem/.crt)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link @(certTab == "pfx" ? "active" : "")" @onclick='() => SwitchCertTab("pfx")'>
                                    فایل تجمیعی (.pfx)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link @(certTab == "winstore" ? "active" : "")" @onclick='() => SwitchCertTab("winstore")'>
                                    مخزن ویندوز (certmgr)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link @(certTab == "pkcs11" ? "active" : "")" @onclick='() => SwitchCertTab("pkcs11")'>
                                    توکن سخت‌افزاری (PKCS#11)
                                </button>
                            </li>
                        </ul>

                        @if (!string.IsNullOrWhiteSpace(vaultDiagnosticError))
                        {
                            <div class="alert alert-danger py-2 px-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="fw-bold small">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>گزارش دقیق علت خطا / عدم تطابق گواهی امضا
                                    </div>
                                    <button type="button" class="btn-close btn-sm" @onclick="() => vaultDiagnosticError = null"></button>
                                </div>
                                <div class="small mt-1" style="white-space: pre-wrap; line-height: 1.75;">@vaultDiagnosticError</div>
                            </div>
                        }

                        @if (certTab == "pem")
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0">۱. کلید خصوصی مودی (Private Key — .pem / .key)</label>
                                    <label class="btn btn-sm btn-outline-secondary mb-0">
                                        <i class="bi bi-upload me-1"></i>انتخاب فایل کلید خصوصی
                                        <InputFile OnChange="OnPrivateKeyFileSelected" accept=".pem,.key,.der,.txt" class="d-none" />
                                    </label>
                                </div>
                                <textarea class="form-control font-monospace small" dir="ltr" rows="3"
                                          @bind="certReq.PrivateKeyPem"
                                          placeholder="-----BEGIN PRIVATE KEY----- ..."></textarea>
                                @if (!string.IsNullOrWhiteSpace(selectedKeyFileName))
                                {
                                    <div class="small text-success mt-1"><i class="bi bi-check2 me-1"></i>فایل کلید خوانده شد: @selectedKeyFileName</div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label small mb-1">رمز کلید خصوصی <span class="text-muted">(اختیاری — فقط در صورتی که فایل کلید خصوصی رمزدار باشد)</span></label>
                                <input type="password" class="form-control form-control-sm" dir="ltr"
                                       @bind="certReq.PrivateKeyPassword"
                                       placeholder="در صورت بدون رمز بودن کلید خصوصی خالی بگذارید" />
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0">۲. گواهی امضای الکترونیکی مودی (X.509 Certificate — .crt / .cer / .pem / .p7b)</label>
                                    <label class="btn btn-sm btn-outline-secondary mb-0">
                                        <i class="bi bi-upload me-1"></i>انتخاب فایل .crt / .cer
                                        <InputFile OnChange="OnCertFileSelected" accept=".crt,.cer,.pem,.der,.p7b,.p7c,.txt" class="d-none" />
                                    </label>
                                </div>
                                <textarea class="form-control font-monospace small" dir="ltr" rows="3"
                                          @bind="certReq.CertificateContent"
                                          placeholder="-----BEGIN CERTIFICATE----- ... (یا بارگذاری فایل باینری .cer / .crt)"></textarea>
                                @if (!string.IsNullOrWhiteSpace(selectedCertFileName))
                                {
                                    <div class="small text-success mt-1"><i class="bi bi-check2 me-1"></i>فایل گواهی خوانده شد: @selectedCertFileName</div>
                                }
                            </div>

                            <div class="alert alert-light border small py-2 mb-3">
                                <i class="bi bi-lock-fill text-success me-1"></i>
                                پشتیبانی کامل از گواهی متنی PEM، باینری DER (<code>.cer</code>/<code>.crt</code>)، Base64 خام و زنجیره PKCS#7 (<code>.p7b</code>). تطابق ریاضی زوج‌کلید RSA و گواهی X.509 پیش از ذخیره کنترل شده و کلید با الگوریتم <strong>AES-256-GCM + HKDF</strong> رمزنگاری می‌گردد.
                            </div>

                            <div class="text-end">
                                <button class="btn btn-success" disabled="@busy" @onclick="UploadPemCertAsync">
                                    <i class="bi bi-shield-lock me-1"></i>بررسی تطابق و رمزنگاری در گاوصندوق
                                </button>
                            </div>
                        }
                        else if (certTab == "pfx")
                        {
                            <div class="mb-3">
                                <label class="form-label">فایل گواهی امضای دیجیتال (.pfx یا .p12)</label>
                                <InputFile OnChange="OnPfxFileSelected" accept=".pfx,.p12" class="form-control" />
                                @if (!string.IsNullOrWhiteSpace(selectedPfxFileName))
                                {
                                    <div class="small text-success mt-1"><i class="bi bi-check2 me-1"></i>فایل انتخاب‌شده: @selectedPfxFileName</div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label">رمز عبور فایل PFX (در صورت وجود)</label>
                                <input type="password" class="form-control" dir="ltr" @bind="certReq.PfxPassword" placeholder="رمز عبور فایل PFX" />
                            </div>

                            <div class="text-end">
                                <button class="btn btn-success" disabled="@(busy || string.IsNullOrWhiteSpace(certReq.PfxBase64))" @onclick="UploadPfxCertAsync">
                                    <i class="bi bi-shield-lock me-1"></i>استخراج گواهی امضا و ذخیره امن
                                </button>
                            </div>
                        }
                        else if (certTab == "winstore")
                        {
                            <div class="alert alert-light border small py-2 mb-3">
                                <i class="bi bi-windows text-primary me-1"></i>
                                <strong>ویژه گواهی‌هایی که گزینهٔ <code>Yes, export the private key</code> در ویندوز برایشان غیرفعال (خاکستری) است:</strong>
                                بدون نیاز به خروجی گرفتن <code>.pfx</code>، گواهی‌های نصب‌شده در <code>certmgr.msc</code> (کاربر فعلی) و <code>certlm.msc</code> (کل سیستم) مستقیماً خوانده شده و از طریق موتور رمزنگاری ویندوز امضا می‌شوند.
                            </div>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <span class="small text-muted">
                                    برای مشاهدهٔ وضعیت کلید خصوصی گواهی‌های نصب‌شده در ویندوز دکمهٔ روبه‌رو را بزنید:
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="DiscoverWindowsStoreAsync">
                                    @if (busyAction == "winstore-scan")
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-search me-1"></i>
                                    }
                                    مشاهده گواهی‌های نصب‌شده در ویندوز (certmgr)
                                </button>
                            </div>

                            @if (winStoreDiscovery is not null)
                            {
                                var hasUsable = winStoreDiscovery.Certificates.Any(c => !c.IsCertificateAuthority && c.HasPrivateKey && !c.IsExpired);
                                <div class="alert @(hasUsable ? "alert-success" : "alert-warning") py-2 px-3 small mb-3">
                                    <div class="fw-semibold mb-1">@winStoreDiscovery.Summary</div>

                                    @if (winStoreDiscovery.Certificates.Count > 0)
                                    {
                                        <div class="table-responsive mt-2 bg-white rounded border">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>صاحب گواهی</th>
                                                        <th>مخزن</th>
                                                        <th>کلید خصوصی</th>
                                                        <th>انقضا</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var cert in winStoreDiscovery.Certificates)
                                                    {
                                                        var isSelected = string.Equals(certReq.WindowsStoreThumbprint, cert.Thumbprint, StringComparison.OrdinalIgnoreCase);
                                                        <tr class="@(isSelected ? "table-primary" : cert.IsCertificateAuthority ? "table-secondary" : "")">
                                                            <td class="small">
                                                                <div class="fw-semibold">@cert.CommonName</div>
                                                                <div class="text-muted" style="font-size:0.73rem;" dir="ltr">@cert.Issuer</div>
                                                            </td>
                                                            <td class="small">
                                                                <span class="badge bg-light text-dark border">
                                                                    @(cert.StoreLocation == "LocalMachine" ? "کل سیستم" : "کاربر فعلی")
                                                                </span>
                                                            </td>
                                                            <td>
                                                                @if (cert.HasPrivateKey)
                                                                {
                                                                    <span class="badge bg-success">دارای کلید خصوصی</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning text-dark">فاقد کلید خصوصی (فقط .crt)</span>
                                                                }
                                                            </td>
                                                            <td class="small">
                                                                <div>@cert.NotAfter.ToFaDate()</div>
                                                                @if (cert.IsCertificateAuthority)
                                                                {
                                                                    <span class="badge bg-secondary">مرکز صدور (CA)</span>
                                                                }
                                                                else if (cert.IsExpired)
                                                                {
                                                                    <span class="badge bg-danger">منقضی‌شده</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-success-subtle text-success">معتبر</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-primary"
                                                                        disabled="@cert.IsCertificateAuthority"
                                                                        @onclick="() => SelectWindowsStoreCertificate(cert)">
                                                                    انتخاب
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="row g-2 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">اثر انگشت گواهی انتخاب‌شده در ویندوز (SHA-1 Thumbprint)</label>
                                    <input class="form-control font-monospace" dir="ltr"
                                           @bind="certReq.WindowsStoreThumbprint"
                                           placeholder="با دکمهٔ مشاهده گواهی‌های ویندوز خودکار پر می‌شود..." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">مخزن ویندوز</label>
                                    <select class="form-select" @bind="certReq.WindowsStoreLocation">
                                        <option value="">جستجوی خودکار (هر دو مخزن)</option>
                                        <option value="CurrentUser">کاربر فعلی (certmgr.msc)</option>
                                        <option value="LocalMachine">کل سیستم (certlm.msc)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="text-end">
                                <button class="btn btn-primary" disabled="@busy" @onclick="SaveWindowsStoreConfigAsync">
                                    <i class="bi bi-windows me-1"></i>تست امضای زنده و فعال‌سازی مستقیم از ویندوز
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <span class="small text-muted">
                                    توکن USB را به سرور وصل کنید و دکمهٔ روبه‌رو را بزنید تا مسیر درایور و نام دقیق گواهی خودکار پر شود:
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="DiscoverPkcs11Async">
                                    @if (busyAction == "pkcs11-scan")
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-search me-1"></i>
                                    }
                                    جستجوی خودکار درایور و گواهی‌های توکن
                                </button>
                            </div>

                            @if (pkcs11Discovery is not null)
                            {
                                <div class="alert @(pkcs11Discovery.Certificates.Count > 0 ? "alert-success" : "alert-warning") py-2 px-3 small mb-3">
                                    <div class="fw-semibold mb-1">@pkcs11Discovery.Summary</div>

                                    @if (pkcs11Discovery.Drivers.Count > 0)
                                    {
                                        <div class="mt-1">
                                            <div class="text-muted mb-1">درایورهای PKCS#11 شناسایی‌شده روی سیستم:</div>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var drv in pkcs11Discovery.Drivers)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm @(drv.ConnectedTokensCount > 0 ? "btn-success" : "btn-outline-secondary")"
                                                            title="@drv.DiagnosticMessage"
                                                            @onclick="() => SelectPkcs11Driver(drv)">
                                                        <i class="bi @(drv.ConnectedTokensCount > 0 ? "bi-usb-plug-fill" : "bi-filetype-dll") me-1"></i>
                                                        @drv.VendorName
                                                        @if (drv.ConnectedTokensCount > 0)
                                                        {
                                                            <span class="badge bg-light text-dark ms-1">توکن متصل</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (pkcs11Discovery.Certificates.Count > 0)
                                    {
                                        <div class="table-responsive mt-2 bg-white rounded border">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Label (Alias)</th>
                                                        <th>صاحب گواهی</th>
                                                        <th>انقضا</th>
                                                        <th>وضعیت</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var cert in pkcs11Discovery.Certificates)
                                                    {
                                                        <tr class="@(cert.IsCertificateAuthority ? "table-secondary" : "")">
                                                            <td class="font-monospace small" dir="ltr">@cert.CertificateAlias</td>
                                                            <td class="small">
                                                                <div class="fw-semibold">@cert.CommonName</div>
                                                                <div class="text-muted" style="font-size:0.75rem;" dir="ltr">@cert.TokenModel (@cert.TokenSerial)</div>
                                                            </td>
                                                            <td class="small">@cert.NotAfter.ToFaDate()</td>
                                                            <td>
                                                                @if (cert.IsCertificateAuthority)
                                                                {
                                                                    <span class="badge bg-secondary">گواهی مرکز صدور (CA)</span>
                                                                }
                                                                else if (cert.IsExpired)
                                                                {
                                                                    <span class="badge bg-danger">منقضی‌شده</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-success">گواهی مودی</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-primary"
                                                                        disabled="@cert.IsCertificateAuthority"
                                                                        @onclick="() => SelectPkcs11Certificate(cert)">
                                                                    انتخاب
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label">مسیر کتابخانه درایور توکن روی سرور (.dll / .so)</label>
                                <input class="form-control font-monospace" dir="ltr" @bind="certReq.Pkcs11LibraryPath" placeholder="C:\Windows\System32\shuttlecsp11_3003.dll" />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">برچسب گواهی روی توکن (Certificate Alias / Label)</label>
                                    <input class="form-control font-monospace" dir="ltr" @bind="certReq.Pkcs11CertificateAlias" placeholder="با دکمه جستجوی خودکار پر می‌شود (یا خالی بگذارید)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">پین توکن سخت‌افزاری (PIN)</label>
                                    <input type="password" class="form-control" dir="ltr" @bind="certReq.Pkcs11Pin" placeholder="رمز پین توکن" />
                                </div>
                            </div>
                            <div class="text-end">
                                <button class="btn btn-info text-white" disabled="@busy" @onclick="SavePkcs11ConfigAsync">
                                    <i class="bi bi-usb-drive me-1"></i>بررسی امضای توکن و ثبت تنظیمات PKCS#11
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- بخش ابزارهای تشخیصی آنلاین SDK 2.0.29 -->
    <div class="row g-3 mt-1">
        <!-- نتیجه گام‌به‌گام تست اتصال -->
        @if (diagResult is not null)
        {
            <div class="col-12">
                <div class="card border-start border-4 @(diagResult.Success ? "border-success" : "border-danger")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">گزارش گام‌به‌گام عیب‌یابی اتصال با SDK 2.0.29</h6>
                        <span class="badge @(diagResult.Success ? "bg-success" : "bg-danger")">@diagResult.Summary</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>گام</th>
                                    <th>وضعیت</th>
                                    <th>جزئیات بازگشتی از سرور مالیاتی</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in diagResult.Steps)
                                {
                                    <tr>
                                        <td class="fw-semibold">@s.Title</td>
                                        <td>
                                            <span class="badge @(s.Passed ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                @(s.Passed ? "موفق" : "ناموفق")
                                            </span>
                                        </td>
                                        <td class="small">@s.Detail</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- استعلام آنلاین کد اقتصادی -->
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-search me-1"></i>استعلام آنلاین شماره اقتصادی از سازمان امور مالیاتی</h6>
                </div>
                <div class="card-body">
                    <div class="input-group mb-2">
                        <input class="form-control font-monospace" dir="ltr" @bind="lookupEconomicCode" placeholder="کد اقتصادی یا شناسه ملی ۱۱/۱۴ رقمی..." />
                        <button class="btn btn-outline-primary" disabled="@busy" @onclick="LookupTaxpayerAsync">
                            استعلام آنلاین
                        </button>
                    </div>
                    @if (lookupResult is not null)
                    {
                        var found = !string.IsNullOrWhiteSpace(lookupResult.NameTrade) || !string.IsNullOrWhiteSpace(lookupResult.TaxpayerStatus);
                        <div class="alert @(found ? "alert-success" : "alert-warning") py-2 mb-0 small">
                            @if (found)
                            {
                                <div><strong>نام تجاری:</strong> @lookupResult.NameTrade</div>
                                <div><strong>وضعیت پرونده:</strong> @lookupResult.TaxpayerStatus | <strong>نوع مودی:</strong> @lookupResult.TaxpayerType</div>
                                <div><strong>کد پستی:</strong> @lookupResult.PostalCode | <strong>نشانی:</strong> @lookupResult.Address</div>
                            }
                            else
                            {
                                <div>اطلاعاتی برای این شماره اقتصادی در درگاه یافت نشد.</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- بررسی سقف اعتبار ماده ۶ -->
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-calculator me-1"></i>استعلام وضعیت حد مجاز ماده ۶ (GetArticle6Status)</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small mb-1">کد اقتصادی خریدار / مودی</label>
                            <input class="form-control form-control-sm font-monospace" dir="ltr" @bind="art6Req.EconomicCode" placeholder="10100302746" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1">مبلغ ارزش افزوده (ریال)</label>
                            <input type="number" class="form-control form-control-sm num" @bind="art6Req.VatValue" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">دوره (سال+فصل)</label>
                            <input type="number" class="form-control form-control-sm num" @bind="art6Req.Period" placeholder="14053" />
                        </div>
                    </div>
                    <div class="mt-2 d-flex justify-content-between align-items-center">
                        <span class="small text-muted">نمونه دوره: <code>14053</code> یعنی پاییز ۱۴۰۵</span>
                        <button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="CheckArticle6Async">بررسی سقف ماده ۶</button>
                    </div>
                    @if (art6Result is not null)
                    {
                        <div class="alert @(art6Result.Article6RemainStatus ? "alert-success" : "alert-danger") py-2 mt-2 mb-0 small">
                            @art6Result.Message
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private MdnProfileDto? profile;
    private MdnSaveProfileRequest form = new();
    private MdnUploadCertificateRequest certReq = new();
    private string certTab = "pem";
    private string? selectedKeyFileName;
    private string? selectedCertFileName;
    private string? selectedPfxFileName;
    private string? vaultDiagnosticError;
    private MdnPkcs11DiscoverResultDto? pkcs11Discovery;
    private MdnWindowsStoreDiscoverResultDto? winStoreDiscovery;

    private MdnConnectionDiagnosticsDto? diagResult;
    private string lookupEconomicCode = "";
    private MdnTaxpayerLookupDto? lookupResult;
    private MdnArticle6CheckRequest art6Req = new() { Period = 14053, VatValue = 10_000_000 };
    private MdnArticle6CheckResultDto? art6Result;

    private bool loading = true;
    private bool busy;
    private string busyAction = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            profile = await Mdn.GetProfileAsync();
            BindForm(profile);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void BindForm(MdnProfileDto p)
    {
        form = new MdnSaveProfileRequest
        {
            TradeName = p.TradeName,
            TaxpayerType = p.TaxpayerType,
            EconomicCode = p.EconomicCode,
            NationalId = p.NationalId,
            PostalCode = p.PostalCode,
            BranchCode = p.BranchCode,
            Address = p.Address,
            MemoryId = p.MemoryId,
            Environment = p.Environment,
            ProductionBaseUrl = p.ProductionBaseUrl,
            SandboxBaseUrl = p.SandboxBaseUrl,
            SignatureMode = p.SignatureMode,
            NextSerial = p.NextSerial,
            DefaultVatRate = p.DefaultVatRate,
            IsActive = p.IsActive
        };
        certReq.Pkcs11LibraryPath = p.Pkcs11LibraryPath;
        certReq.Pkcs11CertificateAlias = p.Pkcs11CertificateAlias;
        if (p.SignatureMode == MdnSignatureMode.Pkcs11Token)
        {
            certTab = "pkcs11";
        }
        else if (p.SignatureMode == MdnSignatureMode.WindowsStore)
        {
            certTab = "winstore";
            certReq.WindowsStoreThumbprint = p.CertificateThumbprint;
        }
    }

    private async Task SaveProfileAsync()
    {
        busy = true;
        try
        {
            profile = await Mdn.SaveProfileAsync(form);
            BindForm(profile);
            Toast.Success("مشخصات پرونده مالیاتی ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task OnPrivateKeyFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            certReq.PrivateKeyPem = await ReadFileAsPemOrBase64Async(e.File, 4 * 1024 * 1024);
            selectedKeyFileName = e.File.Name;
            Toast.Info($"فایل کلید خصوصی «{e.File.Name}» خوانده شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task OnCertFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            certReq.CertificateContent = await ReadFileAsPemOrBase64Async(e.File, 4 * 1024 * 1024);
            selectedCertFileName = e.File.Name;
            Toast.Info($"فایل گواهی امضا «{e.File.Name}» بارگذاری شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static async Task<string> ReadFileAsPemOrBase64Async(IBrowserFile file, long maxBytes)
    {
        await using var ms = new MemoryStream();
        await file.OpenReadStream(maxBytes).CopyToAsync(ms);
        var bytes = ms.ToArray();
        if (bytes.Length == 0) return string.Empty;

        string? decoded = null;
        if (bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
            decoded = System.Text.Encoding.UTF8.GetString(bytes, 3, bytes.Length - 3);
        else if (bytes.Length >= 2 && bytes[0] == 0xFF && bytes[1] == 0xFE)
            decoded = System.Text.Encoding.Unicode.GetString(bytes, 2, bytes.Length - 2);
        else if (bytes.Length >= 2 && bytes[0] == 0xFE && bytes[1] == 0xFF)
            decoded = System.Text.Encoding.BigEndianUnicode.GetString(bytes, 2, bytes.Length - 2);
        else if (Array.IndexOf(bytes, (byte)0) < 0)
            decoded = System.Text.Encoding.UTF8.GetString(bytes);

        if (!string.IsNullOrWhiteSpace(decoded) &&
            !decoded.Contains('\uFFFD') &&
            decoded.Contains("-----BEGIN", StringComparison.OrdinalIgnoreCase))
        {
            return decoded.Trim('\uFEFF', '\0', ' ', '\r', '\n', '\t');
        }

        return Convert.ToBase64String(bytes);
    }

    private async Task OnPfxFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var ms = new MemoryStream();
            await e.File.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
            certReq.PfxBase64 = Convert.ToBase64String(ms.ToArray());
            selectedPfxFileName = e.File.Name;
            Toast.Info($"فایل «{e.File.Name}» آماده استخراج گواهی است.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void SwitchCertTab(string tab)
    {
        certTab = tab;
        vaultDiagnosticError = null;
    }

    private void SetVaultError(Exception ex)
    {
        var msg = ex.Message ?? "خطای نامشخص";
        var httpSuffixIdx = msg.LastIndexOf(" (HTTP ", StringComparison.Ordinal);
        vaultDiagnosticError = httpSuffixIdx > 0 ? msg[..httpSuffixIdx] : msg;
        Toast.Error("خطا در بررسی گواهی امضا — جزئیات دقیق در کادر قرمز بالای فرم درج شد.");
    }

    private async Task DiscoverPkcs11Async()
    {
        busy = true;
        busyAction = "pkcs11-scan";
        vaultDiagnosticError = null;
        try
        {
            pkcs11Discovery = await Mdn.DiscoverPkcs11Async(new MdnPkcs11DiscoverRequest
            {
                LibraryPath = string.IsNullOrWhiteSpace(certReq.Pkcs11LibraryPath) ? null : certReq.Pkcs11LibraryPath.Trim(),
                Pin = string.IsNullOrWhiteSpace(certReq.Pkcs11Pin) ? null : certReq.Pkcs11Pin
            });

            var signingCerts = pkcs11Discovery.Certificates.Where(c => !c.IsCertificateAuthority).ToList();
            if (signingCerts.Count == 1)
            {
                SelectPkcs11Certificate(signingCerts[0]);
            }
            else if (string.IsNullOrWhiteSpace(certReq.Pkcs11LibraryPath))
            {
                var activeDriver = pkcs11Discovery.Drivers.FirstOrDefault(d => d.ConnectedTokensCount > 0)
                                   ?? pkcs11Discovery.Drivers.FirstOrDefault(d => d.LoadSucceeded);
                if (activeDriver is not null)
                    certReq.Pkcs11LibraryPath = activeDriver.LibraryPath;
            }

            Toast.Info(pkcs11Discovery.Summary);
        }
        catch (Exception ex) { SetVaultError(ex); }
        finally { busy = false; busyAction = ""; }
    }

    private void SelectPkcs11Driver(MdnPkcs11DriverDto drv)
    {
        certReq.Pkcs11LibraryPath = drv.LibraryPath;
        Toast.Info($"مسیر درایور «{drv.VendorName}» انتخاب شد.");
    }

    private void SelectPkcs11Certificate(MdnPkcs11CertificateItemDto cert)
    {
        certReq.Pkcs11LibraryPath = cert.LibraryPath;
        certReq.Pkcs11CertificateAlias = cert.CertificateAlias;
        Toast.Success($"گواهی «{cert.CommonName}» با برچسب «{cert.CertificateAlias}» انتخاب شد.");
    }

    private async Task DiscoverWindowsStoreAsync()
    {
        busy = true;
        busyAction = "winstore-scan";
        vaultDiagnosticError = null;
        try
        {
            winStoreDiscovery = await Mdn.DiscoverWindowsStoreAsync();
            var candidates = winStoreDiscovery.Certificates
                .Where(c => !c.IsCertificateAuthority && c.HasPrivateKey && !c.IsExpired)
                .ToList();
            if (candidates.Count == 1)
            {
                SelectWindowsStoreCertificate(candidates[0]);
            }
            Toast.Info(winStoreDiscovery.Summary);
        }
        catch (Exception ex) { SetVaultError(ex); }
        finally { busy = false; busyAction = ""; }
    }

    private void SelectWindowsStoreCertificate(MdnWindowsStoreCertificateItemDto cert)
    {
        certReq.WindowsStoreThumbprint = cert.Thumbprint;
        certReq.WindowsStoreLocation = cert.StoreLocation;
        Toast.Success($"گواهی «{cert.CommonName}» از مخزن ویندوز انتخاب شد.");
    }

    private async Task SaveWindowsStoreConfigAsync()
    {
        busy = true;
        vaultDiagnosticError = null;
        try
        {
            certReq.SignatureMode = MdnSignatureMode.WindowsStore;
            profile = await Mdn.UploadCertificateAsync(certReq);
            form.SignatureMode = profile.SignatureMode;
            certReq.WindowsStoreThumbprint = profile.CertificateThumbprint;
            Toast.Success("گواهی مخزن ویندوز با موفقیت تست امضا و برای امضای مستقیم فعال شد.");
        }
        catch (Exception ex) { SetVaultError(ex); }
        finally { busy = false; }
    }

    private async Task UploadPemCertAsync()
    {
        busy = true;
        vaultDiagnosticError = null;
        try
        {
            certReq.SignatureMode = MdnSignatureMode.Pkcs8Certificate;
            certReq.PfxBase64 = null;
            profile = await Mdn.UploadCertificateAsync(certReq);
            form.SignatureMode = profile.SignatureMode;
            certReq.PrivateKeyPem = null;
            certReq.PrivateKeyPassword = null;
            certReq.CertificateContent = null;
            selectedKeyFileName = null;
            selectedCertFileName = null;
            Toast.Success("گواهی امضای الکترونیکی X.509 و کلید خصوصی با موفقیت تأیید و رمزنگاری شدند.");
        }
        catch (Exception ex) { SetVaultError(ex); }
        finally { busy = false; }
    }

    private async Task UploadPfxCertAsync()
    {
        busy = true;
        vaultDiagnosticError = null;
        try
        {
            certReq.SignatureMode = MdnSignatureMode.Pkcs8Certificate;
            profile = await Mdn.UploadCertificateAsync(certReq);
            form.SignatureMode = profile.SignatureMode;
            certReq.PfxBase64 = null;
            certReq.PfxPassword = null;
            selectedPfxFileName = null;
            Toast.Success("گواهی امضا و کلید خصوصی از فایل PFX استخراج و رمزنگاری شدند.");
        }
        catch (Exception ex) { SetVaultError(ex); }
        finally { busy = false; }
    }

    private async Task SavePkcs11ConfigAsync()
    {
        busy = true;
        vaultDiagnosticError = null;
        try
        {
            certReq.SignatureMode = MdnSignatureMode.Pkcs11Token;
            profile = await Mdn.UploadCertificateAsync(certReq);
            form.SignatureMode = profile.SignatureMode;
            certReq.Pkcs11LibraryPath = profile.Pkcs11LibraryPath;
            certReq.Pkcs11CertificateAlias = profile.Pkcs11CertificateAlias;
            certReq.Pkcs11Pin = null;
            Toast.Success("توکن سخت‌افزاری PKCS#11 بررسی، تست امضا و ذخیره شد.");
        }
        catch (Exception ex) { SetVaultError(ex); }
        finally { busy = false; }
    }

    private async Task ClearCertificateAsync()
    {
        busy = true;
        try
        {
            profile = await Mdn.ClearCertificateAsync();
            form.SignatureMode = profile.SignatureMode;
            Toast.Warning("کلید خصوصی و گواهی امضا از گاوصندوق حذف شدند.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task RunDiagnosticsAsync()
    {
        busy = true;
        busyAction = "diag";
        try
        {
            diagResult = await Mdn.TestConnectionAsync();
            profile = await Mdn.GetProfileAsync();
            if (diagResult.Success) Toast.Success(diagResult.Summary);
            else Toast.Warning(diagResult.Summary);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; busyAction = ""; }
    }

    private async Task LookupTaxpayerAsync()
    {
        if (string.IsNullOrWhiteSpace(lookupEconomicCode)) return;
        busy = true;
        try
        {
            lookupResult = await Mdn.LookupTaxpayerAsync(lookupEconomicCode);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task CheckArticle6Async()
    {
        busy = true;
        try
        {
            art6Result = await Mdn.CheckArticle6Async(art6Req);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }
}
