@page "/moadian/invoices"
@inject IMoadianClientService Mdn
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>صورتحساب‌های مودیان</PageTitle>

<MoadianSubNav />

<div class="page-head">
    <div>
        <h1>صورتحساب‌های مودیان</h1>
    </div>
    <div class="ms-auto d-flex flex-wrap gap-2">
        @if (Auth.Has("Moadian.InvoiceCreate"))
        {
            <button class="btn btn-outline-secondary" disabled="@busy" @onclick="OpenErpImportModalAsync">
                <i class="bi bi-box-arrow-in-down me-1"></i>تبدیل از فاکتور فروش
            </button>
            <a class="btn btn-outline-primary" href="moadian/invoices/new?article9=1">
                <i class="bi bi-clock-history me-1"></i>صورتحساب ماده ۹
            </a>
            <a class="btn btn-primary" href="moadian/invoices/new">
                <i class="bi bi-plus-lg me-1"></i>صورتحساب جدید
            </a>
        }
    </div>
</div>

<!-- فیلترهای جستجو -->
<div class="card mb-3 d-print-none">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label small mb-1">جستجو</label>
                <input class="form-control form-control-sm" @bind="filter.Search" @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown" placeholder="خریدار، شماره یا کد مالیاتی..." />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">وضعیت ارسال</label>
                <select class="form-select form-select-sm" value="@subFilterStr" @onchange="OnSubFilterChanged">
                    <option value="">همه</option>
                    <option value="0">پیش‌نویس</option>
                    <option value="2">در حال بررسی</option>
                    <option value="3">ثبت موفق</option>
                    <option value="4">رد شده</option>
                    <option value="5">عدم پاسخ</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">وضعیت کارپوشه</label>
                <select class="form-select form-select-sm" value="@folderFilterStr" @onchange="OnFolderFilterChanged">
                    <option value="">همه</option>
                    <option value="1">در انتظار تأیید</option>
                    <option value="2">تأیید شده</option>
                    <option value="3">تأیید سیستمی</option>
                    <option value="4">رد شده</option>
                    <option value="5">باطل شده</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">نحوه ارسال</label>
                <select class="form-select form-select-sm" value="@art9FilterStr" @onchange="OnArt9FilterChanged">
                    <option value="">همه</option>
                    <option value="false">عادی</option>
                    <option value="true">موضوع ماده ۹</option>
                </select>
            </div>

            <div class="col-6 col-md-1">
                <label class="form-label small mb-1">پرداخت</label>
                <select class="form-select form-select-sm" value="@payFilterStr" @onchange="OnPayFilterChanged">
                    <option value="">همه</option>
                    <option value="0">نسیه باز</option>
                    <option value="1">جزئی</option>
                    <option value="2">تسویه</option>
                </select>
            </div>

            <div class="col-6 col-md-1">
                <label class="form-label small mb-1">از تاریخ</label>
                <DatePicker Value="filter.FromDate" ValueChanged="OnFromChanged" AllowClear="true" />
            </div>

            <div class="col-6 col-md-1">
                <label class="form-label small mb-1">تا تاریخ</label>
                <DatePicker Value="filter.ToDate" ValueChanged="OnToChanged" AllowClear="true" />
            </div>

            <div class="col-6 col-md-1 d-grid">
                <button class="btn btn-sm btn-primary" disabled="@loading" @onclick="() => ApplyFilterAsync(1)">
                    <i class="bi bi-funnel"></i> فیلتر
                </button>
            </div>
        </div>
    </div>
</div>

<!-- نوار عملیات گروهی -->
@if (selectedIds.Count > 0)
{
    <div class="alert alert-primary py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <i class="bi bi-check2-square me-1"></i>
            <strong>@selectedIds.Count.Num()</strong> مورد انتخاب شده
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (Auth.Has("Moadian.InvoiceSend"))
            {
                <button class="btn btn-sm btn-success" disabled="@busy" @onclick="SendSelectedAsync">
                    <i class="bi bi-send me-1"></i>ارسال گروهی
                </button>
            }
            @if (Auth.Has("Moadian.InvoiceInquiry"))
            {
                <button class="btn btn-sm btn-info text-white" disabled="@busy" @onclick="InquirySubmissionSelectedAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i>استعلام ارسال
                </button>
            }
            @if (Auth.Has("Moadian.FolderStatus"))
            {
                <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="InquiryFolderSelectedAsync">
                    <i class="bi bi-folder-check me-1"></i>استعلام کارپوشه
                </button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => selectedIds.Clear()">لغو انتخاب</button>
        </div>
    </div>
}

<!-- جدول صورتحساب‌ها -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:36px">
                        <input type="checkbox" class="form-check-input" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                    </th>
                    <th>شماره / تاریخ</th>
                    <th>نوع و الگو</th>
                    <th>خریدار</th>
                    <th>شماره مالیاتی</th>
                    <th>مبلغ کل (ریال)</th>
                    <th>وضعیت ارسال</th>
                    <th>کارپوشه</th>
                    <th>پرداخت</th>
                    <th class="text-end">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (loading)
                {
                    <tr><td colspan="10" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                }
                else if (result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            صورتحسابی با فیلتر انتخابی یافت نشد.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var inv in result.Items)
                    {
                        var isChecked = selectedIds.Contains(inv.Id);
                        <tr class="@(isChecked ? "table-active" : "")">
                            <td>
                                <input type="checkbox" class="form-check-input" checked="@isChecked"
                                       @onchange="e => ToggleRow(inv.Id, e.Value is true)" />
                            </td>
                            <td>
                                <a class="fw-bold text-decoration-none" href="moadian/invoices/@inv.Id">@inv.InternalNumber</a>
                                <div class="small text-muted">@inv.IssueDate.ToFaDate()</div>
                                @if (inv.SourceFacInvoiceNumber.HasValue)
                                {
                                    <span class="badge bg-light text-dark border small">فاکتور @inv.SourceFacInvoiceNumber.Value.NoGroup()</span>
                                }
                            </td>
                            <td class="small">
                                <div>@(inv.InvoiceType == MdnInvoiceType.Type1 ? "نوع اول" : "نوع دوم") - @MdnUiLabels.PatternTitle(inv.Pattern)</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="badge @SubjectBadge(inv.Subject)">@MdnUiLabels.SubjectTitle(inv.Subject)</span>
                                    @if (inv.IsArticle9)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            ماده ۹
                                        </span>
                                    }
                                    else if (NeedsArticle9Confirmation(inv))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            خارج از مهلت
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@(inv.BuyerName ?? "مصرف‌کننده نهایی")</div>
                                @if (!string.IsNullOrWhiteSpace(inv.BuyerEconomicCode))
                                {
                                    <div class="small text-muted font-monospace">@inv.BuyerEconomicCode</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(inv.TaxId))
                                {
                                    <code class="small d-block">@inv.TaxId</code>
                                }
                                else
                                {
                                    <span class="text-muted small">تخصیص پس از ارسال</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(inv.ReferenceNumber))
                                {
                                    <div class="small text-muted font-monospace" title="کد رهگیری ارسال">Ref: @Shorten(inv.ReferenceNumber, 14)</div>
                                }
                            </td>
                            <td class="num">
                                <div class="fw-bold">@inv.TotalAmount.Money()</div>
                                <div class="small text-muted">VAT: @inv.TotalVat.Money()</div>
                            </td>
                            <td>
                                <span class="badge @SubmissionBadge(inv.SubmissionStatus)">@MdnUiLabels.SubmissionTitle(inv.SubmissionStatus)</span>
                                @if (!string.IsNullOrWhiteSpace(inv.LastErrorMessage) && inv.SubmissionStatus != MdnSubmissionStatus.Success)
                                {
                                    <div class="small text-danger mt-1 text-truncate" style="max-width:170px" title="@inv.LastErrorMessage">
                                        @inv.LastErrorMessage
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge @FolderBadge(inv.FolderStatus)">@MdnUiLabels.FolderTitle(inv.FolderStatus)</span>
                                @if (!string.IsNullOrWhiteSpace(inv.Article6Status))
                                {
                                    <div class="small text-muted mt-1">ماده ۶: @inv.Article6Status</div>
                                }
                            </td>
                            <td>
                                <span class="badge @PaymentBadge(inv.PaymentStatus)">@MdnUiLabels.PaymentStatusTitle(inv.PaymentStatus)</span>
                                <div class="small text-muted num mt-1">وصولی: @inv.PaidAmount.Money()</div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-primary" href="moadian/invoices/@inv.Id" title="مشاهده جزئیات، کارپوشه و ثبت پرداخت">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button class="btn btn-outline-secondary" @onclick="() => OpenJsonPreviewAsync(inv.Id)" title="پیش‌نمایش JSON">
                                        <i class="bi bi-filetype-json"></i>
                                    </button>
                                    @if (inv.SubmissionStatus is MdnSubmissionStatus.Draft or MdnSubmissionStatus.Failed)
                                    {
                                        @if (Auth.Has("Moadian.InvoiceUpdate"))
                                        {
                                            <a class="btn btn-outline-secondary" href="moadian/invoices/@inv.Id/edit" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (Auth.Has("Moadian.InvoiceSend"))
                                        {
                                            <button class="btn btn-outline-success" disabled="@busy" @onclick="() => SendSingleAsync(inv.Id)" title="ارسال به سامانه مودیان">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        }
                                        @if (Auth.Has("Moadian.InvoiceDelete"))
                                        {
                                            <button class="btn btn-outline-danger" disabled="@busy" @onclick="() => DeleteInvoiceAsync(inv.Id)" title="حذف پیش‌نویس">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        @if (Auth.Has("Moadian.InvoiceInquiry") || Auth.Has("Moadian.FolderStatus"))
                                        {
                                            <button class="btn btn-outline-info" disabled="@busy" @onclick="() => RefreshSingleAsync(inv.Id)" title="به‌روزرسانی وضعیت درگاه و کارپوشه">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        }
                                        @if (CanCancelFromList(inv) && (Auth.Has("Moadian.InvoiceSend") || Auth.Has("Moadian.InvoiceUpdate") || Auth.Has("Moadian.InvoiceCreate")))
                                        {
                                            <button class="btn btn-outline-danger" disabled="@busy" @onclick="() => PromptCancelInvoice(inv)" title="ابطال مستقیم در سامانه مودیان و استعلام خودکار">
                                                <i class="bi bi-x-octagon me-1"></i>ابطال
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (PageCount > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="small text-muted num">کل رکوردها: @result.TotalCount.Num()</span>
            <Pager Page="filter.Page" PageCount="PageCount" OnPageChanged="ApplyFilterAsync" />
        </div>
    }
</div>

<Modal Visible="jsonPreview is not null" Title="پیش‌نمایش JSON" Size="modal-lg" OnClose="() => jsonPreview = null">
    <ChildContent>
        @if (jsonPreview is not null)
        {
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2 small">
                <span>شماره مالیاتی: <code class="fs-6">@jsonPreview.PotentialTaxId</code></span>
                <span>سریال: <code>@jsonPreview.PotentialSerialHex</code></span>
                <span class="@MdnUiLabels.SendRuleBadgeClass(jsonPreview.IsArticle9)">
                    @MdnUiLabels.SendRuleTitle(jsonPreview.IsArticle9)
                </span>
            </div>
            @if (jsonPreview.ValidationWarnings.Count > 0)
            {
                <div class="alert alert-warning py-2 small">
                    @foreach (var w in jsonPreview.ValidationWarnings)
                    {
                        <div><i class="bi bi-exclamation-circle me-1"></i>@w</div>
                    }
                </div>
            }
            <pre class="bg-dark text-light p-3 rounded small font-monospace mb-0" dir="ltr" style="max-height:420px;overflow:auto">@jsonPreview.JsonPayload</pre>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="() => jsonPreview = null">بستن</button>
    </Footer>
</Modal>

<Modal Visible="showErpModal" Title="تبدیل از فاکتور فروش" Size="modal-lg" OnClose="() => showErpModal = false">
    <ChildContent>
        @if (erpLoading)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (erpInvoices.Count == 0)
        {
            <div class="text-center text-muted py-4">فاکتور فروشی یافت نشد.</div>
        }
        else
        {
            <div class="table-responsive" style="max-height:380px;overflow:auto">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>شماره فاکتور</th>
                            <th>تاریخ</th>
                            <th>طرف حساب</th>
                            <th>اقلام</th>
                            <th>مبلغ خالص</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in erpInvoices)
                        {
                            <tr>
                                <td class="fw-bold num">@f.Number.NoGroup()</td>
                                <td>@f.Date.ToFaDate()</td>
                                <td>
                                    <div>@f.PartyName</div>
                                    @if (!string.IsNullOrWhiteSpace(f.PartyTaxId))
                                    {
                                        <div class="small text-muted font-monospace">@f.PartyTaxId</div>
                                    }
                                </td>
                                <td class="num">@f.LineCount.Num()</td>
                                <td class="num">@f.TotalNet.Money()</td>
                                <td>
                                    @if (f.AlreadyImported)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">تبدیل شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">آماده تبدیل</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => ImportErpAsync(f.Id)">
                                        تبدیل به پیش‌نویس
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="() => showErpModal = false">بستن</button>
    </Footer>
</Modal>

<Modal Visible="pendingArticle9SendIds.Count > 0" Title="ارسال صورتحساب موضوع ماده ۹" OnClose="() => pendingArticle9SendIds.Clear()">
    <ChildContent>
        <div class="alert alert-warning py-2 small mb-3">
            از تاریخ صدور موارد زیر بیش از <strong>@deadlineDays.FaDigits() روز</strong> گذشته است. آیا به عنوان صورتحساب موضوع ماده ۹ ارسال شوند؟
        </div>
        <div class="border rounded p-2 bg-light small">
            @foreach (var item in result.Items.Where(x => pendingArticle9SendIds.Contains(x.Id)))
            {
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span><strong>@item.InternalNumber</strong> - @(item.BuyerName ?? "مصرف‌کننده نهایی")</span>
                    <span class="text-muted">@item.IssueDate.ToFaDate()</span>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" disabled="@busy" @onclick="() => pendingArticle9SendIds.Clear()">انصراف</button>
        <button class="btn btn-warning fw-semibold" disabled="@busy" @onclick="ConfirmPendingArticle9SendAsync">
            <i class="bi bi-send-check me-1"></i>تأیید و ارسال
        </button>
    </Footer>
</Modal>

<Modal Visible="cancelTarget is not null" Title="ابطال صورتحساب" OnClose="CloseCancelModal">
    <ChildContent>
        @if (cancelTarget is not null)
        {
            <div class="alert alert-danger py-2 small mb-3">
                صورتحساب ابطالی صادر و به سامانه مودیان ارسال می‌شود.
            </div>
            <div class="border rounded p-3 bg-light small mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">شماره صورتحساب:</span>
                    <strong>@cancelTarget.InternalNumber</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">خریدار:</span>
                    <strong>@(cancelTarget.BuyerName ?? "مصرف‌کننده نهایی")</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">مبلغ کل:</span>
                    <strong class="num">@cancelTarget.TotalAmount.Money() ریال</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">شماره مالیاتی مرجع:</span>
                    <code class="font-monospace">@cancelTarget.TaxId</code>
                </div>
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small mb-1">تاریخ ابطال</label>
                    <DatePicker Value="cancelReq.IssueDate" ValueChanged="OnCancelIssueDateChanged" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-1">علت ابطال</label>
                    <input class="form-control form-control-sm" @bind="cancelReq.Description" placeholder="اختیاری" />
                </div>

                @if (IsCancelPastDeadline)
                {
                    <div class="col-12 mt-2">
                        <div class="alert alert-warning py-2 px-3 mb-0 small">
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" id="chkCancelArt9" @bind="cancelReq.IsArticle9" />
                                <label class="form-check-label fw-semibold" for="chkCancelArt9">
                                    ارسال با ماده ۹ (بیش از @deadlineDays.FaDigits() روز از تاریخ گذشته)
                                </label>
                            </div>
                            @if (cancelReq.IsArticle9)
                            {
                                <div>
                                    <label class="form-label small mb-1">تاریخ ثبت</label>
                                    <DatePicker Value="cancelRegistrationNullable" ValueChanged="d => cancelReq.RegistrationDate = d ?? DateTime.Now" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (cancellingBusy)
            {
                <div class="d-flex align-items-center gap-2 text-primary small mt-3">
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>در حال ارسال ابطالی و دریافت نتیجه…</span>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" disabled="@cancellingBusy" @onclick="CloseCancelModal">انصراف</button>
        <button class="btn btn-danger" disabled="@(cancellingBusy || (IsCancelPastDeadline && !cancelReq.IsArticle9))" @onclick="ConfirmCancelAndInquireAsync">
            @if (cancellingBusy)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi bi-x-octagon me-1"></i>
            }
            تأیید و ابطال
        </button>
    </Footer>
</Modal>

@code {
    private MdnInvoiceFilterRequest filter = new() { Page = 1, PageSize = 20 };
    private MdnInvoiceListResultDto result = new();
    private HashSet<int> selectedIds = new();
    private List<int> pendingArticle9SendIds = new();
    private int deadlineDays = MdnArticle9Rules.DefaultSendDeadlineDays;

    private string subFilterStr = "";
    private string folderFilterStr = "";
    private string payFilterStr = "";
    private string art9FilterStr = "";

    private MdnInvoiceJsonPreviewDto? jsonPreview;
    private MdnInvoiceSummaryDto? cancelTarget;
    private MdnDirectCancelRequest cancelReq = new() { IssueDate = DateTime.Now };
    private DateTime? cancelRegistrationNullable => cancelReq.RegistrationDate ?? DateTime.Now;
    private bool IsCancelPastDeadline => MdnArticle9Rules.IsPastSendDeadline(cancelReq.IssueDate ?? DateTime.Now, deadlineDays);
    private bool cancellingBusy;
    private bool showErpModal;
    private bool erpLoading;
    private List<MdnErpFacInvoicePickDto> erpInvoices = new();

    private bool loading = true;
    private bool busy;

    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)result.TotalCount / filter.PageSize));
    private bool IsAllSelected => result.Items.Count > 0 && result.Items.All(i => selectedIds.Contains(i.Id));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var prof = await Mdn.GetProfileAsync();
            deadlineDays = MdnArticle9Rules.NormalizeDeadlineDays(prof.Article9SendDeadlineDays);
        }
        catch { /* در صورت عدم دسترسی به پروفایل، مقدار پیش‌فرض ۱۲ روز لحاظ می‌شود */ }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            result = await Mdn.GetInvoicesAsync(filter);
            selectedIds.RemoveWhere(id => result.Items.All(x => x.Id != id));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task ApplyFilterAsync(int page)
    {
        filter.Page = page;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFilterAsync(1);
    }

    private async Task OnSubFilterChanged(ChangeEventArgs e)
    {
        subFilterStr = e.Value?.ToString() ?? "";
        filter.SubmissionStatus = int.TryParse(subFilterStr, out var v) ? (MdnSubmissionStatus)v : null;
        await ApplyFilterAsync(1);
    }

    private async Task OnFolderFilterChanged(ChangeEventArgs e)
    {
        folderFilterStr = e.Value?.ToString() ?? "";
        filter.FolderStatus = int.TryParse(folderFilterStr, out var v) ? (MdnFolderStatus)v : null;
        await ApplyFilterAsync(1);
    }

    private async Task OnPayFilterChanged(ChangeEventArgs e)
    {
        payFilterStr = e.Value?.ToString() ?? "";
        filter.PaymentStatus = int.TryParse(payFilterStr, out var v) ? (MdnPaymentStatus)v : null;
        await ApplyFilterAsync(1);
    }

    private async Task OnArt9FilterChanged(ChangeEventArgs e)
    {
        art9FilterStr = e.Value?.ToString() ?? "";
        filter.IsArticle9 = art9FilterStr switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
        await ApplyFilterAsync(1);
    }

    private async Task OnFromChanged(DateTime? d) { filter.FromDate = d; await ApplyFilterAsync(1); }
    private async Task OnToChanged(DateTime? d) { filter.ToDate = d; await ApplyFilterAsync(1); }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is true)
            foreach (var i in result.Items) selectedIds.Add(i.Id);
        else
            selectedIds.Clear();
    }

    private void ToggleRow(int id, bool check)
    {
        if (check) selectedIds.Add(id);
        else selectedIds.Remove(id);
    }

    private bool NeedsArticle9Confirmation(MdnInvoiceSummaryDto inv) =>
        !inv.IsArticle9 &&
        inv.SubmissionStatus is MdnSubmissionStatus.Draft or MdnSubmissionStatus.Failed or MdnSubmissionStatus.Timeout or MdnSubmissionStatus.NotFound &&
        MdnArticle9Rules.IsPastSendDeadline(inv.IssueDate, deadlineDays);

    private async Task SendSingleAsync(int id)
    {
        var inv = result.Items.FirstOrDefault(x => x.Id == id);
        if (inv is not null && NeedsArticle9Confirmation(inv))
        {
            pendingArticle9SendIds = new List<int> { id };
            return;
        }
        await RunBatchAsync(() => Mdn.SendInvoicesAsync(new List<int> { id }));
    }

    private async Task SendSelectedAsync()
    {
        var ids = selectedIds.ToList();
        if (result.Items.Any(x => ids.Contains(x.Id) && NeedsArticle9Confirmation(x)))
        {
            pendingArticle9SendIds = ids;
            return;
        }
        await RunBatchAsync(() => Mdn.SendInvoicesAsync(ids));
    }

    private async Task ConfirmPendingArticle9SendAsync()
    {
        var ids = pendingArticle9SendIds.ToList();
        pendingArticle9SendIds.Clear();
        if (ids.Count == 0) return;
        await RunBatchAsync(() => Mdn.SendInvoicesAsync(ids, confirmArticle9: true));
    }

    private async Task InquirySubmissionSelectedAsync() => await RunBatchAsync(() => Mdn.InquirySubmissionsAsync(selectedIds.ToList()));
    private async Task InquiryFolderSelectedAsync() => await RunBatchAsync(() => Mdn.InquiryFolderAsync(selectedIds.ToList()));
    private async Task RefreshSingleAsync(int id) => await RunBatchAsync(() => Mdn.RefreshAllAsync(new List<int> { id }));

    private static bool CanCancelFromList(MdnInvoiceSummaryDto inv) =>
        !string.IsNullOrWhiteSpace(inv.TaxId) &&
        inv.Subject != MdnInvoiceSubject.Cancellation &&
        inv.FolderStatus != MdnFolderStatus.Cancelled &&
        inv.SubmissionStatus is MdnSubmissionStatus.Success or MdnSubmissionStatus.InProgress or MdnSubmissionStatus.Sent;

    private void PromptCancelInvoice(MdnInvoiceSummaryDto inv)
    {
        if (busy || cancellingBusy) return;
        cancelTarget = inv;
        cancelReq = new MdnDirectCancelRequest
        {
            IssueDate = DateTime.Now,
            IsArticle9 = false,
            RegistrationDate = null
        };
    }

    private void OnCancelIssueDateChanged(DateTime? d)
    {
        if (!d.HasValue) return;
        cancelReq.IssueDate = d.Value;
        if (MdnArticle9Rules.IsPastSendDeadline(d.Value, deadlineDays))
        {
            cancelReq.RegistrationDate ??= DateTime.Now;
        }
        else
        {
            cancelReq.IsArticle9 = false;
            cancelReq.RegistrationDate = null;
        }
    }

    private void CloseCancelModal()
    {
        if (cancellingBusy) return;
        cancelTarget = null;
    }

    private async Task ConfirmCancelAndInquireAsync()
    {
        if (cancelTarget is null || cancellingBusy) return;
        cancellingBusy = true;
        busy = true;
        try
        {
            var res = await Mdn.CancelAndInquireAsync(cancelTarget.Id, cancelReq);
            cancelTarget = null;

            if (res.IsConfirmedCancelled)
                Toast.Success(res.Message);
            else if (res.SubmissionStatus == MdnSubmissionStatus.Failed)
                Toast.Error(res.Message);
            else
                Toast.Warning(res.Message);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            cancellingBusy = false;
            busy = false;
        }
    }

    private async Task RunBatchAsync(Func<Task<MdnBatchActionResultDto>> action)
    {
        busy = true;
        try
        {
            var res = await action();
            if (res.Failed == 0 && res.Succeeded > 0) Toast.Success(res.Message);
            else if (res.Succeeded > 0) Toast.Warning(res.Message);
            else Toast.Info(res.Message);
            await LoadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task DeleteInvoiceAsync(int id)
    {
        busy = true;
        try
        {
            await Mdn.DeleteInvoiceAsync(id);
            Toast.Success("پیش‌نویس صورتحساب حذف شد.");
            await LoadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task OpenJsonPreviewAsync(int id)
    {
        try { jsonPreview = await Mdn.PreviewJsonAsync(id); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task OpenErpImportModalAsync()
    {
        showErpModal = true;
        erpLoading = true;
        try { erpInvoices = await Mdn.GetErpInvoicesAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { erpLoading = false; }
    }

    private async Task ImportErpAsync(int facId)
    {
        busy = true;
        try
        {
            var detail = await Mdn.ImportErpInvoiceAsync(facId);
            showErpModal = false;
            Toast.Success($"پیش‌نویس مودیان {detail.InternalNumber} ایجاد شد.");
            Nav.NavigateTo($"moadian/invoices/{detail.Id}");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private static string Shorten(string s, int max) => s.Length <= max ? s : s[..max] + "…";

    private static string SubjectBadge(MdnInvoiceSubject s) => s switch
    {
        MdnInvoiceSubject.Original => "bg-light text-dark border",
        MdnInvoiceSubject.Corrective => "bg-info-subtle text-info-emphasis",
        MdnInvoiceSubject.Cancellation => "bg-danger-subtle text-danger",
        MdnInvoiceSubject.SalesReturn => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-light text-dark"
    };

    private static string SubmissionBadge(MdnSubmissionStatus s) => s switch
    {
        MdnSubmissionStatus.Success => "bg-success-subtle text-success",
        MdnSubmissionStatus.Sent or MdnSubmissionStatus.InProgress => "bg-info-subtle text-info-emphasis",
        MdnSubmissionStatus.Failed or MdnSubmissionStatus.Timeout => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };

    private static string FolderBadge(MdnFolderStatus s) => s switch
    {
        MdnFolderStatus.Approved or MdnFolderStatus.SystemApproved => "bg-primary-subtle text-primary",
        MdnFolderStatus.Pending => "bg-warning-subtle text-warning-emphasis",
        MdnFolderStatus.Rejected or MdnFolderStatus.Cancelled => "bg-danger-subtle text-danger",
        _ => "bg-light text-muted"
    };

    private static string PaymentBadge(MdnPaymentStatus s) => s switch
    {
        MdnPaymentStatus.Paid => "bg-success-subtle text-success",
        MdnPaymentStatus.PartiallyPaid => "bg-warning-subtle text-warning-emphasis",
        MdnPaymentStatus.Unpaid => "bg-secondary-subtle text-secondary",
        _ => "bg-light text-muted"
    };
}
