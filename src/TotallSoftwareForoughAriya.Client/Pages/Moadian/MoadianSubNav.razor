@inject IAuthState Auth

<div class="card mb-3 d-print-none border-0 shadow-sm">
    <div class="card-body py-2 px-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fw-bold text-primary me-2">
                <i class="bi bi-shield-lock-fill me-1"></i>سامانه مودیان
            </span>

            <NavLink class="btn btn-sm btn-outline-secondary" href="moadian" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-1"></i>نمای کلی
            </NavLink>

            <NavLink class="btn btn-sm btn-outline-secondary" href="moadian/invoices" Match="NavLinkMatch.All">
                <i class="bi bi-journal-text me-1"></i>صورتحساب‌ها
            </NavLink>

            @if (Auth.Has("Moadian.InvoiceCreate"))
            {
                <NavLink class="btn btn-sm btn-outline-secondary" href="moadian/invoices/new">
                    <i class="bi bi-journal-plus me-1"></i>صدور صورتحساب
                </NavLink>
            }

            @if (Auth.Has("Moadian.FolderStatus") || Auth.Has("Moadian.PaymentRegister") || Auth.Has("Moadian.InvoiceInquiry"))
            {
                <NavLink class="btn btn-sm btn-outline-secondary" href="moadian/status-payments">
                    <i class="bi bi-credit-card-2-front me-1"></i>وضعیت کارپوشه و پرداخت‌ها
                </NavLink>
            }

            @if (Auth.Has("Moadian.MasterData") || Auth.Has("Moadian.View"))
            {
                <NavLink class="btn btn-sm btn-outline-secondary" href="moadian/basic-info">
                    <i class="bi bi-archive me-1"></i>اطلاعات پایه
                </NavLink>
            }

            @if (Auth.Has("Moadian.Certificate") || Auth.Has("Moadian.Diagnose"))
            {
                <NavLink class="btn btn-sm btn-outline-secondary" href="moadian/profile">
                    <i class="bi bi-patch-check me-1"></i>پرونده و گواهی امضا
                </NavLink>
            }

            <NavLink class="btn btn-sm btn-outline-secondary ms-auto" href="moadian/guide">
                <i class="bi bi-journal-check me-1"></i>راهنما
            </NavLink>
        </div>
    </div>
</div>
