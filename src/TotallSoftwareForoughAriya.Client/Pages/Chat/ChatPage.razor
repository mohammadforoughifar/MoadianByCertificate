@page "/chat"
@page "/chat/{ConversationId:int}"
@inject IChatClientService Chat
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="telegram-container">
    @* ========================== ستون سمت راست: لیست گفتگوها (Sidebar) ========================== *@
    @* نمایش/مخفی‌سازی ستون‌ها فقط با CSS (بدون وابستگی به JS): در موبایل یا فهرست یا گفتگو *@
    <div class="telegram-sidebar @(activeConv != null ? "d-none d-md-flex" : "")">
        <div class="sidebar-header">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="chat-avatar-self">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-7">پیام‌رسان سازمانی</div>
                        <div class="fs-9 text-muted">@Auth.DisplayName</div>
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-icon" title="گفتگوی دونفره جدید" @onclick="OpenNewDirectModal">
                        <i class="bi bi-pencil-square fs-6 text-primary"></i>
                    </button>
                    <button class="btn btn-sm btn-icon" title="ایجاد گروه کاری" @onclick="OpenNewGroupModal">
                        <i class="bi bi-people-fill fs-6 text-success"></i>
                    </button>
                </div>
            </div>

            <div class="chat-connection-status fs-9 mt-2 @(Chat.IsConnected ? "text-success" : "text-warning")"
                 role="status" data-testid="chat-connection" data-connected="@Chat.IsConnected.ToString().ToLowerInvariant()">
                <i class="bi @(Chat.IsConnected ? "bi-wifi" : "bi-arrow-repeat") me-1"></i>
                @(Chat.IsConnected ? "اتصال زنده برقرار است" : "در حال اتصال مجدد؛ همگام‌سازی خودکار ادامه دارد")
            </div>

            @* جستجوی گفتگوها *@
            <div class="chat-search-wrap mt-2">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="form-control form-control-sm chat-search-input"
                       placeholder="جستجوی کاربران و گفتگوها..." aria-label="جستجوی کاربران و گفتگوها"
                       @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button class="btn-clear-search" @onclick="ClearSearch"><i class="bi bi-x"></i></button>
                }
            </div>

            @* تب‌های فیلتر *@
            <div class="chat-filter-tabs mt-2">
                <button class="tab-btn @(currentTab == "all" ? "active" : "")" @onclick='() => ChangeTab("all")'>همه</button>
                <button class="tab-btn @(currentTab == "direct" ? "active" : "")" @onclick='() => ChangeTab("direct")'>خصوصی</button>
                <button class="tab-btn @(currentTab == "group" ? "active" : "")" @onclick='() => ChangeTab("group")'>گروه‌ها</button>
                <button class="tab-btn @(currentTab == "unread" ? "active" : "")" @onclick='() => ChangeTab("unread")'>
                    نخوانده
                    @if (totalUnread > 0)
                    {
                        <span class="tab-unread-pill">@totalUnread</span>
                    }
                </button>
            </div>
        </div>

        @* فهرست گفتگوها *@
        <div class="dialogs-list">
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <section class="border-bottom p-2" aria-label="کاربران سازمان" data-testid="chat-contact-results" aria-live="polite">
                    <div class="fw-bold fs-8 text-primary px-2 mb-2">کاربران سازمان — شروع گفتگو</div>
                    @if (loadingSidebarUsers)
                    {
                        <div class="text-center py-3 text-muted fs-8">
                            <span class="spinner-border spinner-border-sm me-1"></span>در حال جستجوی کاربران...
                        </div>
                    }
                    else if (sidebarUsersError != null)
                    {
                        <div class="alert alert-danger fs-9 mb-1" role="alert">
                            @sidebarUsersError
                            <button type="button" class="btn btn-sm btn-outline-danger d-block mt-2" @onclick="RetrySidebarUsers">تلاش مجدد</button>
                        </div>
                    }
                    else if (sidebarUsers.Count == 0)
                    {
                        <div class="text-muted fs-8 p-2">کاربری با این مشخصات یافت نشد.</div>
                    }
                    else
                    {
                        @foreach (var u in sidebarUsers)
                        {
                            <button type="button" @key="u.Id" class="user-picker-item w-100 border-0 bg-transparent"
                                    style="text-align: start;" @onclick="() => StartDirectWith(u.Id)" disabled="@startingDirectUserId.HasValue">
                                <div class="dialog-avatar direct-avatar sm"><i class="bi bi-person"></i></div>
                                <div class="flex-grow-1 min-w-0 ms-2">
                                    <div class="fw-bold fs-8">@u.DisplayName</div>
                                    <div class="fs-9 text-muted">@u.Username @(!string.IsNullOrWhiteSpace(u.Department) ? $"— {u.Department}" : "")</div>
                                </div>
                                <i class="bi bi-chat-dots text-primary" aria-hidden="true"></i>
                            </button>
                        }
                    }
                </section>
                <div class="fw-bold fs-8 text-muted px-3 pt-3">گفتگوها</div>
            }
            @if (loadingConversations)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                    <div class="fs-8">در حال بارگذاری گفتگوها...</div>
                </div>
            }
            else if (conversations.Count == 0)
            {
                <div class="text-center py-5 text-muted px-3">
                    <i class="bi bi-chat-square-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    <div class="fw-bold fs-8">گفتگویی یافت نشد</div>
                    <div class="fs-9 mt-1">با همکاران خود در سازمان گفتگوی جدیدی آغاز کنید.</div>
                    <button class="btn btn-sm btn-primary mt-3" @onclick="OpenNewDirectModal">
                        <i class="bi bi-plus-lg me-1"></i>شروع گفتگوی جدید
                    </button>
                </div>
            }
            else
            {
                @foreach (var c in conversations)
                {
                    <div @key="c.Id" class="dialog-item @(activeConv?.Id == c.Id ? "active" : "") @(c.IsPinned ? "pinned" : "")"
                         data-conversation-id="@c.Id" @onclick="() => SelectConversation(c)">
                        <div class="dialog-avatar-wrap">
                            @if (c.Type == ChatTypeDto.Direct)
                            {
                                <div class="dialog-avatar direct-avatar">
                                    <i class="bi bi-person"></i>
                                </div>
                                @if (c.DirectPeerIsOnline)
                                {
                                    <span class="online-indicator" title="آنلاین"></span>
                                }
                            }
                            else
                            {
                                <div class="dialog-avatar group-avatar">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                            }
                        </div>

                        <div class="dialog-info">
                            <div class="dialog-top">
                                <div class="dialog-heading">
                                    <div class="dialog-title text-truncate">
                                        @if (c.IsPinned)
                                        {
                                            <i class="bi bi-pin-angle-fill text-warning me-1 fs-9"></i>
                                        }
                                        @c.Title
                                    </div>
                                    @if (c.UnreadCount > 0)
                                    {
                                        <span class="unread-badge" data-testid="unread-count" aria-label="@($"{c.UnreadCount} پیام خوانده‌نشده")">@c.UnreadCount</span>
                                    }
                                </div>
                                <div class="dialog-time">@FormatTime(c.LastMessageAt)</div>
                            </div>
                            <div class="dialog-bottom">
                                <div class="dialog-snippet text-truncate">
                                    @if (typingUsers.TryGetValue(c.Id, out var typer))
                                    {
                                        <span class="text-success fst-italic">@typer در حال نوشتن...</span>
                                    }
                                    else
                                    {
                                        @if (c.Type == ChatTypeDto.Group && !string.IsNullOrWhiteSpace(c.LastMessageSenderName))
                                        {
                                            <span class="fw-bold text-dark me-1">@c.LastMessageSenderName:</span>
                                        }
                                        @c.LastMessageSnippet
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ========================== ستون سمت چپ: پنجره فعال گفتگو (Chat Window) ========================== *@
    <div class="telegram-main @(activeConv == null ? "d-none d-md-flex" : "")">
        @if (activeConv == null)
        {
            <div class="chat-placeholder">
                <div class="placeholder-card">
                    <div class="placeholder-icon">
                        <i class="bi bi-chat-left-quote-fill"></i>
                    </div>
                    <div class="fw-bold fs-5 mb-1">پیام‌رسان سازمانی</div>
                    <div class="text-muted fs-8 mb-4">یک گفتگو را از فهرست انتخاب کنید یا پیام جدیدی ارسال نمایید.</div>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="OpenNewDirectModal">
                            <i class="bi bi-chat-dots me-1"></i>گفتگوی جدید
                        </button>
                        <button class="btn btn-outline-success btn-sm" @onclick="OpenNewGroupModal">
                            <i class="bi bi-people me-1"></i>گروه جدید
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* هدر چت فعال *@
            <div class="chat-header">
                <div class="d-flex align-items-center gap-2">
                    @* دکمه برگشت به فهرست گفتگوها — همیشه رندر می‌شود و فقط با CSS در دسکتاپ مخفی است.
                       قبلاً به isMobileView (تشخیص JS) وابسته بود؛ اگر interop دیر می‌رسید یا خطا می‌داد،
                       دکمه ظاهر نمی‌شد و کاربر داخل گفتگوی خصوصی گیر می‌کرد. *@
                    <button class="btn btn-sm btn-icon me-1 d-md-none chat-back-btn" title="بازگشت به فهرست گفتگوها"
                            aria-label="بازگشت به فهرست گفتگوها" @onclick="BackToSidebar">
                        <i class="bi bi-arrow-right fs-6"></i>
                    </button>
                    <div class="dialog-avatar-wrap">
                        @if (activeConv.Type == ChatTypeDto.Direct)
                        {
                            <div class="dialog-avatar direct-avatar sm">
                                <i class="bi bi-person"></i>
                            </div>
                            @if (activeConv.DirectPeerIsOnline)
                            {
                                <span class="online-indicator sm"></span>
                            }
                        }
                        else
                        {
                            <div class="dialog-avatar group-avatar sm" @onclick="OpenGroupInfoModal" style="cursor:pointer">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <div class="fw-bold fs-7 d-flex align-items-center gap-1">
                            @activeConv.Title
                            @if (activeConv.Type == ChatTypeDto.Group)
                            {
                                <span class="badge bg-secondary-subtle text-secondary fs-9">گروه</span>
                            }
                        </div>
                        <div class="fs-9 text-muted">
                            @if (typingUsers.TryGetValue(activeConv.Id, out var typer))
                            {
                                <span class="text-success fw-bold">@typer در حال نوشتن...</span>
                            }
                            else if (activeConv.Type == ChatTypeDto.Direct)
                            {
                                if (activeConv.DirectPeerIsOnline)
                                {
                                    <span class="text-success fw-600">آنلاین</span>
                                }
                                else if (activeConv.DirectPeerLastSeen.HasValue)
                                {
                                    <span>آخرین بازدید @activeConv.DirectPeerLastSeen.Value.ToFaDateTime()</span>
                                }
                                else
                                {
                                    <span>آفلاین</span>
                                }
                            }
                            else
                            {
                                <span>@activeConv.MembersCount عضو</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1">
                    @if (activeConv.Type == ChatTypeDto.Group)
                    {
                        <button class="btn btn-sm btn-icon" title="اعضای گروه" @onclick="OpenGroupInfoModal">
                            <i class="bi bi-info-circle fs-6"></i>
                        </button>
                    }
                    <button class="btn btn-sm btn-icon" title="@(activeConv.IsPinned ? "برداشتن پین" : "پین گفتگو")" @onclick="TogglePinConversation">
                        <i class="bi @(activeConv.IsPinned ? "bi-pin-angle-fill text-warning" : "bi-pin-angle") fs-6"></i>
                    </button>
                    <button class="btn btn-sm btn-icon" title="@(activeConv.IsMuted ? "فعال‌سازی صدا" : "بی‌صدا کردن")" @onclick="ToggleMuteConversation">
                        <i class="bi @(activeConv.IsMuted ? "bi-bell-slash text-danger" : "bi-bell") fs-6"></i>
                    </button>
                </div>
            </div>

            @* نوار پیام پین‌شده *@
            @if (activeConv.PinnedMessageId.HasValue)
            {
                <div class="pinned-bar">
                    <i class="bi bi-pin-fill text-primary me-2"></i>
                    <div class="flex-grow-1 text-truncate fs-8">
                        <span class="fw-bold">پیام سنجاق‌شده:</span> @(activeConv.PinnedMessageSnippet ?? "مشاهده پیام")
                    </div>
                </div>
            }

            @* جریان پیام‌ها (Message Stream) *@
            <div class="chat-messages-scroll" id="chatMessagesScroll">
                @if (loadingMessages)
                {
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary mb-1"></div>
                        <div class="fs-8">در حال بارگذاری پیام‌ها...</div>
                    </div>
                }
                else if (messages.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-chat-dots fs-2 text-secondary opacity-50 d-block mb-2"></i>
                        <div class="fs-8">هنوز پیامی ارسال نشده است. اولین پیام را شما بنویسید!</div>
                    </div>
                }
                else
                {
                    @foreach (var msg in messages)
                    {
                        @if (msg.MessageType == ChatMessageTypeDto.System)
                        {
                            <div class="system-message-row">
                                <span class="system-bubble">@msg.Text</span>
                            </div>
                        }
                        else
                        {
                            <div @key="msg.Id" class="message-row @(msg.IsOutgoing ? "outgoing" : "incoming")" id="msg-@msg.Id">
                                <div class="message-bubble @(msg.IsOutgoing ? "bubble-out" : "bubble-in") @(tappedActionsMsgId == msg.Id ? "actions-open" : "") @BubbleFx(msg)"
                                     @onclick="() => ToggleBubbleActions(msg.Id)">
                                    @if (copiedMsgId == msg.Id)
                                    {
                                        <span class="bubble-copied-chip" role="status"><i class="bi bi-check2"></i> کپی شد</span>
                                    }
                                    @* نام فرستنده در گروه‌ها برای پیام‌های دریافتی *@
                                    @if (!msg.IsOutgoing && activeConv.Type == ChatTypeDto.Group)
                                    {
                                        <div class="bubble-sender">@msg.SenderName</div>
                                    }

                                    @* بخش ریپلای *@
                                    @if (msg.ReplyToMessageId.HasValue)
                                    {
                                        <div class="bubble-reply-preview" @onclick="() => ScrollToMessage(msg.ReplyToMessageId.Value)">
                                            <div class="reply-bar"></div>
                                            <div class="reply-body">
                                                <div class="reply-sender">@msg.ReplyToSenderName</div>
                                                <div class="reply-text text-truncate">@msg.ReplyToSnippet</div>
                                            </div>
                                        </div>
                                    }

                                    @* نشان فوروارد — نام فرستندهٔ اصلی *@
                                    @if (!string.IsNullOrWhiteSpace(msg.ForwardFromSenderName))
                                    {
                                        <div class="bubble-forward-label" dir="rtl">
                                            <i class="bi bi-forward-fill"></i>
                                            <span>فوروارد شده از </span><b>@msg.ForwardFromSenderName</b>
                                        </div>
                                    }

                                    @* پیش‌نمایش و دانلود همیشه از endpoint دارای کنترل عضویت در API *@
                                    @if (!string.IsNullOrWhiteSpace(msg.FileUrl))
                                    {
                                        @if (msg.MessageType == ChatMessageTypeDto.Image)
                                        {
                                            @* کلیک روی تصویر: پیش‌نمایش بزرگ در همان صفحه (لایت‌باکس) — بدون باز کردن تب جدید *@
                                            <img src="@Chat.GetFileUrl(msg.Id, true)" class="bubble-img chat-img-zoom" alt="@msg.FileName"
                                                 title="@($"نمایش بزرگ‌تر — {msg.FileName}")" loading="lazy" referrerpolicy="no-referrer"
                                                 @onclick="() => OpenImagePreview(msg)" />
                                        }
                                        else if (msg.MessageType == ChatMessageTypeDto.Audio)
                                        {
                                            <audio controls preload="none" class="w-100 mt-1" src="@Chat.GetFileUrl(msg.Id, true)"></audio>
                                            @* تبدیل ویس به متن: متن رونویسی‌شده + دکمهٔ تبدیل/تبدیل دوباره *@
                                            <div class="voice-transcript-block">
                                                @if (!string.IsNullOrWhiteSpace(msg.Transcript))
                                                {
                                                    <div class="voice-transcript" data-testid="voice-transcript">
                                                        <div class="vt-head">
                                                            <span class="vt-title"><i class="bi bi-file-text"></i> متن پیام صوتی</span>
                                                            <span class="vt-actions">
                                                                <button type="button" class="btn-icon-xs" title="کپی متن"
                                                                        @onclick="() => CopyTranscript(msg.Transcript!)">
                                                                    <i class="bi bi-clipboard"></i>
                                                                </button>
                                                                <button type="button" class="btn-icon-xs" title="تبدیل دوباره به متن"
                                                                        disabled="@IsTranscribing(msg.Id)"
                                                                        @onclick="() => TranscribeVoice(msg, force: true)">
                                                                    @if (IsTranscribing(msg.Id))
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-arrow-repeat"></i>
                                                                    }
                                                                </button>
                                                            </span>
                                                        </div>
                                                        <div class="vt-text">@msg.Transcript</div>
                                                        @if (msg.TranscribedAt.HasValue)
                                                        {
                                                            <div class="vt-time fs-9 text-muted">تبدیل‌شده: @msg.TranscribedAt.Value.ToString("HH:mm")</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary voice-stt-btn"
                                                            disabled="@IsTranscribing(msg.Id)"
                                                            @onclick="() => TranscribeVoice(msg, force: false)"
                                                            data-testid="@($"voice-transcribe-{msg.Id}")"
                                                            title="تبدیل این پیام صوتی به متن">
                                                        @if (IsTranscribing(msg.Id))
                                                        {
                                                            <span class="spinner-border spinner-border-sm ms-1"></span>
                                                            <span>در حال تبدیل…</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-file-earmark-text"></i>
                                                            <span>تبدیل به متن</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else if (msg.MessageType == ChatMessageTypeDto.Video)
                                        {
                                            <video controls preload="metadata" class="bubble-video" src="@Chat.GetFileUrl(msg.Id, true)"></video>
                                        }
                                        <div class="bubble-file-card">
                                            <div class="file-icon"><i class="bi bi-file-earmark-arrow-down-fill fs-3 text-primary"></i></div>
                                            <div class="file-info text-truncate">
                                                <div class="file-name text-truncate">@msg.FileName</div>
                                                <div class="file-size fs-9 text-muted">@FormatFileSize(msg.FileSizeBytes)</div>
                                            </div>
                                            @* دانلود در همان صفحه/تب؛ بدون target=_blank تا تب جدید باز نشود و PWA آن را نرباید *@
                                            <a href="@Chat.GetFileUrl(msg.Id)" download="@msg.FileName" class="btn btn-sm btn-light file-dl-btn"
                                               referrerpolicy="no-referrer" aria-label="@($"دانلود {msg.FileName}")">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    }

                                    @* کارت اشتراک سند/موجودیت سازمانی ERP *@
                                    @if (!string.IsNullOrWhiteSpace(msg.ErpModule))
                                    {
                                        <div class="bubble-erp-card">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-primary text-white fs-9">@msg.ErpModule</span>
                                                <span class="fw-bold fs-8">@msg.ErpEntityTitle</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(msg.ErpEntitySummary))
                                            {
                                                <div class="fs-9 text-muted mb-2">@msg.ErpEntitySummary</div>
                                            }
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => NavigateToErp(msg.ErpModule, msg.ErpEntityId)">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>مشاهده در سیستم
                                            </button>
                                        </div>
                                    }

                                    @* متن پیام *@
                                    @if (!string.IsNullOrWhiteSpace(msg.Text))
                                    {
                                        <div class="bubble-text">@msg.Text</div>
                                    }

                                    @* نوار اطلاعات زیرین پیام (ساعت، تیک، ویرایش) *@
                                    <div class="bubble-footer">
                                        @if (msg.IsEdited)
                                        {
                                            <span class="edited-label">ویرایش‌شده</span>
                                        }
                                        <span class="bubble-time">@msg.CreatedAt.ToString("HH:mm")</span>
                                        @if (msg.IsOutgoing)
                                        {
                                            <span class="bubble-checks">
                                                @if (msg.IsReadByPeer)
                                                {
                                                    <i class="bi bi-check2-all text-primary fw-bold" title="خوانده شد"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2 text-muted" title="ارسال شد"></i>
                                                }
                                            </span>
                                        }
                                    </div>

                                    @* واکنش‌های ثبت‌شده *@
                                    @if (msg.Reactions.Count > 0)
                                    {
                                        <div class="bubble-reactions">
                                            @foreach (var r in msg.Reactions)
                                            {
                                                bool hasMine = r.Value.Any(u => u.UserId == Auth.UserId);
                                                <button class="reaction-pill @(hasMine ? "active" : "")"
                                                        title="@string.Join("، ", r.Value.Select(u => u.UserName))"
                                                        @onclick="() => ToggleReaction(msg.Id, r.Key)">
                                                    <span>@r.Key</span>
                                                    <span class="count">@r.Value.Count</span>
                                                </button>
                                            }
                                        </div>
                                    }

                                    @* منوی سریع روی حباب پیام (Hover Actions) *@
                                    <div class="bubble-actions-overlay" @onmousedown:preventDefault="true">
                                        <button class="action-btn" title="پاسخ (Reply)" @onclick="() => StartReply(msg)">
                                            <i class="bi bi-reply-fill"></i>
                                        </button>
                                        @if (!string.IsNullOrWhiteSpace(msg.Text) && !msg.IsDeleted)
                                        {
                                            <button class="action-btn" title="کپی متن" @onclick="() => CopyMessageText(msg)">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        }
                                        @if (!msg.IsDeleted)
                                        {
                                            <button class="action-btn" title="فوروارد" @onclick="() => OpenForward(msg)">
                                                <i class="bi bi-forward-fill"></i>
                                            </button>
                                        }
                                        <button class="action-btn" title="واکنش 👍" @onclick='() => ToggleReaction(msg.Id, "👍")'>
                                            👍
                                        </button>
                                        <button class="action-btn" title="واکنش ❤️" @onclick='() => ToggleReaction(msg.Id, "❤️")'>
                                            ❤️
                                        </button>
                                        <button class="action-btn" title="سنجاق پیام" @onclick="() => TogglePinMsg(msg.Id)">
                                            <i class="bi bi-pin-angle"></i>
                                        </button>
                                        @if (msg.IsOutgoing && !msg.IsDeleted)
                                        {
                                            <button class="action-btn" title="ویرایش" @onclick="() => StartEdit(msg)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="action-btn text-danger" title="حذف" @onclick="() => DeleteMsg(msg.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            @* بخش ورودی پیام (Input Toolbar) *@
            <div class="chat-input-area">
                @if (isUploading)
                {
                    <div class="input-banner fs-8" role="status" data-testid="upload-progress">
                        <span class="spinner-border spinner-border-sm me-2"></span>در حال بارگذاری @uploadingFileName ...
                    </div>
                }
                else if (uploadingFile != null)
                {
                    <div class="input-banner fs-8" data-testid="attachment-ready">
                        <i class="bi bi-paperclip me-2"></i>
                        <span class="flex-grow-1 text-truncate">@uploadingFile.FileName — @FormatFileSize(uploadingFile.FileSizeBytes) (آمادهٔ ارسال)</span>
                        <button type="button" class="btn-close" title="حذف پیوست انتخابی" aria-label="حذف پیوست انتخابی" disabled="@isSending" @onclick="RemovePendingAttachment"></button>
                    </div>
                }
                @* بنر ریپلای یا ادیت *@
                @if (replyingTo != null)
                {
                    <div class="composer-banner is-reply" @key="@($"r{replyingTo.Id}")">
                        <div class="cb-icon"><i class="bi bi-reply-fill"></i></div>
                        <div class="cb-body" title="رفتن به پیام" @onclick="() => ScrollToMessage(replyingTo.Id)">
                            <div class="cb-title">پاسخ به @replyingTo.SenderName</div>
                            <div class="cb-text">@MsgSnippet(replyingTo)</div>
                        </div>
                        <button type="button" class="cb-close" title="لغو (Esc)" aria-label="لغو پاسخ" @onclick="CancelReply"><i class="bi bi-x-lg"></i></button>
                    </div>
                }
                else if (editingMsg != null)
                {
                    <div class="composer-banner is-edit" @key="@($"e{editingMsg.Id}")">
                        <div class="cb-icon"><i class="bi bi-pencil-fill"></i></div>
                        <div class="cb-body" title="رفتن به پیام" @onclick="() => ScrollToMessage(editingMsg.Id)">
                            <div class="cb-title">ویرایش پیام</div>
                            <div class="cb-text">@MsgSnippet(editingMsg)</div>
                        </div>
                        <button type="button" class="cb-close" title="لغو (Esc)" aria-label="لغو ویرایش" @onclick="CancelEdit"><i class="bi bi-x-lg"></i></button>
                    </div>
                }

                @* راهنمای میکروفون: وقتی مجوز/امنیت آدرس مشکل دارد، به‌جای خطای مبهم، راهِ درست را نشان می‌دهیم *@
                @if (micIssue != null && !isRecording)
                {
                    <div class="mic-help" data-testid="mic-help" role="status">
                        <div class="mic-help-icon"><i class="bi bi-mic-mute-fill"></i></div>
                        <div class="mic-help-body">
                            <div class="mic-help-title">@micIssueTitle</div>
                            <div class="mic-help-text">@micIssue.Message</div>
                            @if (micIssue.Reason == "denied")
                            {
                                <ol class="mic-help-steps">
                                    <li>روی آیکون <b>قفل</b> (یا «تنظیمات سایت») کنار نوار آدرس بزنید.</li>
                                    <li>گزینهٔ <b>میکروفون</b> را روی <b>اجازه (Allow)</b> بگذارید.</li>
                                    <li>صفحه را بازخوانی کنید (F5) و دوباره میکروفون را بزنید.</li>
                                </ol>
                            }
                        </div>
                        <div class="mic-help-actions">
                            @if (micIssue.Reason == "insecure" && !string.IsNullOrWhiteSpace(micIssue.SecureUrl))
                            {
                                <a class="btn btn-sm btn-success" href="@micIssue.SecureUrl">
                                    <i class="bi bi-shield-lock"></i> رفتن به نسخهٔ امن (HTTPS)
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-success" @onclick="EnableMicrophone" data-testid="mic-enable">
                                    <i class="bi bi-mic-fill"></i> فعال‌سازی میکروفون
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DismissMicIssue">بستن</button>
                        </div>
                    </div>
                }

                @* پنل کامل ایموجی/استیکر — دسته‌بندی‌شده و قابل اسکرول *@
                @if (showEmojiPanel)
                {
                    <div class="emoji-panel" data-testid="emoji-panel">
                        @foreach (var g in EmojiGroups)
                        {
                            <div class="emoji-group-title">@g.Key</div>
                            <div class="emoji-grid">
                                @foreach (var e in g.Value)
                                {
                                    <button type="button" class="btn-emoji" title="@e" @onclick="() => AppendEmoji(e)">@e</button>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="input-row">
                    @if (isRecording)
                    {
                        @* حالت ضبط پیام صوتی: لغو یا ارسال *@
                        <div class="voice-rec-row flex-grow-1" role="status" data-testid="voice-recording">
                            <span class="rec-dot"></span>
                            <span class="rec-time">@FormatRecordingTime()</span>
                            <span class="rec-hint fs-8 text-muted">در حال ضبط پیام صوتی…</span>
                        </div>
                        <button type="button" class="btn btn-icon text-danger" title="لغو ضبط" aria-label="لغو ضبط"
                                disabled="@isSending" @onclick="CancelVoiceRecording" data-testid="voice-cancel">
                            <i class="bi bi-x-lg fs-5"></i>
                        </button>
                        <button type="button" class="btn btn-primary btn-send" title="ارسال پیام صوتی" aria-label="ارسال پیام صوتی"
                                disabled="@isSending" @onclick="StopAndSendVoice" data-testid="voice-send">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                            }
                        </button>
                    }
                    else
                    {
                        @* دکمه پیوست فایل *@
                        <label class="btn btn-icon btn-attach" title="پیوست فایل یا تصویر">
                            <i class="bi bi-paperclip fs-5"></i>
                            <InputFile @key="fileInputVersion" OnChange="OnFileSelected" class="d-none" disabled="@(isSending || isUploading || editingMsg != null)" />
                        </label>

                        @* دکمهٔ پنل کامل ایموجی *@
                        <button type="button" class="btn btn-icon btn-emoji-toggle @(showEmojiPanel ? "active" : "")"
                                title="ایموجی و استیکر" aria-label="ایموجی و استیکر" aria-expanded="@showEmojiPanel"
                                disabled="@isSending" @onclick="ToggleEmojiPanel">
                            😀
                        </button>

                        @* منوی سریع ایموجی *@
                        <div class="emoji-quick-bar d-none d-sm-flex">
                            <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("👍")'>👍</button>
                            <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("❤️")'>❤️</button>
                            <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("😂")'>😂</button>
                            <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("🔥")'>🔥</button>
                            <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("👏")'>👏</button>
                        </div>

                        @* کادر متنی پیام *@
                        <textarea class="form-control chat-textarea"
                                  placeholder="@(editingMsg != null ? "متن جدید پیام…" : "پیام خود را بنویسید...")"
                                  rows="1"
                                  @ref="composerElement" readonly="@isSending" aria-busy="@isSending"
                                  @bind="messageInput" @bind:event="oninput" @bind:after="OnMessageInputChanged"></textarea>

                        @* گفتار به نوشتار: وقتی متنی در کادر نوشته شده *@
                        @if (!string.IsNullOrWhiteSpace(messageInput))
                        {
                            <button type="button" class="btn btn-icon @(sttListening ? "mic-live" : "")"
                                    title="گفتار به نوشتار" aria-label="گفتار به نوشتار"
                                    disabled="@isSending" @onclick="ToggleDictation" data-testid="chat-dictate">
                                <i class="bi @(sttListening ? "bi-stop-circle-fill" : "bi-mic") fs-5"></i>
                            </button>
                        }

                        @if (string.IsNullOrWhiteSpace(messageInput) && uploadingFile == null && editingMsg == null && !isUploading)
                        {
                            @* کادر خالی است ← دکمهٔ ضبط پیام صوتی (مثل تلگرام) *@
                            <button type="button" class="btn btn-primary btn-send" title="پیام صوتی (ضبط و ارسال)"
                                    aria-label="پیام صوتی" disabled="@isSending" @onclick="StartVoiceRecording" data-testid="voice-record">
                                <i class="bi bi-mic-fill"></i>
                            </button>
                        }
                        else
                        {
                            @* دکمه ارسال *@
                            <button class="btn btn-primary btn-send" @onclick="SendCurrentMessage" disabled="@(isSending || isUploading || (string.IsNullOrWhiteSpace(messageInput) && uploadingFile == null))">
                                @if (isSending)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-send-fill"></i>
                                }
                            </button>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@* ========================== مدال ۱: شروع گفتگوی دونفره جدید ========================== *@
@if (showDirectModal)
{
    <div class="modal fade show d-block chat-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold fs-6">شروع گفتگوی جدید با همکاران</h5>
                    <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseUserPicker"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control form-control-sm" placeholder="نام، نام کاربری یا واحد سازمانی..." aria-label="جستجوی کاربران"
                               @bind="userSearchQuery" @bind:event="oninput" @bind:after="OnUserSearchChanged" />
                    </div>

                    <div class="text-muted fs-9 mb-2">مخاطبان از حساب‌های ورود فعال انتخاب می‌شوند؛ آنلاین بودن لازم نیست.</div>
                    <div class="users-picker-list" data-testid="chat-user-picker" aria-live="polite">
                        @if (loadingUsers)
                        {
                            <div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm"></span></div>
                        }
                        else if (usersError != null)
                        {
                            <div class="alert alert-danger fs-8" role="alert">
                                @usersError
                                <button type="button" class="btn btn-sm btn-outline-danger d-block mt-2" @onclick="LoadPickerUsersAsync">تلاش مجدد</button>
                            </div>
                        }
                        else if (filteredUsers.Count == 0)
                        {
                            <div class="text-center py-4 text-muted fs-8">
                                @(string.IsNullOrWhiteSpace(userSearchQuery) ? "کاربر فعال دیگری برای گفتگو وجود ندارد." : "کاربری با این مشخصات یافت نشد.")
                            </div>
                        }
                        else
                        {
                            @foreach (var u in filteredUsers)
                            {
                                <button type="button" @key="u.Id" class="user-picker-item w-100 border-0 bg-transparent" style="text-align: start;"
                                        @onclick="() => StartDirectWith(u.Id)" disabled="@startingDirectUserId.HasValue">
                                    <div class="dialog-avatar direct-avatar sm">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div class="flex-grow-1 min-w-0 ms-2">
                                        <div class="fw-bold fs-8">@u.DisplayName</div>
                                        <div class="fs-9 text-muted">@u.Username @(!string.IsNullOrWhiteSpace(u.Department) ? $"— {u.Department}" : "")</div>
                                    </div>
                                    @if (u.IsOnline)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-9">آنلاین</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ========================== مدال: فوروارد پیام ========================== *@
@if (forwardingMsg != null)
{
    <div class="modal fade show d-block chat-modal-backdrop" tabindex="-1" @onclick="CloseForward">
        <div class="modal-dialog modal-dialog-centered cf-dialog" @onclick:stopPropagation="true">
            <div class="modal-content cf-modal" role="dialog" aria-modal="true" aria-label="فوروارد پیام">
                <div class="cf-head">
                    <div class="cf-head-icon"><i class="bi bi-forward-fill"></i></div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="cf-title">فوروارد پیام</div>
                        <div class="cf-sub">به کدام گفتگو بفرستم؟</div>
                    </div>
                    <button type="button" class="cf-close" aria-label="بستن" @onclick="CloseForward"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="cf-preview">
                    <div class="cf-preview-bar"></div>
                    <div class="min-w-0">
                        <div class="cf-preview-sender">@forwardingMsg.SenderName</div>
                        <div class="cf-preview-text">@MsgSnippet(forwardingMsg)</div>
                    </div>
                </div>

                <div class="cf-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="جستجوی گفتگو…" aria-label="جستجوی گفتگو" @ref="forwardSearchEl"
                           @bind="forwardSearch" @bind:event="oninput" />
                </div>

                <div class="cf-list" role="listbox">
                    @{ var candidates = ForwardCandidates(); }
                    @if (candidates.Count == 0)
                    {
                        <div class="cf-empty"><i class="bi bi-chat-square-dots"></i><span>گفتگویی پیدا نشد</span></div>
                    }
                    @foreach (var c in candidates)
                    {
                        var isGroup = c.Type == ChatTypeDto.Group;
                        var state = forwardTargetDone == c.Id ? "is-done" : forwardingTo == c.Id ? "is-busy" : "";
                        <button type="button" @key="c.Id" class="cf-item @state" role="option"
                                disabled="@(forwarding || forwardTargetDone != 0)" @onclick="() => DoForward(c.Id)">
                            <span class="cf-av @(isGroup ? "is-group" : "")" style="--h:@AvatarHue(c.Title)">
                                @if (isGroup) { <i class="bi bi-people-fill"></i> } else { @Initial(c.Title) }
                            </span>
                            <span class="cf-item-body">
                                <span class="cf-item-name">@c.Title</span>
                                <span class="cf-item-last">@(string.IsNullOrWhiteSpace(c.LastMessageSnippet) ? (isGroup ? "گروه" : "گفتگوی دونفره") : c.LastMessageSnippet)</span>
                            </span>
                            <span class="cf-item-act">
                                @if (forwardTargetDone == c.Id) { <i class="bi bi-check-lg"></i> }
                                else if (forwardingTo == c.Id) { <span class="spinner-border spinner-border-sm"></span> }
                                else { <span class="cf-send">ارسال <i class="bi bi-arrow-left-short"></i></span> }
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ========================== مدال ۲: ایجاد گروه کاری جدید ========================== *@
@if (showGroupModal)
{
    <div class="modal fade show d-block chat-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold fs-6">ایجاد گروه کاری جدید</h5>
                    <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseUserPicker"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fs-8 fw-bold">نام گروه <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" placeholder="مثال: کارگروه پروژه پالایشگاه" @bind="newGroupTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-8 fw-bold">توضیحات گروه (اختیاری)</label>
                        <input type="text" class="form-control form-control-sm" placeholder="هدف از تشکیل این گروه..." @bind="newGroupDesc" />
                    </div>

                    <label class="form-label fs-8 fw-bold">انتخاب اعضای گروه (@selectedGroupUserIds.Count نفر انتخاب شده)</label>
                    <input type="text" class="form-control form-control-sm mb-2" placeholder="نام، نام کاربری یا واحد سازمانی..." aria-label="جستجوی کاربران"
                           @bind="userSearchQuery" @bind:event="oninput" @bind:after="OnUserSearchChanged" />
                    <div class="users-picker-list" style="max-height: 220px;" data-testid="chat-user-picker" aria-live="polite">
                        @if (loadingUsers)
                        {
                            <div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm"></span></div>
                        }
                        else if (usersError != null)
                        {
                            <div class="alert alert-danger fs-8" role="alert">
                                @usersError
                                <button type="button" class="btn btn-sm btn-outline-danger d-block mt-2" @onclick="LoadPickerUsersAsync">تلاش مجدد</button>
                            </div>
                        }
                        else if (filteredUsers.Count == 0)
                        {
                            <div class="text-center py-4 text-muted fs-8">کاربری با این مشخصات یافت نشد.</div>
                        }
                        else
                        {
                            @foreach (var u in filteredUsers)
                            {
                                bool isSelected = selectedGroupUserIds.Contains(u.Id);
                                <div @key="u.Id" class="user-picker-item @(isSelected ? "selected" : "")" @onclick="() => ToggleUserSelectForGroup(u.Id)">
                                    <input type="checkbox" class="form-check-input me-2" checked="@isSelected" aria-label="@u.DisplayName" />
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-bold fs-8">@u.DisplayName</div>
                                        <div class="fs-9 text-muted">@u.Username @(!string.IsNullOrWhiteSpace(u.Department) ? $"— {u.Department}" : "")</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseUserPicker">انصراف</button>
                    <button type="button" class="btn btn-sm btn-success px-4" @onclick="CreateGroupSubmit" disabled="@string.IsNullOrWhiteSpace(newGroupTitle)">
                        ساخت گروه
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ========================== مدال ۳: اطلاعات و اعضای گروه ========================== *@
@if (showGroupInfoModal && activeConv != null)
{
    <div class="modal fade show d-block chat-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold fs-6">مشخصات گروه «@activeConv.Title»</h5>
                    <button type="button" class="btn-close" @onclick="() => showGroupInfoModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(activeConv.Description))
                    {
                        <div class="alert alert-light border fs-8 mb-3">@activeConv.Description</div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold fs-8">اعضای گروه (@groupMembers.Count نفر)</span>
                    </div>

                    <div class="users-picker-list" style="max-height: 250px;">
                        @foreach (var m in groupMembers)
                        {
                            <div class="user-picker-item justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="dialog-avatar direct-avatar sm"><i class="bi bi-person"></i></div>
                                    <div>
                                        <div class="fw-bold fs-8">@m.UserDisplayName</div>
                                        <div class="fs-9 text-muted">
                                            @if (m.Role == ChatMemberRoleDto.Owner) { <span class="badge bg-warning text-dark me-1">سازنده</span> }
                                            else if (m.Role == ChatMemberRoleDto.Admin) { <span class="badge bg-info text-dark me-1">مدیر</span> }
                                            @(m.IsOnline ? "آنلاین" : "آفلاین")
                                        </div>
                                    </div>
                                </div>
                                @if (m.UserId != Auth.UserId && (activeConv.MyRole == ChatMemberRoleDto.Owner || activeConv.MyRole == ChatMemberRoleDto.Admin))
                                {
                                    <button class="btn btn-xs btn-outline-danger" title="حذف از گروه" @onclick="() => RemoveMember(m.UserId)">
