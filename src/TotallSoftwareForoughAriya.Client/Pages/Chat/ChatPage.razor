    /// <summary>یک افکت کوتاه روی حباب (کپی شد / ارسال شد / ویرایش شد) که خودش بعد از چند لحظه پاک می‌شود.</summary>
    private void Flash(Action set, Action clear, int ms, [System.Runtime.CompilerServices.CallerLineNumber] int kind = 0)
    {
        var seq = ++fxSeq;
        fxLatest[kind] = seq;
        set();
        _ = ClearFxLaterAsync(clear, ms, kind, seq);
    }

    private async Task ClearFxLaterAsync(Action clear, int ms, int kind, int seq)
    {
        await Task.Delay(ms);
        // اگر همین افکت دوباره شروع شده، پاک‌کردن به عهدهٔ تایمر جدید است.
        if (disposed || fxLatest.GetValueOrDefault(kind) != seq) return;
        clear();
        await InvokeAsync(StateHasChanged);
    }

