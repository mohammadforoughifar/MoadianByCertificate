                micIssue = result ?? new MicIssueDto { Reason = "error", Message = "درخواست مجوز میکروفون ناموفق بود." };
                Toast.Error(micIssueTitle);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); }
    }

    private void DismissMicIssue() => micIssue = null;

    // ---- تبدیل ویس به متن (رونویسی) ----
    /// <summary>پیام‌هایی که همین حالا در حال تبدیل به متن هستند (برای اسپینر و قفل دکمه).</summary>
    private readonly HashSet<int> transcribingIds = new();
    private bool IsTranscribing(int messageId) => transcribingIds.Contains(messageId);

    /// <summary>خروجی JSON ضبط صدا از chat-interop.js (کلیدها باید camelCase بمانند).</summary>
    private sealed class VoiceRecordingDto
