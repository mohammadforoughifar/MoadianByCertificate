    private List<ChatConversationDto> ForwardCandidates()
    {
        var q = (forwardSearch ?? "").Trim();
        return conversations
            .Where(c => q.Length == 0 || c.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    /// <summary>فوروارد پیام انتخاب‌شده به گفتگوی مقصد — بعد از موفقیت مودال بسته می‌شود.</summary>
    private async Task DoForward(int conversationId)
    {
        if (forwardingMsg == null || forwarding || forwardTargetDone != 0) return;
        forwarding = true;
        forwardingTo = conversationId;
        var done = false;
        try
        {
            var saved = await Chat.ForwardAsync(forwardingMsg.Id, conversationId);
            forwardTargetDone = conversationId;
            if (activeConv?.Id == conversationId)
            {
                UpsertMessage(saved);
                scrollAfterRender = true;
                Flash(() => justSentId = saved.Id, () => justSentId = 0, 600);
            }
            done = true;
        }
        catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); }
        finally
        {
            forwarding = false;
            forwardingTo = 0;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
        if (!done || disposed) return;
        // تیک سبز را یک لحظه نشان بده، بعد مودال را ببند.
        await Task.Delay(650);
        if (disposed) return;
        CloseForward();
        await InvokeAsync(StateHasChanged);
        try { await LoadConversations(); } catch { }
    }

