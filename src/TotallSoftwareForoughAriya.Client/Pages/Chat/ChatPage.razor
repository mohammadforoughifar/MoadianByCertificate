    private async Task StartVoiceRecording()
    {
        if (disposed || chatJs == null || activeConv == null || isSending || isUploading || isRecording) return;
        try
        {
            var result = await chatJs.InvokeAsync<MicIssueDto>("startRecording");
            if (disposed) return;
            if (result == null || !result.Ok)
            {
                // علت واقعی (رد مجوز / نبود HTTPS / اشغال‌بودن میکروفون) به کاربر گفته می‌شود
                micIssue = result ?? new MicIssueDto { Reason = "error", Message = "ضبط صدا ممکن نشد؛ دوباره تلاش کنید." };
                Toast.Error(micIssue.Message);
                await InvokeAsync(StateHasChanged);
                return;
            }
            micIssue = null;
            isRecording = true;
            recordingSeconds = 0;
            _ = RunRecordingTimerAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); }
    }

    private async Task RunRecordingTimerAsync()
    {
        while (!disposed && isRecording)
        {
            try { await Task.Delay(1000, pageLifetime.Token); }
            catch { break; }
            if (disposed || !isRecording) break;
            recordingSeconds++;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string FormatRecordingTime()
    {
        var ts = TimeSpan.FromSeconds(Math.Max(0, recordingSeconds));
        return $"{(int)ts.TotalMinutes:00}:{ts.Seconds:00}";
    }

    private async Task StopAndSendVoice()
    {
        if (disposed || chatJs == null || activeConv == null || isSending) return;
        var conversationId = activeConv.Id;
        isSending = true;
        isRecording = false;
        try
        {
            var rec = await chatJs.InvokeAsync<VoiceRecordingDto?>("stopRecording");
            if (disposed) return;
            if (rec == null || string.IsNullOrEmpty(rec.Base64))
            {
                Toast.Info("ضبط خیلی کوتاه بود؛ پیام صوتی ارسال نشد.");
                return;
            }
            var data = Convert.FromBase64String(rec.Base64);
            var fileName = $"voice-{DateTime.Now:yyyyMMdd-HHmmss}.{rec.Ext}";
            var uploaded = await Chat.UploadVoiceNoteAsync(conversationId, data, fileName, rec.ContentType);
            if (disposed || activeConv?.Id != conversationId) return;
            var saved = await Chat.SendMessageAsync(conversationId, new SendChatMessageRequest
            {
                ConversationId = conversationId,
                MessageType = uploaded.MessageType,
                FileUrl = uploaded.FileUrl,
                FileName = uploaded.FileName,
                FileSizeBytes = uploaded.FileSizeBytes,
                FileContentType = uploaded.FileContentType,
                ReplyToMessageId = replyingTo?.Id
            });
            if (disposed || activeConv?.Id != conversationId) return;
            UpsertMessage(saved);
            replyingTo = null;
            scrollAfterRender = true;
            await Chat.SendTypingHubAsync(conversationId, false);
            lastTypingSent = DateTime.MinValue;
            await LoadConversations();
        }
        catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); }
        finally
        {
            isSending = false;
            recordingSeconds = 0;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// تبدیل پیام صوتی به متن (رونویسی سمت سرور با مدل گفتار به متن).
    /// force=true برای «تبدیل دوباره» است. متن روی همان پیام ذخیره می‌شود و برای
    /// بقیهٔ اعضای گفتگو هم به‌صورت زنده (MessageUpdated) نمایش داده می‌شود.
    /// </summary>
    private async Task TranscribeVoice(ChatMessageDto msg, bool force)
    {
        if (disposed || msg == null || msg.MessageType != ChatMessageTypeDto.Audio) return;
        if (!transcribingIds.Add(msg.Id)) return;
        try
        {
            await InvokeAsync(StateHasChanged);
            var updated = await Chat.TranscribeVoiceMessageAsync(msg.Id, force);
            if (disposed) return;
            UpsertMessage(updated);
            var text = updated.Transcript ?? string.Empty;
            Toast.Success(text.Length > 0 ? "متن پیام صوتی ساخته شد." : "متنی برای این پیام صوتی پیدا نشد.");
        }
        catch (ApiException ex)
        {
            if (!disposed) Toast.Error(ex.Message);
        }
        catch (Exception ex)
        {
            if (!disposed) Toast.Error("تبدیل به متن ناموفق بود: " + ex.Message);
        }
        finally
        {
            transcribingIds.Remove(msg.Id);
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

