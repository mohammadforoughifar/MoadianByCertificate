        [System.Text.Json.Serialization.JsonPropertyName("permission")] public string Permission { get; set; } = "unknown";
        [System.Text.Json.Serialization.JsonPropertyName("hasInputDevice")] public bool? HasInputDevice { get; set; }
    }

    private string micIssueTitle => micIssue?.Reason switch
    {
        "insecure" => "ضبط صدا روی این آدرس ممکن نیست (نیاز به HTTPS)",
        "denied" => "دسترسی میکروفون بسته است",
        "no-device" => "میکروفون پیدا نشد",
        "busy" => "میکروفون در اختیار برنامهٔ دیگری است",
        "unsupported" => "مرورگر پشتیبانی نمی‌کند",
        _ => "ضبط صدا ممکن نشد"
    };

    /// <summary>
    /// بررسی وضعیت میکروفون بعد از باز شدن چت: اگر مجوز رد شده یا آدرس امن نیست،
    /// همان اول راهنما نشان داده می‌شود تا کاربر با خطای مبهم روبه‌رو نشود.
    /// </summary>
    private async Task CheckMicrophoneStatusAsync()
    {
        if (disposed || chatJs == null || micStatusChecked) return;
        micStatusChecked = true;
        try
        {
            var status = await chatJs.InvokeAsync<MicIssueDto>("micStatus");
            if (disposed || status == null) return;
            if (!status.Secure)
                micIssue = new MicIssueDto { Reason = "insecure", SecureUrl = status.SecureUrl, Supported = status.Supported };
            else if (!status.Supported)
                micIssue = new MicIssueDto { Reason = "unsupported" };
            else if (status.Permission == "denied")
                micIssue = new MicIssueDto { Reason = "denied" };
            else if (status.HasInputDevice == false)
                micIssue = new MicIssueDto { Reason = "no-device" };
            else
                micIssue = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException) { /* نسخهٔ قدیمی کش‌شدهٔ interop: بدون راهنما ادامه می‌دهیم */ }
        catch (Exception) { /* ناموفق بودن این بررسی نباید چیزی را خراب کند */ }
    }

    /// <summary>درخواست مجوز میکروفون با کلیک کاربر (مرورگر پیغام «اجازه می‌دهید؟» را نشان می‌دهد).</summary>
    private async Task EnableMicrophone()
    {
        if (disposed || chatJs == null) return;
        try
        {
