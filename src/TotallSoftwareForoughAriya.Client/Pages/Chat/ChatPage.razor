    private async Task ToggleDictation()
    {
        if (disposed) return;
        if (sttListening)
        {
            try { await JS.InvokeVoidAsync("aiVoice.stop"); } catch (JSException) { }
            sttListening = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
            return;
        }
        try
        {
            var supported = await JS.InvokeAsync<bool>("aiVoice.isSupported");
            if (!supported)
            {
                Toast.Error("گفتار به نوشتار در این مرورگر پشتیبانی نمی‌شود (کروم/اِج توصیه می‌شود).");
                return;
            }
            voiceSelf ??= DotNetObjectReference.Create(this);
            var started = await JS.InvokeAsync<bool>("aiVoice.start", voiceSelf);
            if (!started)
            {
                Toast.Error("دسترسی به میکروفون ممکن نشد؛ مجوز میکروفون را بررسی کنید.");
                return;
            }
            sttListening = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException) { Toast.Error("گفتار به نوشتار در دسترس نیست."); }
    }

