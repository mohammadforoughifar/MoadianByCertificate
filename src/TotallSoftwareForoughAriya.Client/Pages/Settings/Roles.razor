@page "/settings/roles"
@inject HttpClient Http
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>مدیریت نقش‌ها و دسترسی‌ها</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1 class="mb-1">نقش‌ها و دسترسی‌ها</h1>
        <p class="lead text-muted">مدیریت نقش‌ها و تخصیص دسترسی‌های ماژولار</p>
    </div>
    <button class="btn btn-primary btn-lg shadow-sm" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-2"></i> ایجاد نقش جدید
    </button>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-shield-lock fs-2"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">تعداد نقش‌ها</div>
                    <div class="fs-3 fw-bold">@roles.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-check2-circle fs-2"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">نقش‌های فعال</div>
                    <div class="fs-3 fw-bold">@roles.Count(r => r.IsActive)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                        <i class="bi bi-key fs-2"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">تعداد دسترسی‌ها</div>
                    <div class="fs-3 fw-bold">@allPermissions.Count</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Roles Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h6 class="mb-0 fw-bold">لیست نقش‌ها</h6>
    </div>
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (roles.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-slash fs-1 text-muted"></i>
                <p class="mt-3 text-muted">هیچ نقشی تعریف نشده است</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">نام نقش</th>
                            <th>توضیحات</th>
                            <th>وضعیت</th>
                            <th class="text-end pe-4">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in roles)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-700">@role.Name</div>
                                </td>
                                <td class="text-muted">@role.Description</td>
                                <td>
                                    @if (role.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2">غیرفعال</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="role-btn role-btn-edit" title="ویرایش نقش" @onclick="() => OpenEditModal(role)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="role-btn role-btn-del" title="حذف نقش" @onclick="() => DeleteRole(role)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Professional Modal *@
@if (showModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.6)">
        <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold">@(editingRole != null ? "ویرایش نقش" : "ایجاد نقش جدید")</h5>
                        <p class="text-muted small mb-0">تعیین دسترسی‌های ماژولار</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body pt-3">
                    <!-- Role Info -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-600">نام نقش <span class="text-danger">*</span></label>
                            <input class="form-control form-control-lg" @bind="form.Name" placeholder="مثال: مدیر سیستم" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-600">توضیحات</label>
                            <input class="form-control form-control-lg" @bind="form.Description" placeholder="توضیح مختصر نقش" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="isActive" @bind="form.IsActive" />
                                <label class="form-check-label fw-500" for="isActive">نقش فعال باشد</label>
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">دسترسی‌ها</h6>
                            <span class="badge bg-light text-dark">@selectedPermissionIds.Count از @allPermissions.Count</span>
                        </div>

                        @if (allPermissions.Any())
                        {
                            <div class="perm-toolbar mb-3">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input class="form-control" placeholder="جستجوی ماژول یا دسترسی…" @bind="permissionSearch" @bind:event="oninput" />
                                </div>
                                <div class="d-flex gap-2 mt-2 flex-wrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ExpandAllPermissionTrees"><i class="bi bi-arrows-expand"></i> باز کردن همه</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CollapseAllPermissionTrees"><i class="bi bi-arrows-collapse"></i> بستن همه</button>
                                </div>
                            </div>
                            <div class="permission-tree">
                                @foreach (var cat in VisiblePermissionCategories)
                                {
                                    var catGroups = FilterPermissionGroups(allPermissions.Where(p => cat.Modules.Contains(p.Module)).GroupBy(p => p.Module));
                                    if (!catGroups.Any()) continue;
                                    <details class="perm-tree-category" open="@IsTreeOpen(cat.Title)">
                                        <summary><span class="tree-title"><i class="bi @cat.Icon"></i> @cat.Title</span><span class="tree-count">@catGroups.Sum(g => g.Count(PermissionMatches)) مجوز</span></summary>
                                        <div class="perm-tree-children">
                                            @foreach (var group in catGroups.OrderBy(g => Array.IndexOf(cat.Modules, g.Key)))
                                            {
                                                <details class="perm-tree-module" open="@IsTreeOpen(group.Key)">
                                                    <summary><span><i class="bi bi-folder2-open text-primary"></i> @(ModuleNames.GetValueOrDefault(group.Key, group.Key)) <small class="text-muted">(@group.Key)</small></span><span class="tree-actions"><span class="badge bg-light text-dark">@group.Count(PermissionMatches)</span><input type="checkbox" title="انتخاب همه این ماژول" checked="@group.Where(PermissionMatches).All(p => selectedPermissionIds.Contains(p.Id))" @onclick:stopPropagation="true" @onchange="e => ToggleModuleAll(group.Key, (bool)e.Value!)" /></span></summary>
                                                    <div class="perm-leaf-list">
                                                        @foreach (var perm in group.Where(PermissionMatches).OrderBy(p => p.Action))
                                                        {
                                                            <label class="perm-leaf"><input type="checkbox" checked="@selectedPermissionIds.Contains(perm.Id)" @onchange="e => TogglePermission(perm.Id, (bool)e.Value!)" /><span>@GetActionLabel(perm.Module, perm.Action)</span><small>@perm.Action</small></label>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    </details>
                                }
                                @if (VisibleOtherPermissionGroups.Any())
                                {
                                    <details class="perm-tree-category" open="@IsTreeOpen(OtherTreeKey)">
                                        <summary><span class="tree-title"><i class="bi bi-three-dots"></i> سایر</span><span class="tree-count">@VisibleOtherPermissionGroups.Sum(g => g.Count()) مجوز</span></summary>
                                        <div class="perm-tree-children">
                                            @foreach (var group in VisibleOtherPermissionGroups)
                                            {
                                                <details class="perm-tree-module" open="@IsTreeOpen(group.Key)">
                                                    <summary><span><i class="bi bi-folder2-open text-primary"></i> @(ModuleNames.GetValueOrDefault(group.Key, group.Key)) <small class="text-muted">(@group.Key)</small></span><span class="tree-actions"><span class="badge bg-light text-dark">@group.Count(PermissionMatches)</span><input type="checkbox" checked="@group.Where(PermissionMatches).All(p => selectedPermissionIds.Contains(p.Id))" @onclick:stopPropagation="true" @onchange="e => ToggleModuleAll(group.Key, (bool)e.Value!)" /></span></summary>
                                                    <div class="perm-leaf-list">
                                                        @foreach (var perm in group.Where(PermissionMatches).OrderBy(p => p.Action))
                                                        {
                                                            <label class="perm-leaf"><input type="checkbox" checked="@selectedPermissionIds.Contains(perm.Id)" @onchange="e => TogglePermission(perm.Id, (bool)e.Value!)" /><span>@GetActionLabel(perm.Module, perm.Action)</span><small>@perm.Action</small></label>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-light px-4" @onclick="CloseModal">انصراف</button>
                    <button class="btn btn-primary px-4" @onclick="SaveRole" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        ذخیره نقش
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .page-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: .75rem;
    }
    .modal-xl {
        max-width: 1100px;
    }
    /* ===== دکمه‌های ویرایش/حذف ===== */
    .role-btn {
        width: 36px; height: 32px;
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0; border-radius: 10px; border: 1px solid transparent;
        font-size: .85rem; cursor: pointer; transition: all .15s ease;
    }
    .role-btn-edit { background: #eef4ff; color: #2563eb; }
    .role-btn-edit:hover { background: #2563eb; color: #fff; transform: translateY(-1px); box-shadow: 0 4px 10px rgba(37,99,235,.35); }
    .role-btn-del { background: #fdecec; color: #dc3545; }
    .role-btn-del:hover { background: #dc3545; color: #fff; transform: translateY(-1px); box-shadow: 0 4px 10px rgba(220,53,69,.35); }
    /* ===== هدر دسته‌بندی دسترسی‌ها ===== */
    .perm-cat-head {
        display: flex; align-items: center; gap: .5rem;
        font-weight: 700; font-size: .95rem; color: #334155;
        margin-bottom: .75rem;
    }
    .perm-cat-head i { color: var(--bs-primary, #2563eb); font-size: 1.1rem; }
    .perm-cat-line { flex: 1; height: 1px; background: linear-gradient(to left, #e2e8f0, transparent); }
    /* ===== درخت دسترسی‌ها ===== */
    .perm-toolbar { position: sticky; top: 0; z-index: 3; background: #fff; padding-bottom: .65rem; }
    .permission-tree { display: flex; flex-direction: column; gap: .55rem; }
    .perm-tree-category, .perm-tree-module { border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; overflow: hidden; }
    .perm-tree-category > summary { background: linear-gradient(135deg,#f1f5ff,#f8fafc); font-weight: 800; }
    .perm-tree-module > summary { background: #f8fafc; font-weight: 700; margin: .45rem .65rem 0; border-radius: 9px; }
    .permission-tree summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: .75rem; padding: .7rem .85rem; user-select: none; }
    .permission-tree summary::-webkit-details-marker { display: none; }
    .permission-tree summary::before { content: '‹'; transform: rotate(-90deg); transition: transform .15s; font-size: 1.1rem; color: #64748b; }
    .permission-tree details[open] > summary::before { transform: rotate(90deg); }
    .tree-title { display: inline-flex; align-items: center; gap: .45rem; }
    .tree-count { color: #64748b; font-size: .75rem; white-space: nowrap; }
    .tree-actions { display: inline-flex; align-items: center; gap: .55rem; }
    .perm-tree-children { padding: 0 .65rem .65rem; display: flex; flex-direction: column; gap: .4rem; }
    .perm-leaf-list { padding: .45rem .9rem .7rem 2.1rem; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .35rem .8rem; }
    .perm-leaf { display: flex; align-items: center; gap: .5rem; padding: .35rem .45rem; border-radius: 7px; cursor: pointer; min-width: 0; }
    .perm-leaf:hover { background: #f1f5f9; }
    .perm-leaf span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .perm-leaf small { color: #94a3b8; margin-right: auto; direction: ltr; }
    @@media (max-width: 650px) { .perm-leaf-list { grid-template-columns: 1fr; padding-right: 1rem; } .tree-count { display:none; } .permission-tree summary { padding: .6rem; } }

    /* ===== رسپانسیو کارت‌های آمار ===== */
    @@media (max-width: 575.98px) {
        .fs-3.fw-bold { font-size: 1.35rem !important; }
    }
</style>

@code {
    private List<RoleDto> roles = new();
    private List<PermissionDto> allPermissions = new();
    private bool loading = true;
    private bool showModal = false;
    private bool saving = false;
    private RoleDto? editingRole = null;

    private RoleForm form = new();
    private HashSet<int> selectedPermissionIds = new();
    private string permissionSearch = "";
    private bool expandPermissionTree = false;
    private const string OtherTreeKey = "سایر";

    private IEnumerable<PermCategory> VisiblePermissionCategories =>
        ModuleCategories.Where(cat => allPermissions.Any(p => cat.Modules.Contains(p.Module) && PermissionMatches(p)));

    private IEnumerable<IGrouping<string, PermissionDto>> FilterPermissionGroups(IEnumerable<IGrouping<string, PermissionDto>> groups) =>
        groups.Where(g => g.Any(PermissionMatches));

    private IEnumerable<IGrouping<string, PermissionDto>> VisibleOtherPermissionGroups =>
        allPermissions.Where(p => !ModuleCategories.SelectMany(c => c.Modules).Contains(p.Module) && PermissionMatches(p))
            .GroupBy(p => p.Module);

    // دیتابیس‌های قدیمی ممکن است سطح‌های منسوخ Moadian مانند ProviderInvoices، Read،
    // MasterData یا Configure را نگه داشته باشند. API جدید فقط مجموعهٔ تفکیکی زیر را
    // مبنای کنترل قرار می‌دهد؛ نمایش گزینه‌های قدیمی باعث می‌شد مدیر نقش اشتباه بسازد.
    private static readonly HashSet<string> CurrentMoadianActions = new(StringComparer.OrdinalIgnoreCase)
    {
        "View", "Certificate", "MasterData",
        "InvoiceCreate", "InvoiceUpdate", "InvoiceDelete",
        "InvoiceSend", "InvoiceInquiry", "FolderStatus",
        "PaymentRegister", "Diagnose"
    };

    private static bool IsVisiblePermission(PermissionDto p) =>
        !string.Equals(p.Module, "Moadian", StringComparison.OrdinalIgnoreCase)
        || CurrentMoadianActions.Contains(p.Action);

    private bool PermissionMatches(PermissionDto p) =>
        IsVisiblePermission(p)
        && (string.IsNullOrWhiteSpace(permissionSearch)
            || p.Module.Contains(permissionSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || ModuleNames.GetValueOrDefault(p.Module, "").Contains(permissionSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || p.Action.Contains(permissionSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || GetActionLabel(p.Module, p.Action).Contains(permissionSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool IsTreeOpen(string _) => expandPermissionTree || !string.IsNullOrWhiteSpace(permissionSearch);
    private void ExpandAllPermissionTrees() => expandPermissionTree = true;
    private void CollapseAllPermissionTrees() => expandPermissionTree = false;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        try
        {
            roles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/roles") ?? new();
            allPermissions = await Http.GetFromJsonAsync<List<PermissionDto>>("/api/permissions") ?? new();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenCreateModal()
    {
        editingRole = null;
        form = new RoleForm { IsActive = true };
        selectedPermissionIds.Clear();
        expandPermissionTree = false;
        permissionSearch = "";
        showModal = true;
    }

    private async Task OpenEditModal(RoleDto role)
    {
        editingRole = role;
        form = new RoleForm { Name = role.Name, Description = role.Description, IsActive = role.IsActive };

        try
        {
            var perms = await Http.GetFromJsonAsync<List<int>>($"/api/roles/{role.Id}/permissions") ?? new();
            selectedPermissionIds = new HashSet<int>(perms);
        }
        catch { selectedPermissionIds.Clear(); }

        expandPermissionTree = false;
        permissionSearch = "";
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void TogglePermission(int id, bool isChecked)
    {
        if (isChecked) selectedPermissionIds.Add(id);
        else selectedPermissionIds.Remove(id);
    }

    private void ToggleModuleAll(string module, bool isChecked)
    {
        var modulePerms = allPermissions.Where(p => p.Module == module && IsVisiblePermission(p)).Select(p => p.Id);
        if (isChecked)
        {
            foreach (var id in modulePerms)
                selectedPermissionIds.Add(id);
        }
        else
        {
            foreach (var id in modulePerms)
                selectedPermissionIds.Remove(id);
        }
    }

    private async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            Toast.Error("نام نقش الزامی است");
            return;
        }

        saving = true;
        try
        {
            var payload = new RoleDto
            {
                Id = editingRole?.Id ?? 0,
                Name = form.Name,
                Description = form.Description,
                IsActive = form.IsActive,
                PermissionIds = selectedPermissionIds.ToList()
            };

            if (editingRole == null)
                await Http.PostAsJsonAsync("/api/roles", payload);
            else
                await Http.PutAsJsonAsync($"/api/roles/{editingRole.Id}", payload);

            Toast.Success("نقش با موفقیت ذخیره شد");
            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteRole(RoleDto role)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"آیا از حذف نقش «{role.Name}» مطمئن هستید؟")) return;

        try
        {
            await Http.DeleteAsync($"/api/roles/{role.Id}");
            Toast.Success("نقش حذف شد");
            await LoadData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private class RoleForm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    public class RoleDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; }
        public List<int> PermissionIds { get; set; } = new();
    }

    public class PermissionDto
    {
        public int Id { get; set; }
        public string Module { get; set; } = "";
        public string Action { get; set; } = "";
    }

    // ==================== دسته‌بندی ماژول‌ها (برای جلوگیری از اشتباه) ====================
    private class PermCategory
    {
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public string[] Modules { get; set; } = Array.Empty<string>();
    }

    private static readonly List<PermCategory> ModuleCategories = new()
    {
        new() { Title = "سامانه فروشگاهی — فروش، مالی و مودیان", Icon = "bi-cash-coin", Modules = new[] { "Orders", "GoodsIssues", "Expenses", "Parties", "Customers", "Suppliers", "SalesVisit", "Moadian", "ShopGuide" } },

        new() { Title = "معرف‌ها و پنل معرف", Icon = "bi-person-badge", Modules = new[] { "Referrers", "ReferrerWallets", "ReferrerPanel" } },
        new() { Title = "اطلاعات پایه و انبار", Icon = "bi-box-seam", Modules = new[] { "Products", "Stock", "Warehouses", "SystemCompanies", "SystemDepartments" } },
        new() { Title = "ERP — انبارداری و حسابداری", Icon = "bi-diagram-3", Modules = new[] { "InvDocs", "InvDocTypes", "AccAccounts", "AccVouchers", "AccDimensions", "FixedAssets", "Budgets", "FacInvoices", "TrsAccounts", "TrsVouchers", "TrsCheques", "StkSessions", "StkBarcodes" } },
        new() { Title = "آرشیو اسناد و مدارک", Icon = "bi-folder2-open", Modules = new[] { "DocArchive" } },
        new() { Title = "پیام‌رسان سازمانی", Icon = "bi-chat-dots", Modules = new[] { "Chat" } },
        new() { Title = "داشبوردها و صفحات شخصی", Icon = "bi-speedometer2", Modules = new[] { "Dashboards", "MyCartable", "MyArchive", "MyDashboards" } },
        new() { Title = "گزارش‌ها", Icon = "bi-journal-text", Modules = new[] { "ReportPages", "Reports", "ReportStudio" } },
        new() { Title = "تجهیزات و تعمیرات", Icon = "bi-tools", Modules = new[] { "Repairs", "CctvCameras", "CctvNvrs" } },
