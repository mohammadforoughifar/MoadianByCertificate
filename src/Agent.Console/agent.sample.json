{
  // آدرس پایه‌ی API سرور (بدون اسلش آخر)
  // نمونه: آدرس سرور خودتان — مثل "http://192.168.30.104:8181" (یا "http://192.168.1.10:5000")
  "server": "http://192.168.30.104:8181",

  // فاصله‌ی ارسال دوره‌ای در حالت watch (دقیقه)
  "intervalMinutes": 60,

  // پایش چاپگرهای محلی (USB) و ارسال وضعیت به ماژول «ماشین‌های اداری»
  "monitorPrinters": true,
  // فاصله‌ی ارسال وضعیت چاپگرها در حالت watch (دقیقه) — در زمان‌بند ویندوز تسک جداگانهٔ ۵ دقیقه‌ای ساخته می‌شود
  "printerIntervalMinutes": 5,
  // فعال‌سازی خودکار لاگ چاپ ویندوز برای شمارش صفحات چاپگرهای USB (نیاز به اجرا با دسترسی SYSTEM/مدیر)
  "enablePrintLog": true,

  // شناسه‌ی ثابت این سیستم — اگر خالی باشد، ایجنت خودکار می‌سازد و ذخیره می‌کند.
  // برای اینکه سیستمی همیشه با یک شناسه شناخته شود، می‌توانید دستی مقدار بدهید، مثل: "PC-101"
  "agentId": "",

  // توکن JWT — فعلاً لازم نیست (endpoint ایجنت باز است). برای آینده نگه داشته شده.
  "token": "",

  // کلید مشترک ایجنت — اگر روی سرور Agent:Key تنظیم شده باشد، همان مقدار اینجا لازم است
  "key": "",

  // ورود با نام کاربری/رمز برای گرفتن خودکار توکن (اختیاری)
  "username": "",
  "password": "",

  // نادیده گرفتن خطای گواهی HTTPS — فقط در شبکه‌ی داخلی و با آگاهی فعال کنید
  "insecure": false
}
